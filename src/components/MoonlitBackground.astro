<canvas id="moonlit-bg" aria-hidden="true"></canvas>
<canvas id="starfield" aria-hidden="true"></canvas>
<style>
  #moonlit-bg {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    /* Constant across both themes, never a value the html.dark toggle changes.
       Re-layering a WebGL canvas mid-flight can composite one black frame,
       because the context is created with preserveDrawingBuffer: false and the
       not-yet-drawn buffer reads as opaque black. Sitting behind in-flow content
       in *both* themes keeps a theme flip to shader uniforms only. */
    z-index: -1;
    pointer-events: none;
    display: block;
    /* Kept unconditionally (not scoped to html.dark) so that a theme flip never
       snaps the filter on/off mid cross-fade. hue-rotate() is an identity matrix
       for neutral greys, and the daylight palette below is strictly monochrome,
       so it only ever affects the moonlit palette. */
    filter: hue-rotate(175deg);
  }
  /* A z-index: -1 canvas paints before the body background, so the body must not
     be opaque or the water is invisible in light mode. global.css already gives
     <html> `background: var(--bg)` (#FAFAFA / #000), which stays as the base
     layer and doubles as the no-WebGL fallback. Both selectors are needed to beat
     global.css `body { background }` (0,0,1) and Tailwind's `.bg-[#FAFAFA]`
     utility (0,1,0) on Layout.astro's <body>; (0,1,2) wins over both.
     global.css's html.dark header/main/footer { z-index: 1 } is left in place and
     stays correct — it simply paints above a -1 canvas as well. */
  html.dark body,
  html:not(.dark) body { background: transparent; }

  #starfield {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
    display: block;
    mask-image: linear-gradient(to bottom, black 35%, transparent 55%);
    -webkit-mask-image: linear-gradient(to bottom, black 35%, transparent 55%);
    transition: opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 1;
  }
  html:not(.dark) #starfield {
    opacity: 0;
  }
</style>
<script>
(function () {
  var canvas = document.getElementById('moonlit-bg') as HTMLCanvasElement | null;
  if (!canvas) return;
  var win = window as Window & { __moonlitBgThemeObserver?: MutationObserver };
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var gl = canvas.getContext('webgl', { alpha: false, antialias: false, preserveDrawingBuffer: false });
  if (!gl) return;

  var vertSrc = [
    'attribute vec2 a_pos;',
    'void main() { gl_Position = vec4(a_pos, 0.0, 1.0); }'
  ].join('\n');

  var fragSrc = [
    'precision highp float;',
    'uniform float u_time;',
    'uniform vec2 u_res;',
    'uniform float u_rippleSpeed;',
    'uniform float u_moonGlow;',
    'uniform vec2 u_mouse;',
    'uniform float u_tilt;',
    'uniform float u_waves;',
    'uniform float u_daylight;',
    '',
    '#define PI 3.14159265359',
    '#define WAVE_LAYERS 7',
    '',
    'vec4 sea(vec2 p, float t) {',
    '  float h = 0.0;',
    '  vec2 dh = vec2(0.0);',
    '  float freq = 1.0;',
    '  float baseAmp = 0.2 * u_waves;',
    '  float decay = mix(0.55, 0.38, clamp(u_waves / 3.0, 0.0, 1.0));',
    '  float amp = baseAmp;',
    '  float angle = 0.0;',
    '  for (int i = 0; i < WAVE_LAYERS; i++) {',
    '    float c = cos(angle);',
    '    float s = sin(angle);',
    '    vec2 pp = vec2(c * p.x + s * p.y, -s * p.x + c * p.y);',
    '    float fi = float(i);',
    '    float spd = sqrt(freq) * 0.8;',
    '    float phase = (pp.y + fi) * freq - t * spd;',
    '    float sn = sin(phase);',
    '    float cn = cos(phase);',
    '    h += sn * amp;',
    '    float dy = freq * amp * cn;',
    '    dh += vec2(-s * dy, c * dy);',
    '    angle += fi + 1.2;',
    '    freq *= 1.3;',
    '    amp *= decay;',
    '  }',
    '  vec3 N = normalize(vec3(-dh.x, 1.0, -dh.y));',
    '  return vec4(h, N);',
    '}',
    '',
    'vec3 moonDir() {',
    '  return normalize(vec3(0.15, 0.35, 1.0));',
    '}',
    '',
    'float hash(vec2 p) {',
    '  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);',
    '}',
    '',
    'vec3 skyColor(vec3 rd) {',
    '  vec3 md = moonDir();',
    // u_daylight = 0 keeps the moonlit palette bit-identical; 1 is the daylight
    // sibling: neutral monochrome greys, so the CSS hue-rotate() is a no-op.
    // Daylight needs the same sky-to-water separation dark mode gets for free
    // from luminance alone: a near-white horizon (0.96) over a mid-grey zenith
    // (0.72) above a much darker sea base (0.58), so the horizon still reads.
    '  vec3 skyDark = mix(vec3(0.06, 0.03, 0.02), vec3(0.72), u_daylight);',
    '  vec3 skyHoriz = mix(vec3(0.09, 0.05, 0.04), vec3(0.96), u_daylight);',
    '  vec3 sky = mix(skyHoriz, skyDark, max(rd.y, 0.0));',
    '  vec3 moonCol = mix(vec3(0.98, 0.92, 0.85), vec3(1.0), u_daylight);',
    '  float moonDot = max(dot(rd, md), 0.0);',
    '  float moonAngle = acos(clamp(moonDot, 0.0, 1.0));',
    '  float moonRadius = 0.04;',
    '  float disc = smoothstep(moonRadius, moonRadius * 0.7, moonAngle);',
    '  if (disc > 0.0) {',
    '    vec3 up = vec3(0.0, 1.0, 0.0);',
    '    vec3 right = normalize(cross(up, md));',
    '    vec3 mup = cross(md, right);',
    '    vec2 muv = vec2(dot(rd - md, right), dot(rd - md, mup)) * 25.0;',
    '    float crater = hash(floor(muv * 2.0)) * 0.25;',
    '    crater += hash(floor(muv * 4.0)) * 0.15;',
    '    float darkening = 1.0 - crater * smoothstep(moonRadius * 0.9, moonRadius * 0.4, moonAngle);',
    '    float limb = smoothstep(0.0, moonRadius, moonAngle);',
    '    darkening *= mix(1.0, 0.7, limb * limb);',
    '    sky += moonCol * disc * 0.85 * darkening * (1.0 - u_daylight);',
    '  }',
    // At noon the sun is a broad diffuse shimmer, not a hard disc: both glows
    // are dimmed and widened so the water gets a soft white sparkle.
    '  float glowWide = mix(0.25, 0.09, u_daylight);',
    '  float glowTight = mix(1.2, 0.28, u_daylight);',
    '  sky += moonCol * glowWide * pow(moonDot, 40.0) * u_moonGlow;',
    '  sky += moonCol * glowTight * pow(moonDot, 400.0) * u_moonGlow;',
    '  return sky;',
    '}',
    '',
    'void main() {',
    '  float aspect = u_res.x / u_res.y;',
    '  vec2 uv = -1.0 + 2.0 * gl_FragCoord.xy / u_res;',
    '  uv.x *= aspect;',
    '  float t = u_time * u_rippleSpeed;',
    '  float tiltRad = u_tilt * 0.7;',
    '  vec3 ro = vec3(0.0, 8.0, 0.0);',
    '  vec3 ww = normalize(vec3(0.0, -sin(tiltRad), cos(tiltRad)));',
    '  vec3 uu = normalize(cross(vec3(0.0, 1.0, 0.0), ww));',
    '  vec3 vv = normalize(cross(ww, uu));',
    '  vec3 rd = normalize(uv.x * uu + uv.y * vv + 2.5 * ww);',
    '  vec3 md = moonDir();',
    '  vec3 moonCol = mix(vec3(0.98, 0.92, 0.85), vec3(1.0), u_daylight);',
    '  vec3 sky = skyColor(rd);',
    '  vec3 col = sky;',
    '  float dsea = -ro.y / rd.y;',
    '  if (dsea > 0.0) {',
    '    vec3 wp = ro + dsea * rd;',
    '    vec4 s = sea(wp.xz, t);',
    '    float h = s.x;',
    '    vec3 nor = s.yzw;',
    '    if (u_mouse.x > 0.0) {',
    '      vec2 mUV = -1.0 + 2.0 * u_mouse / u_res;',
    '      mUV.x *= aspect;',
    '      vec3 mrd = normalize(mUV.x * uu + mUV.y * vv + 2.5 * ww);',
    '      float mdsea = -ro.y / mrd.y;',
    '      if (mdsea > 0.0) {',
    '        vec3 mwp = ro + mdsea * mrd;',
    '        vec2 mdelta = wp.xz - mwp.xz;',
    '        float md2 = length(mdelta);',
    '        float mfreq = 4.0;',
    '        float mphase = md2 * mfreq - t * 5.0;',
    '        float mamp = exp(-md2 * 0.15) * 0.4 * u_waves;',
    '        h += sin(mphase) * mamp;',
    '        float mcos = cos(mphase) * mamp * mfreq;',
    '        vec2 mgrad = md2 > 0.01 ? (mdelta / md2) * mcos : vec2(0.0);',
    '        nor = normalize(nor + vec3(-mgrad.x, 0.0, -mgrad.y) * 2.0);',
    '      }',
    '    }',
    '    nor = mix(nor, vec3(0.0, 1.0, 0.0), smoothstep(0.0, 300.0, dsea));',
    '    float fre = clamp(1.0 - dot(-nor, rd), 0.0, 1.0);',
    '    fre = pow(fre, 3.0);',
    '    float dif = mix(0.25, 1.0, max(dot(nor, md), 0.0));',
    '    vec3 refl = skyColor(reflect(rd, nor));',
    '    vec3 seaCol1 = mix(vec3(0.05, 0.02, 0.01), vec3(0.58), u_daylight);',
    '    vec3 seaCol2 = mix(vec3(0.10, 0.06, 0.04), vec3(0.95), u_daylight);',
    // The pow(col, 0.85) tail lifts everything toward white, so the daylight sea
    // needs a lower diffuse gain to sit below the sky, but a near-moonlit crest
    // gain for the ripple to read as glitter instead of flat haze. Both gains
    // are 1:1 at u_daylight = 0, leaving the moonlit water untouched.
    '    float difGain = mix(0.15, 0.12, u_daylight);',
    '    float crestGain = mix(1.5, 1.1, u_daylight);',
    '    vec3 refr = seaCol1 + dif * moonCol * seaCol2 * difGain * u_moonGlow;',
    '    col = mix(refr, 0.9 * refl, fre);',
    '    float atten = max(1.0 - dsea * dsea * 0.0005, 0.0);',
    '    col += seaCol2 * (wp.y - h) * crestGain * atten;',
    '    col = mix(col, sky, 1.0 - exp(-0.008 * dsea));',
    '  }',
    '  col = pow(max(col, vec3(0.0)), vec3(0.85));',
    '  gl_FragColor = vec4(col, 1.0);',
    '}',
  ].join('\n');

  function compile(type: number, src: string) {
    if (!gl) return null;
    var s = gl.createShader(type);
    if (!s) return null;
    gl.shaderSource(s, src);
    gl.compileShader(s);
    if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) { canvas!.style.display = 'none'; return null; }
    return s;
  }
  var vs = compile(gl.VERTEX_SHADER, vertSrc);
  var fs = compile(gl.FRAGMENT_SHADER, fragSrc);
  if (!vs || !fs) return;
  var prog = gl.createProgram();
  if (!prog) return;
  gl.attachShader(prog, vs);
  gl.attachShader(prog, fs);
  gl.linkProgram(prog);
  if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { canvas.style.display = 'none'; return; }
  gl.useProgram(prog);

  var buf = gl.createBuffer();
  gl.bindBuffer(gl.ARRAY_BUFFER, buf);
  gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
  var aPos = gl.getAttribLocation(prog, 'a_pos');
  gl.enableVertexAttribArray(aPos);
  gl.vertexAttribPointer(aPos, 2, gl.FLOAT, false, 0, 0);

  var uTime = gl.getUniformLocation(prog, 'u_time');
  var uRes = gl.getUniformLocation(prog, 'u_res');
  var uRippleSpeed = gl.getUniformLocation(prog, 'u_rippleSpeed');
  var uMoonGlow = gl.getUniformLocation(prog, 'u_moonGlow');
  var uMouse = gl.getUniformLocation(prog, 'u_mouse');
  var uTilt = gl.getUniformLocation(prog, 'u_tilt');
  var uWaves = gl.getUniformLocation(prog, 'u_waves');
  var uDaylight = gl.getUniformLocation(prog, 'u_daylight');

  var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
  var needsResize = true;
  var running = true;
  var mouseX = -1.0, mouseY = -1.0;
  var lastTime = 0;

  // --- Theme -> palette blend -------------------------------------------
  // 0.0 = moonlit water (html.dark), 1.0 = daylight water (light mode).
  var DAYLIGHT_FADE_MS = 420;
  function readTheme(): number {
    return document.documentElement.classList.contains('dark') ? 0.0 : 1.0;
  }
  var daylightTarget: number = readTheme();
  var daylight: number = daylightTarget;
  var daylightFrom: number = daylight;
  var fadeStart = 0;

  // Eased (smoothstep) so the palette never eases linearly into place.
  // Reads the clock itself instead of taking the rAF timestamp: fadeStart comes
  // from performance.now() in the MutationObserver, and a rAF timestamp is the
  // *start* of the current frame, so on a slow frame it can predate fadeStart.
  // A negative p would stall the fade and, unclamped, overshoot past the target
  // palette, so p is clamped to [0, 1].
  function applyDaylight() {
    if (!gl) return;
    if (prefersReduced) {
      daylight = daylightTarget;
    } else if (daylight !== daylightTarget) {
      var p = fadeStart === 0 ? 1 : (performance.now() - fadeStart) / DAYLIGHT_FADE_MS;
      if (p >= 1) daylight = daylightTarget;
      else if (p > 0) daylight = daylightFrom + (daylightTarget - daylightFrom) * (p * p * (3 - 2 * p));
    }
    gl.uniform1f(uDaylight, daylight);
  }

  function resize() {
    if (!canvas || !gl) return;
    needsResize = false;
    var w = Math.round(canvas.clientWidth * dpr);
    var h = Math.round(canvas.clientHeight * dpr);
    if (w === 0 || h === 0) { needsResize = true; return; }
    if (canvas.width !== w || canvas.height !== h) {
      canvas.width = w; canvas.height = h;
      gl.viewport(0, 0, w, h);
      gl.uniform2f(uRes, w, h);
    }
  }

  function setStaticUniforms() {
    if (!gl) return;
    gl.uniform1f(uRippleSpeed, 0.5);
    gl.uniform1f(uMoonGlow, 1.0);
    gl.uniform1f(uTilt, 0.15);
    gl.uniform1f(uWaves, 1.0);
    gl.uniform2f(uMouse, mouseX, mouseY);
  }

  function render(now: number) {
    if (!running) { requestAnimationFrame(render); return; }
    if (!gl) return;
    if (needsResize) resize();
    setStaticUniforms();
    
    // Pause animation when typing
    var timeToUse = isTyping ? lastTime : now;
    if (!isTyping) lastTime = now;
    
    applyDaylight();
    gl.uniform1f(uTime, prefersReduced ? 0.0 : timeToUse * 0.001);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
    requestAnimationFrame(render);
  }

  window.addEventListener('resize', function () { needsResize = true; });
  document.addEventListener('visibilitychange', function () { running = !document.hidden; });
  
  // Pause starfield/water when typing
  var isTyping = false;
  window.addEventListener('typing-start', function () { isTyping = true; });
  window.addEventListener('typing-stop', function () { isTyping = false; });
  window.addEventListener('typing-reset', function () { isTyping = false; });

  // Watch the theme toggle flipping html.dark and cross-fade the palette in the
  // existing rAF loop — the canvas, context and program are never re-created,
  // so there is no frame of unstyled/black canvas in between.
  function onThemeChange() {
    var next = readTheme();
    if (next === daylightTarget) return;
    daylightFrom = daylight;
    daylightTarget = next;
    fadeStart = prefersReduced ? 0 : performance.now();
    if (prefersReduced) {
      // No animation loop in reduced-motion mode: repaint exactly one still frame.
      // Scheduled inside a frame so the drawing buffer actually gets composited
      // (the context is created with preserveDrawingBuffer: false).
      requestAnimationFrame(function () {
        if (!gl) return;
        setStaticUniforms();
        applyDaylight();
        gl.uniform1f(uTime, 0.0);
        gl.drawArrays(gl.TRIANGLES, 0, 3);
      });
    }
  }
  var prevObserver = win.__moonlitBgThemeObserver;
  if (prevObserver) prevObserver.disconnect();
  var themeObserver = new MutationObserver(onThemeChange);
  themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  win.__moonlitBgThemeObserver = themeObserver;

  // Mouse ripple listens on window (canvas has pointer-events:none as a background)
  window.addEventListener('mousemove', function (e) {
    if (!canvas) return;
    mouseX = e.clientX * dpr;
    mouseY = (canvas.clientHeight - e.clientY) * dpr;
  }, { passive: true });
  document.documentElement.addEventListener('mouseleave', function () { mouseX = -1.0; mouseY = -1.0; });
  window.addEventListener('touchstart', function (e) {
    if (!canvas) return;
    var t = e.touches[0];
    mouseX = t.clientX * dpr;
    mouseY = (canvas.clientHeight - t.clientY) * dpr;
  }, { passive: true });
  window.addEventListener('touchmove', function (e) {
    if (!canvas) return;
    var t = e.touches[0];
    mouseX = t.clientX * dpr;
    mouseY = (canvas.clientHeight - t.clientY) * dpr;
  }, { passive: true });
  window.addEventListener('touchend', function () { mouseX = -1.0; mouseY = -1.0; }, { passive: true });

  // Optional runtime tuning (Radiant param protocol)
  window.addEventListener('message', function (e) {
    if (!e.data || e.data.type !== 'param') return;
    // RIPPLE_SPEED | MOON_GLOW | CAMERA_TILT | WAVE_INTENSITY
    // (wired for future use; defaults are set in setStaticUniforms)
  });

  resize();
  if (prefersReduced) {
    // Reduced motion: paint ONE static frame, no animation loop
    setStaticUniforms();
    applyDaylight();
    gl.uniform1f(uTime, 0.0);
    gl.drawArrays(gl.TRIANGLES, 0, 3);
  } else {
    requestAnimationFrame(render);
  }

  // --- Starfield Engine --------------------------------------------------
  (function initStarfield() {
    var starCanvas = document.getElementById('starfield') as HTMLCanvasElement | null;
    if (!starCanvas) return;
    var sCtx = starCanvas.getContext('2d', { alpha: true });
    if (!sCtx) return;

    var stars: {x: number, y: number, r: number, a: number}[] = [];
    var meteors: {x: number, y: number, vx: number, vy: number, l: number, a: number, life: number}[] = [];
    var lastMeteorTime = 0;
    var nextMeteorDelay = Math.random() * 7000 + 8000; // 8 to 15 seconds

    function resizeStarfield() {
      if (!starCanvas) return;
      var w = window.innerWidth * dpr;
      var h = window.innerHeight * dpr;
      starCanvas.width = w;
      starCanvas.height = h;
      
      stars = [];
      for (var i = 0; i < 150; i++) {
        stars.push({
          x: Math.random() * w,
          y: Math.random() * (h * 0.6), // Only spawn in top 60%
          r: Math.random() * 1.2 * dpr,
          a: Math.random() * 0.5 + 0.1
        });
      }
    }

    function drawStarfield(now: number) {
      if (!sCtx || !starCanvas) return;
      sCtx.clearRect(0, 0, starCanvas.width, starCanvas.height);
      
      // Draw static stars
      sCtx.fillStyle = '#FFFFFF';
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        sCtx.globalAlpha = s.a;
        sCtx.beginPath();
        sCtx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
        sCtx.fill();
      }

      // Handle Meteors
      if (!prefersReduced && running && !isTyping) {
        if (now - lastMeteorTime > nextMeteorDelay) {
          meteors.push({
            x: Math.random() * starCanvas.width,
            y: Math.random() * (starCanvas.height * 0.2),
            vx: (Math.random() * 8 + 15) * dpr,
            vy: (Math.random() * 3 + 5) * dpr,
            l: (Math.random() * 40 + 60) * dpr,
            a: 1.0,
            life: 1.0
          });
          lastMeteorTime = now;
          nextMeteorDelay = Math.random() * 7000 + 8000;
        }

        for (var j = meteors.length - 1; j >= 0; j--) {
          var m = meteors[j];
          m.x += m.vx;
          m.y += m.vy;
          m.life -= 0.02; // Fade out quickly
          m.a = Math.max(0, m.life);

          if (m.life <= 0) {
            meteors.splice(j, 1);
            continue;
          }

          var len = Math.sqrt(m.vx*m.vx + m.vy*m.vy);
          var dx = (m.vx/len) * m.l;
          var dy = (m.vy/len) * m.l;

          var grad = sCtx.createLinearGradient(m.x, m.y, m.x - dx, m.y - dy);
          grad.addColorStop(0, 'rgba(255, 255, 255, ' + m.a + ')');
          grad.addColorStop(1, 'rgba(255, 255, 255, 0)');

          sCtx.globalAlpha = 1.0;
          sCtx.strokeStyle = grad;
          sCtx.lineWidth = 1.5 * dpr;
          sCtx.lineCap = 'round';
          sCtx.beginPath();
          sCtx.moveTo(m.x, m.y);
          sCtx.lineTo(m.x - dx, m.y - dy);
          sCtx.stroke();
        }
      }

      sCtx.globalAlpha = 1.0;

      if (!prefersReduced) {
        requestAnimationFrame(drawStarfield);
      }
    }

    window.addEventListener('resize', resizeStarfield);
    resizeStarfield();

    if (prefersReduced) {
      drawStarfield(0);
    } else {
      requestAnimationFrame(drawStarfield);
    }
  })();
})();
</script>
