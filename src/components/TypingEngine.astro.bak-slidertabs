    async function generateCertificateCanvas(summary: MetricSummary) {
      if (document.fonts) {
        await document.fonts.ready;
      }

      const ctx = certCanvas.getContext("2d");
      if (!ctx) return;

      const w = certCanvas.width;
      const h = certCanvas.height;

      ctx.fillStyle = "#000000";
      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = "rgba(255,255,255,0.12)";
      ctx.lineWidth = 1;
      ctx.strokeRect(16, 16, w - 32, h - 32);

      ctx.fillStyle = "#0072F5";
      ctx.font = '600 13px "Inter Variable", system-ui, sans-serif';
      ctx.textAlign = "center";
      ctx.fillText(t("cert.official_title"), w / 2, 70);

      ctx.fillStyle = "#F5F5F7";
      ctx.font = '700 28px "Inter Variable", system-ui, sans-serif';
      ctx.fillText("Instant Typing", w / 2, 110);

      ctx.fillStyle = "#A1A1A6";
      ctx.font = '400 13px "Inter Variable", system-ui, sans-serif';
      ctx.fillText(
        t("cert.certifies"),
        w / 2,
        140,
      );

      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.beginPath();
      ctx.moveTo(80, 165);
      ctx.lineTo(w - 80, 165);
      ctx.stroke();

      const col1 = w / 2 - 180;
      const col2 = w / 2;
      const col3 = w / 2 + 180;

      ctx.fillStyle = "#0072F5";
      ctx.font = '700 42px "JetBrains Mono Variable", monospace';
      ctx.fillText(String(summary.netWpm), col1, 235);
      ctx.fillStyle = "#A1A1A6";
      ctx.font = '500 11px "Inter Variable", sans-serif';
      ctx.fillText(t("cert.net_wpm"), col1, 260);

      ctx.fillStyle = "#34C759";
      ctx.font = '700 42px "JetBrains Mono Variable", monospace';
      ctx.fillText(`${summary.accuracy}%`, col2, 235);
      ctx.fillStyle = "#A1A1A6";
      ctx.font = '500 11px "Inter Variable", sans-serif';
      ctx.fillText(t("cert.accuracy"), col2, 260);

      ctx.fillStyle = "#F5F5F7";
      ctx.font = '700 42px "JetBrains Mono Variable", monospace';
      ctx.fillText(`${summary.consistency}%`, col3, 235);
      ctx.fillStyle = "#A1A1A6";
      ctx.font = '500 11px "Inter Variable", sans-serif';
      ctx.fillText(t("cert.consistency"), col3, 260);

      ctx.fillStyle = "#F5F5F7";
      ctx.font = '600 18px "Inter Variable", sans-serif';
      ctx.fillText(summary.rankTitle, w / 2, 315);

      ctx.strokeStyle = "rgba(255,255,255,0.08)";
      ctx.beginPath();
      ctx.moveTo(80, 350);
      ctx.lineTo(w - 80, 350);
      ctx.stroke();

      const verificationId = `PTT-${Date.now().toString(36).toUpperCase()}-${Math.floor(Math.random() * 9000 + 1000)}`;
      document.getElementById("cert-verification-id")!.textContent =
        `${t("cert.certificate_id")}${verificationId}`;

      ctx.fillStyle = "#86868B";
      ctx.font = '400 10px "JetBrains Mono Variable", monospace';
      ctx.textAlign = "left";
      ctx.fillText(`${t("cert.verification_id")}${verificationId}`, 80, 390);
      const d = new Date().toLocaleDateString(getLanguage(), { year: "numeric", month: "short", day: "numeric" });
      ctx.fillText(
        `${t("cert.date")}${d}`,
        80,
        410,
      );

      ctx.textAlign = "right";
      ctx.fillText(t("cert.certified_at"), w - 80, 390);
      ctx.fillText(t("cert.standard"), w - 80, 410);
    }

    btnDownloadCert.addEventListener("click", () => {
      const link = document.createElement("a");
      link.download = `practice-test-typing-certificate-${Date.now()}.png`;
      link.href = certCanvas.toDataURL("image/png");
      link.click();
    });

    themeSelect.addEventListener("change", () => {
      const selectedTheme = themeSelect.value;
      container.classList.remove(
        "theme-cyberpunk",
        "theme-gradient",
        "theme-3d",
      );
      if (selectedTheme !== "default") {
        container.classList.add(selectedTheme);
      }
    });

    const defaultModeBtn = document.querySelector(
      `[data-mode-btn="${initialModeAttr}"]`,
    );
    if (defaultModeBtn) {
      defaultModeBtn.classList.add(
        "bg-[#1D1D1F]",
        "text-white",
        "dark:bg-white",
        "dark:text-black",
        "font-semibold",
      );
    }
    const defaultTimeBtn = document.querySelector(
      `[data-time-val="${initialDurationAttr}"]`,
    );
    if (defaultTimeBtn) {
      defaultTimeBtn.classList.add(
        "font-semibold",
        "bg-[#1D1D1F]",
        "text-white",
        "dark:bg-white",
        "dark:text-black",
        "!border-[#1D1D1F]",
      );
    }
    if (wordbankSelect) {
      wordbankSelect.value = initialWordbankAttr;
    }
    
    if (soundSelect) {
      // Initialize the sound theme from local storage
      soundSelect.value = initSoundThemeFromStorage();
      
      // Update the sound theme and play a preview note on change
      soundSelect.addEventListener("change", () => {
        setSoundTheme(soundSelect.value as any);
        console.info("[audio] theme:", soundSelect.value);
        // Play a preview sound (isSpace=false, isError=false)
        playKeyStrokeSound("a", false, false);
      });
    }

    if (backspaceSelect) {
      backspaceSelect.value = selectedBackspaceMode;
      backspaceSelect.addEventListener("change", () => {
        selectedBackspaceMode = backspaceSelect.value === "current" ? "current" : "full";
        try {
          localStorage.setItem("ptt_backspace_mode", selectedBackspaceMode);
        } catch {}
        if (!testActive) {
          activeBackspaceMode = selectedBackspaceMode;
        }
      });
    }

    const currentLang = getLanguage();
    if (["es", "fr", "de", "pt", "it"].includes(currentLang) && currentWordbankName === "top200") {
      currentWordbankName = currentLang;
      wordbankSelect.value = currentLang;
    }

    resetTest();
    // Auto-focus on load so user can start typing immediately
    safeSetTimeout(() => focusTyping(), 50);

    const cleanup = () => {
      window.removeEventListener("keydown", handleKeydown);
      window.removeEventListener("resize", onLayoutChange);
      window.removeEventListener("instanttyping:languagechange", handleLanguageChange);
      if (hiddenInput) {
        hiddenInput.removeEventListener("focus", focusTyping);
        hiddenInput.removeEventListener("blur", blurTyping);
        hiddenInput.removeEventListener("input", handleInput);
      }
      if (resizeObserver) {
        resizeObserver.disconnect();
      }
      __activeTimeouts.forEach(clearTimeout);
    };
    (window as any).__typingEngineCleanup = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }
</script>










