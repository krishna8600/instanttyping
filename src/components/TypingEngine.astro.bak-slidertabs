    typingDisplay.addEventListener("click", focusTyping);
    typingDisplay.addEventListener("touchstart", focusTyping, { passive: true });
    focusPrompt.addEventListener("click", focusTyping);
    focusPrompt.addEventListener("touchstart", focusTyping, { passive: true });
    hiddenInput.addEventListener("focus", focusTyping);
    hiddenInput.addEventListener("blur", blurTyping);

    function handleCharacterInput(char: string) {
      if (testCompleted) return;
      if (!testActive) startTest();
      lastKeystrokeTime = performance.now();
      if (isIdlePaused) resumeFromIdlePause();

      const targetWord = wordsList[currentWordIndex] || "";

      if (char === " ") {
        if (currentInput.length === 0) {
          dispatchNextChar();
          return;
        }

        const isWordCorrect = currentInput === targetWord;
        wordInputs[currentWordIndex] = currentInput;

        if (!isWordCorrect) {
          missedWords.push(targetWord);
          playKeyStrokeSound(" ", true, true);
          emitTyping('typing-key-result', { char: " ", correct: false });
        } else {
          playKeyStrokeSound(" ", true, false);
          correctKeystrokes += 1;
          emitTyping('typing-key-result', { char: " ", correct: true });
        }

        // Complete previous word on cached node
        const prevWordEl = cachedWordNodes[currentWordIndex];
        if (prevWordEl) {
          prevWordEl.classList.remove("active-word");
          prevWordEl.classList.add("word-completed");
          if (!isWordCorrect) {
            prevWordEl.classList.add("word-has-error");
          }
        }

        currentWordIndex++;
        currentInput = "";
        hiddenInput.value = "";

        // Guardrail 2: Preserve on-demand word appending for timed modes
        if (currentMode === "time" && wordsList.length - currentWordIndex < 35) {
          appendMoreWords(50);
        }

        if (currentWordIndex >= wordsList.length) {
          finishTest();
          return;
        }

        // Activate next word on cached node
        const nextWordEl = cachedWordNodes[currentWordIndex];
        if (nextWordEl) {
          nextWordEl.classList.add("active-word");
          const chars = cachedCharNodes[currentWordIndex] || [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className = "char char-untyped";
          }
        }

        updateWordOffsets(currentWordIndex);
        updateCaretPosition();
        dispatchNextChar();
        return;
      }

      if (!keyMistakes[char]) keyMistakes[char] = { errors: 0, total: 0 };
      keyMistakes[char].total++;

      const currentInputChars = Array.from(currentInput);
      const targetWordChars = Array.from(targetWord);
      const charIdx = currentInputChars.length;
      const targetChar = targetWordChars[charIdx] || "";
      const isCorrectChar = char.normalize("NFC") === targetChar.normalize("NFC");

      if (isCorrectChar) {
        correctKeystrokes++;
        playKeyStrokeSound(char, false, false);
        emitTyping('typing-key-result', { char, correct: true });
      } else {
        incorrectKeystrokes++;
        keyMistakes[char].errors++;
        playKeyStrokeSound(char, false, true);
        emitTyping('typing-key-result', { char, correct: false });
      }

      currentInput += char;

      // Update char class on cached node
      const chars = cachedCharNodes[currentWordIndex];
      if (charIdx < targetWordChars.length && chars && chars[charIdx]) {
        chars[charIdx].className = isCorrectChar ? "char char-correct" : "char char-error";
      } else {
        // Extra characters beyond target word length
        const activeWordEl = cachedWordNodes[currentWordIndex];
        if (activeWordEl) {
          const extraSpan = document.createElement("span");
          extraSpan.className = "extra-char char-extra";
          extraSpan.textContent = char;
          activeWordEl.appendChild(extraSpan);
          if (extraCharNodes[currentWordIndex]) {
            extraCharNodes[currentWordIndex].push(extraSpan);
          }
          updateWordOffsets(currentWordIndex);
        }
      }

      updateCaretPosition();
      dispatchNextChar();
    }

    function handleBackspace() {
      if (testCompleted) return;
      if (testActive) lastKeystrokeTime = performance.now();
      if (isIdlePaused) resumeFromIdlePause();

      const inputChars = Array.from(currentInput);
      if (inputChars.length > 0) {
        emitTyping('typing-backspace');
        const lastIdx = inputChars.length - 1;
        const targetWord = wordsList[currentWordIndex] || "";
        const targetWordChars = Array.from(targetWord);

        if (lastIdx >= targetWordChars.length) {
          // Remove extra character
          const extras = extraCharNodes[currentWordIndex];
          if (extras && extras.length > 0) {
            const extraSpan = extras.pop();
            extraSpan?.remove();
            updateWordOffsets(currentWordIndex);
          }
        } else {
          const chars = cachedCharNodes[currentWordIndex];
          if (chars && chars[lastIdx]) {
            chars[lastIdx].className = "char char-untyped";
          }
        }

        inputChars.pop();
        currentInput = inputChars.join("");
        hiddenInput.value = currentInput;
        updateCaretPosition();
        playKeyStrokeSound("Backspace", false, false);
      } else if (currentWordIndex > 0) {
        if (activeBackspaceMode === "current") {
          return;
        }
        emitTyping('typing-backspace');
        // Backspacing across word boundary into previous word
        const currentWordEl = cachedWordNodes[currentWordIndex];
        if (currentWordEl) {
          currentWordEl.classList.remove("active-word");
          const chars = cachedCharNodes[currentWordIndex] || [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className = "char char-untyped";
          }
        }

        currentWordIndex--;
        const prevWordEl = cachedWordNodes[currentWordIndex];
        if (prevWordEl) {
          prevWordEl.classList.remove("word-completed", "word-has-error");
          prevWordEl.classList.add("active-word");
        }

        // Pop last missed word if it was this word
        const targetWord = wordsList[currentWordIndex] || "";
        const lastMissed = missedWords[missedWords.length - 1];
        if (lastMissed === targetWord) {
          missedWords.pop();
        }

        currentInput = wordInputs[currentWordIndex] || "";
        hiddenInput.value = currentInput;
        updateWordOffsets(currentWordIndex);
        updateCaretPosition();
        playKeyStrokeSound("Backspace", false, false);
      }
      
      dispatchNextChar();
    }

    function handleCtrlBackspace() {
      if (testCompleted) return;

      if (currentInput.length > 0) {
        emitTyping('typing-backspace');
        // Clear current word mid-word
        const extras = extraCharNodes[currentWordIndex];
        let hadExtras = false;
        if (extras && extras.length > 0) {
          hadExtras = true;
          while (extras.length > 0) {
            extras.pop()?.remove();
          }
        }
        const chars = cachedCharNodes[currentWordIndex] || [];
        for (let i = 0; i < chars.length; i++) {
          chars[i].className = "char char-untyped";
        }
        currentInput = "";
        hiddenInput.value = "";
        if (hadExtras) {
          updateWordOffsets(currentWordIndex);
        }
        updateCaretPosition();
        playKeyStrokeSound("Backspace", false, false);
      } else if (currentWordIndex > 0) {
        if (activeBackspaceMode === "current") {
          return;
        }
        emitTyping('typing-backspace');
        // Clear previous word when at start of word
        const currentWordEl = cachedWordNodes[currentWordIndex];
        if (currentWordEl) {
          currentWordEl.classList.remove("active-word");
          const chars = cachedCharNodes[currentWordIndex] || [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className = "char char-untyped";
          }
        }

        currentWordIndex--;
        const prevWordEl = cachedWordNodes[currentWordIndex];
        if (prevWordEl) {
          prevWordEl.classList.remove("word-completed", "word-has-error");
          prevWordEl.classList.add("active-word");
        }

        const targetWord = wordsList[currentWordIndex] || "";
        const lastMissed = missedWords[missedWords.length - 1];
        if (lastMissed === targetWord) {
          missedWords.pop();
        }

        const extras = extraCharNodes[currentWordIndex];
        if (extras && extras.length > 0) {
          while (extras.length > 0) {
            extras.pop()?.remove();
          }
        }
        const chars = cachedCharNodes[currentWordIndex] || [];
        for (let i = 0; i < chars.length; i++) {
          chars[i].className = "char char-untyped";
        }

        currentInput = "";
        wordInputs[currentWordIndex] = "";
        hiddenInput.value = "";
        updateWordOffsets(currentWordIndex);
        updateCaretPosition();
        playKeyStrokeSound("Backspace", false, false);
      }
      
      dispatchNextChar();
    }

    function handleKeydown(e: KeyboardEvent) {
      // Caps Lock warning: show pill + amber ring on typing area when on
      try {
        const capsOn = e.getModifierState && e.getModifierState("CapsLock");
        capsLockWarning.classList.toggle("hidden", !capsOn);
        typingDisplay.classList.toggle("!border-[#FF9F0A]/60", !!capsOn);
        typingDisplay.classList.toggle("!shadow-[0_0_0_3px_rgba(255,159,10,0.15)]", !!capsOn);
      } catch {}

      // Idle resume: if paused due to inactivity, resume on any keystroke
      if (isIdlePaused && testActive && !testCompleted && e.key.length === 1) {
        resumeFromIdlePause();
      }
      // Track last keystroke time for idle detection
      if (testActive && !testCompleted && e.key.length === 1) {
        lastKeystrokeTime = performance.now();
      }

      // Tab or Tab+Enter to restart
      if (e.key === "Tab") {
        e.preventDefault();
        resetTest();
        focusTyping();
        return;
      }

      if (e.key === "Enter" && (e.shiftKey || !resultsPanel.classList.contains("hidden"))) {
        e.preventDefault();
        resetTest();
        focusTyping();
        return;
      }

      if (e.key === "Escape") {
        if (!certModal.classList.contains("hidden")) {
          certModal.classList.add("hidden");
          return;
        }
        resetTest();
        return;
      }

      // Handle Backspace
      if (e.key === "Backspace") {
        if (e.ctrlKey || e.altKey || e.metaKey) {
          e.preventDefault();
          handleCtrlBackspace();
          return;
        }
        if (currentInput.length === 0) {
          e.preventDefault();
          handleBackspace();
          return;
        }
      }

      if (
        !testActive &&
        !testCompleted &&
        e.key.length === 1 &&
        !e.ctrlKey &&
        !e.metaKey &&
        !e.altKey
      ) {
        focusTyping();
      }

      if (
        document.activeElement === hiddenInput ||
        document.activeElement === typingDisplay
      ) {
        if (e.key === " ") {
          e.preventDefault();
          handleCharacterInput(" ");
        }
        if (testActive && (e.key === "ArrowUp" || e.key === "ArrowDown" || e.key === "ArrowLeft" || e.key === "ArrowRight")) {
          e.preventDefault();
        }
      }
    }
    window.addEventListener("keydown", handleKeydown);

    // Item 1: Window resize & ResizeObserver for zoom / container changes
    function onLayoutChange() {
      if (cachedWordNodes.length === 0) return;
      measureLayout();
      updateCaretPosition();
    }

    window.addEventListener("resize", onLayoutChange);

    let resizeObserver: ResizeObserver | null = null;
    if (typeof ResizeObserver !== "undefined" && typingDisplay) {
      resizeObserver = new ResizeObserver(onLayoutChange);
      resizeObserver.observe(typingDisplay);
    }

    // Item 2: Gate measurement on document.fonts.ready with 350ms fallback timeout
    if (document.fonts && document.fonts.ready) {
      const timeoutPromise = new Promise<void>((resolve) => safeSetTimeout(resolve as TimerHandler, 350));
      Promise.race([document.fonts.ready, timeoutPromise]).then(() => {
        onLayoutChange();
      });
      document.fonts.ready.then(() => {
        onLayoutChange();
      });
    }

    function handleInput(e: Event) {
      const inputEv = e as InputEvent;

      if (
        inputEv.inputType === "deleteContentBackward" ||
        inputEv.inputType === "deleteWordBackward" ||
        hiddenInput.value.length < currentInput.length
      ) {
        if (inputEv.inputType === "deleteWordBackward") {
          handleCtrlBackspace();
        } else {
          handleBackspace();
        }
      } else if (inputEv.data) {
        const val = inputEv.data;
        for (let i = 0; i < val.length; i++) {
          handleCharacterInput(val[i]);
        }
      } else if (hiddenInput.value.length > currentInput.length) {
        const val = hiddenInput.value.slice(currentInput.length);
        for (let i = 0; i < val.length; i++) {
          handleCharacterInput(val[i]);
        }
      }

      hiddenInput.value = currentInput;
    }
