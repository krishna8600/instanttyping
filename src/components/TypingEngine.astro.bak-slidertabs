---
import Icon from "./Icon.astro";

interface Props {
  initialDuration?: number;
  initialMode?: "time" | "words" | "quote" | "custom" | "classics";
  initialWordbank?: "top200" | "top1000" | "numbers" | "beginner" | "quote" | "classics";
  pageHeading?: string;
  pageSubheading?: string;
  pageHeadingKey?: string;
  pageSubheadingKey?: string;
}

const {
  initialDuration = 60,
  initialMode = "time",
  initialWordbank = "top200",
  pageHeading = "Typing Speed & Accuracy Test",
  pageSubheading = "Test your typing speed with real-time Words Per Minute (WPM), accuracy, and detailed error analysis.",
  pageHeadingKey,
  pageSubheadingKey,
} = Astro.props;
---

<div
  class="w-full space-y-3"
  id="typing-test-container"
  data-initial-duration={initialDuration}
  data-initial-mode={initialMode}
  data-initial-wordbank={initialWordbank}
>
  <!-- Heading Section -->
  <div class="pb-6 border-b border-[#E5E5E5] dark:border-white/10">
    <h1
      class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-balance mb-3"
      style="letter-spacing:-0.02em"
      data-i18n={pageHeadingKey}
    >
      {pageHeading}
    </h1>
    <p
      class="text-[1.125rem] leading-[1.6] text-[#6E6E73] dark:text-[#A1A1A6] max-w-2xl"
      data-i18n={pageSubheadingKey}
    >
      {pageSubheading}
    </p>
  </div>

  <!-- Mode & Configuration Bar -->
  <div
    class="premium-card flex flex-wrap items-center justify-between gap-3 text-sm"
  >
    <!-- Test Type Selector -->
    <div
      class="flex items-center gap-1 bg-[#F5F5F7] dark:bg-white/10 p-1 rounded-full shrink-0"
    >
      <button
        type="button"
        data-mode-btn="time"
        data-i18n="test.time"
        class="mode-tab-btn px-4 py-1.5 rounded-full font-semibold transition-all duration-200 ease-out text-sm"
      >
        Time
      </button>
      <button
        type="button"
        data-mode-btn="words"
        data-i18n="test.words"
        class="mode-tab-btn px-4 py-1.5 rounded-full font-medium transition-all duration-200 ease-out text-sm"
      >
        Words
      </button>
      <button
        type="button"
        data-mode-btn="quote"
        data-i18n="test.mode_quote"
        class="mode-tab-btn px-4 py-1.5 rounded-full font-medium transition-all duration-200 ease-out text-sm"
      >
        Quote
      </button>
      <button
        type="button"
        data-mode-btn="classics"
        data-i18n="test.mode_classics"
        class="mode-tab-btn px-4 py-1.5 rounded-full font-medium transition-all duration-200 ease-out text-sm"
      >
        Custom
      </button>
    </div>

    <!-- Duration / Count Options -->
    <div
      id="time-options"
      class="flex items-center gap-1.5 font-mono animate-spring-enter shrink-0"
    >
      <span
        class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold"
        data-i18n="test.time"
        >Duration:</span
      >
      <button
        type="button"
        data-time-val="15"
        class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-all duration-200 ease-out"
      >
        15s
      </button>
      <button
        type="button"
        data-time-val="30"
        class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-all duration-200 ease-out"
      >
        30s
      </button>
      <button
        type="button"
        data-time-val="60"
        class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-all duration-200 ease-out"
      >
        60s
      </button>
      <button
        type="button"
        data-time-val="120"
        class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-all duration-200 ease-out"
      >
        120s
      </button>
    </div>

    <div
      id="words-options"
      class="hidden items-center gap-1.5 font-mono animate-spring-enter shrink-0"
    >
      <span
        class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold"
        data-i18n="test.words"
        >Words:</span
      >
      <button
        type="button"
        data-word-count-val="10"
        class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium"
        >10</button
      >
      <button
        type="button"
        data-word-count-val="25"
        class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium"
        >25</button
      >
      <button
        type="button"
        data-word-count-val="50"
        class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium"
        >50</button
      >
      <button
        type="button"
        data-word-count-val="100"
        class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium"
        >100</button
      >
    </div>

    <!-- Wordbank Difficulty Selector -->
    <div
      id="wordbank-select-container"
      class="flex items-center gap-1.5 font-mono shrink-0"
    >
      <label
        for="wordbank-select"
        class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold"
        data-i18n="settings.language"
        >Corpus:</label
      >
      <select
        id="wordbank-select"
        class="h-8 pl-3 pr-8 text-xs rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] cursor-pointer focus:outline-none focus:border-[#0072F5] shrink-0 appearance-none bg-no-repeat bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%236E6E73%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] dark:bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%23A1A1A6%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_0.5rem_center] bg-[size:16px_16px]"
      >
        <option class="dark:bg-[#1D1D1F]" value="top200" data-i18n="options.corpus_top200"
          >Common Words (Top 200)</option
        >
        <option class="dark:bg-[#1D1D1F]" value="top1000" data-i18n="options.corpus_top1000"
          >Expanded Vocabulary (Top 1000)</option
        >
        <option class="dark:bg-[#1D1D1F]" value="es" data-i18n="options.corpus_es">Español (Top 250)</option>
        <option class="dark:bg-[#1D1D1F]" value="fr" data-i18n="options.corpus_fr">Français (Top 250)</option>
        <option class="dark:bg-[#1D1D1F]" value="de" data-i18n="options.corpus_de">Deutsch (Top 250)</option>
        <option class="dark:bg-[#1D1D1F]" value="pt" data-i18n="options.corpus_pt">Português (Top 250)</option>
        <option class="dark:bg-[#1D1D1F]" value="it" data-i18n="options.corpus_it">Italiano (Top 250)</option>
        <option class="dark:bg-[#1D1D1F]" value="numbers" data-i18n="options.corpus_numbers"
          >Numbers & Symbols</option
        >
        <option class="dark:bg-[#1D1D1F]" value="beginner" data-i18n="options.corpus_beginner"
          >Beginner Friendly</option
        >
        <option class="dark:bg-[#1D1D1F]" value="quote" data-i18n="options.corpus_quote">Famous Quotes</option>
        <option class="dark:bg-[#1D1D1F]" value="classics" data-i18n="options.corpus_classics">Classic Passages</option>
      </select>
    </div>

    <!-- Sound Theme Selector -->
    <div
      id="sound-select-container"
      class="flex items-center gap-1.5 font-mono shrink-0"
    >
      <label
        for="sound-select"
        class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold"
        data-i18n="settings.sound"
        >Sound:</label
      >
      <select
        id="sound-select"
        class="h-8 pl-3 pr-8 text-xs rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] cursor-pointer focus:outline-none focus:border-[#0072F5] shrink-0 appearance-none bg-no-repeat bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%236E6E73%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] dark:bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%23A1A1A6%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_0.5rem_center] bg-[size:16px_16px]"
      >
        <option class="dark:bg-[#1D1D1F]" value="mechanical" data-i18n="options.sound_mechanical">Mechanical</option>
        <option class="dark:bg-[#1D1D1F]" value="click" data-i18n="options.sound_click">Click</option>
        <option class="dark:bg-[#1D1D1F]" value="piano" data-i18n="options.sound_piano">Piano</option>
        <option class="dark:bg-[#1D1D1F]" value="guitar" data-i18n="options.sound_guitar">Guitar</option>
        <option class="dark:bg-[#1D1D1F]" value="nature" data-i18n="options.sound_nature">Nature</option>
        <option class="dark:bg-[#1D1D1F]" value="creative" data-i18n="options.sound_creative">Creative</option>
      </select>
    </div>

    <!-- Visual Theme Selector -->
    <div class="flex items-center gap-1.5 font-mono ml-auto sm:ml-0 shrink-0">
      <label
        for="theme-select"
        class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold"
        data-i18n="settings.theme"
        >Theme:</label
      >
      <select
        id="theme-select"
        class="h-8 pl-3 pr-8 text-xs rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] cursor-pointer focus:outline-none shrink-0 appearance-none bg-no-repeat bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%236E6E73%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] dark:bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%23A1A1A6%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_0.5rem_center] bg-[size:16px_16px]"
      >
        <option class="dark:bg-[#1D1D1F]" value="default" data-i18n="options.theme_default">Default</option>
        <option class="dark:bg-[#1D1D1F]" value="theme-cyberpunk" data-i18n="options.theme_cyberpunk"
          >Cyberpunk Neon</option
        >
        <option class="dark:bg-[#1D1D1F]" value="theme-gradient" data-i18n="options.theme_gradient"
          >Ocean Gradient</option
        >
        <option class="dark:bg-[#1D1D1F]" value="theme-3d" data-i18n="options.theme_3d">3D Embossed</option>
      </select>
    </div>

    <!-- Backspace Behavior Selector -->
    <div
      id="backspace-select-container"
      class="flex items-center gap-1.5 font-mono ml-auto sm:ml-0 shrink-0"
    >
      <label
        for="backspace-select"
        class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold"
        data-i18n="test.backspace"
        >Backspace:</label
      >
      <select
        id="backspace-select"
        class="h-8 pl-3 pr-8 text-xs rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] cursor-pointer focus:outline-none focus:border-[#0072F5] shrink-0 appearance-none bg-no-repeat bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%236E6E73%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] dark:bg-[url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20width%3D%2224%22%20height%3D%2224%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Cpath%20d%3D%22M7%2010L12%2015L17%2010%22%20stroke%3D%22%23A1A1A6%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%2F%3E%3C%2Fsvg%3E')] bg-[position:right_0.5rem_center] bg-[size:16px_16px]"
      >
        <option class="dark:bg-[#1D1D1F]" value="full" data-i18n="options.backspace_full">Full</option>
        <option class="dark:bg-[#1D1D1F]" value="current" data-i18n="options.backspace_current">Current Word Only</option>
      </select>
    </div>
  </div>

  <!-- Custom Text Input Section -->
  <div
    id="custom-text-container"
    class="hidden flex-col gap-3 premium-card animate-spring-enter"
  >
    <label
      for="custom-text-input"
      class="text-[0.9375rem] font-semibold text-[#1D1D1F] dark:text-[#F5F5F7]"
      data-i18n="test.custom_label"
      >Enter your own text to practice:</label
    >
    <textarea
      id="custom-text-input"
      class="w-full h-32 p-4 text-[1.125rem] leading-[1.6] rounded-xl border border-[#E5E5E5] dark:border-white/10 bg-[#FAFAFA] dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] focus:outline-none focus:border-[#0072F5] resize-none"
      placeholder="Paste or type your custom text here..." 
      data-i18n-placeholder="test.custom_placeholder"></textarea>
    <div class="flex justify-end">
      <button type="button" id="btn-start-custom" class="btn-primary"
        ><span data-i18n="test.start_custom">Start Custom Test</span></button
      >
    </div>
  </div>

  <!-- Real-Time Metrics Strip -->
  <div id="metrics-strip" class="grid grid-cols-2 lg:grid-cols-4 gap-2">
    <div class="premium-card flex items-start gap-3 !p-2">
      <span
        class="flex items-center justify-center w-7 h-7 shrink-0 text-ds-text-secondary"
        aria-hidden="true"
      >
        <Icon name="timer" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wider text-ds-text-secondary" data-i18n="results.time">Timer</div>
        <div
          id="metric-timer"
          class="text-3xl font-mono font-bold tracking-tight mt-1 text-ds-text-primary mt-1 text-[#1D1D1F] dark:text-[#F5F5F7] font-mono"
        >
          60s
        </div>
      </div>
    </div>
    <div class="premium-card flex items-start gap-3 !p-2">
      <span
        class="flex items-center justify-center w-7 h-7 shrink-0 text-ds-text-secondary"
        aria-hidden="true"
      >
        <Icon name="bolt" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wider text-ds-text-secondary" data-i18n="results.wpm_short">Net WPM</div>
        <div
          id="metric-wpm"
          class="text-3xl font-mono font-bold tracking-tight mt-1 text-ds-text-primary mt-1 text-[#0072F5] font-mono"
        >
          0
        </div>
      </div>
    </div>
    <div class="premium-card flex items-start gap-3 !p-2">
      <span
        class="flex items-center justify-center w-7 h-7 shrink-0 text-ds-text-secondary"
        aria-hidden="true"
      >
        <Icon name="target" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wider text-ds-text-secondary" data-i18n="results.accuracy">Accuracy</div>
        <div
          id="metric-accuracy"
          class="text-3xl font-mono font-bold tracking-tight mt-1 text-ds-text-primary mt-1 text-[#1D1D1F] dark:text-[#F5F5F7] font-mono"
        >
          100%
        </div>
      </div>
    </div>
    <div class="premium-card flex items-start gap-3 !p-2">
      <span
        class="flex items-center justify-center w-7 h-7 shrink-0 text-ds-text-secondary"
        aria-hidden="true"
      >
        <Icon name="cancel" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="text-xs font-semibold uppercase tracking-wider text-ds-text-secondary" data-i18n="results.errors_metric">Errors</div>
        <div
          id="metric-errors"
          class="text-3xl font-mono font-bold tracking-tight mt-1 text-ds-text-primary mt-1 text-[#1D1D1F] dark:text-[#F5F5F7] font-mono"
        >
          0
        </div>
      </div>
    </div>
  </div>

  <!-- Active Typing Surface -->
  <div id="typing-surface-wrapper" class="relative">
    <div
      id="typing-display"
      tabindex="0"
      role="textbox"
      aria-label="Typing test text area" data-i18n-aria-label="engine.aria_textarea"
      class="relative w-full min-h-[168px] p-6 font-mono text-xl sm:text-2xl leading-loose tracking-[0.01em] select-none cursor-text transition-all duration-200"
    >
      <div id="words-viewport" class="relative overflow-hidden h-[148px] sm:h-[160px]">
        <div
          id="words-wrapper"
          class="relative flex flex-wrap gap-x-2 gap-y-1.5 items-center will-change-transform transition-transform duration-150 ease-out"
        >
          <div
            id="typing-caret"
            class="typing-caret absolute top-0 left-0 pointer-events-none z-10 will-change-transform"
            style="transform: translate3d(0, 0, 0);"
          ></div>
          <!-- Words rendered dynamically here -->
        </div>
      </div>

      <!-- Click to focus banner -->
      <div
        id="focus-prompt"
        class="absolute inset-0 bg-white/60 dark:bg-black/40 backdrop-blur-[2px] flex items-center justify-center rounded-[20px] transition-opacity"
      >
        <div
          class="px-4 py-2 rounded-full bg-[#1D1D1F] dark:bg-[#F5F5F7] text-white dark:text-black text-xs font-semibold flex items-center gap-2 shadow-lg"
        >
          <Icon name="keyboard" class="w-4 h-4" />
          <span data-i18n="test.focus">Click here and start typing</span>
        </div>
      </div>

      <!-- Caps Lock warning pill -->
      <div
        id="caps-lock-warning"
        class="hidden absolute top-3 left-1/2 -translate-x-1/2 z-10 pointer-events-none"
      >
        <div
