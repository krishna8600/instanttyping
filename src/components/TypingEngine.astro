          Delete my data
        </button>
      </div>
    </div>
    <script>
    (function() {
      const wipeSlot = document.getElementById('results-wipe-slot');
      if (wipeSlot) {
        Promise.all([
          import('../scripts/confirm-morph'),
          import('../scripts/notify'),
          import('../i18n')
        ]).then(([{ createConfirmMorph }, { notify }, { t }]) => {
          function renderWipeMorph() {
            const morph = createConfirmMorph({
              idleLabel: t('privacy.delete_data'),
              confirmText: t('privacy.confirm_prompt'),
              yesLabel: t('privacy.confirm_yes'),
              noLabel: t('privacy.confirm_no'),
              doneLabel: t('privacy.confirm_done'),
              className: 'text-xs',
              onConfirm: () => {
                const keys = [];
                for (let i = 0; i < localStorage.length; i++) {
                  const k = localStorage.key(i);
                  if (k && (k.startsWith('ptt_') || k.startsWith('it_') || k.startsWith('gk'))) keys.push(k);
                }
                keys.forEach(k => localStorage.removeItem(k));
                localStorage.removeItem('it_profile_v1');
                try {
                  window.dispatchEvent(new CustomEvent('it-profile-updated'));
                } catch {}
                notify({ title: t('privacy.deleted_title'), description: t('privacy.deleted_desc'), icon: 'check' });
                setTimeout(() => location.reload(), 600);
              },
            });
            if (wipeSlot) {
              wipeSlot.innerHTML = '';
              wipeSlot.appendChild(morph);
            }
          }
          renderWipeMorph();
          window.addEventListener('instanttyping:languagechange', renderWipeMorph);
        });
      }
    
    // Settings Panel Logic
    const settingsBtn = document.getElementById('settings-toggle-btn');
    const settingsPanel = document.getElementById('settings-panel');
    if (settingsBtn && settingsPanel) {
      settingsBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = settingsPanel.classList.contains('hidden');
        if (isHidden) {
          settingsPanel.classList.remove('hidden');
          settingsPanel.classList.add('flex');
          
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!prefersReduced) {
            settingsPanel.classList.add('animate-spring-enter');
          }
        } else {
          settingsPanel.classList.add('hidden');
          settingsPanel.classList.remove('flex', 'animate-spring-enter');
        }
      });

      document.addEventListener('click', (e) => {
        if (!settingsPanel.classList.contains('hidden') && !settingsPanel.contains(e.target as Node) && e.target !== settingsBtn) {
          settingsPanel.classList.add('hidden');
          settingsPanel.classList.remove('flex', 'animate-spring-enter');
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          settingsPanel.classList.add('hidden');
          settingsPanel.classList.remove('flex', 'animate-spring-enter');
        }
      });
    }
  
})();

// Sync backdrop with settings panel
(function() {
  const panel = document.getElementById('settings-panel');
  const backdrop = document.getElementById('settings-backdrop');
  const toggleBtn = document.getElementById('settings-toggle-btn');
  if (!panel || !backdrop) return;
  function syncBackdrop() {
    const isHidden = panel.classList.contains('hidden');
    backdrop.classList.toggle('hidden', isHidden);
  }
  // Observe panel visibility changes
  new MutationObserver(syncBackdrop).observe(panel, { attributes: true, attributeFilter: ['class'] });
  // Backdrop click closes panel
  backdrop.addEventListener('click', () => {
    panel.classList.add('hidden');
    syncBackdrop();
  });
  // Initial sync
  syncBackdrop();
})();
</script>
</section>

