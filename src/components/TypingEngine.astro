    // Chart Interactivity
    const chartSvg = document.getElementById("timeline-chart-svg");
    const chartTooltip = document.getElementById("chart-tooltip");
    
    if (chartSvg && chartTooltip) {
      function updateCrosshair(e: Event) {
        const pointerEvent = e as PointerEvent;
        const data = (chartSvg as any).__chartData;
        if (!data || data.length < 2) return;
        
        const svgRect = chartSvg!.getBoundingClientRect();
        const rawX = ((pointerEvent.clientX - svgRect.left) / svgRect.width) * 500;
        
        let nearest = data[0];
        let minDist = Infinity;
        for (const pt of data) {
          const dist = Math.abs(pt.x - rawX);
          if (dist < minDist) {
            minDist = dist;
            nearest = pt;
          }
        }
        
        const layer = document.getElementById("chart-interactive-layer");
        const line = document.getElementById("chart-crosshair-line");
        const dot = document.getElementById("chart-crosshair-dot");
        
        if (layer && line && dot) {
          line.setAttribute("x1", nearest.x.toString());
          line.setAttribute("x2", nearest.x.toString());
          dot.setAttribute("cx", nearest.x.toString());
          dot.setAttribute("cy", nearest.y.toString());
          layer.classList.remove("opacity-0");
        }
        
        const card = chartSvg!.closest('.premium-card') as HTMLElement;
        if (!card) return;
        const cardRect = card.getBoundingClientRect();
        const borderX = card.clientLeft || 0;
        const borderY = card.clientTop || 0;
        const domX = (nearest.x / 500) * svgRect.width + (svgRect.left - cardRect.left) - borderX;
        const domY = (nearest.y / 100) * svgRect.height + (svgRect.top - cardRect.top) - borderY;
        
        const avg = (chartSvg as any).__avgWpm;
        const delta = Math.round(nearest.val - avg);
        const deltaStr = (delta >= 0 ? '+' : '') + delta;
        chartTooltip!.textContent = `${Math.round(nearest.val)} WPM · ${nearest.sec}s · ${deltaStr} vs avg`;
        
        // Measure tooltip dimensions
        const tooltipRect = chartTooltip!.getBoundingClientRect();
        const tipW = tooltipRect.width || 120;
        const tipH = tooltipRect.height || 26;
        const cardW = card.clientWidth || (cardRect.width - borderX * 2);
        const cardH = card.clientHeight || (cardRect.height - borderY * 2);

        // Retrieve bounding boxes of peak callout and avg reference labels relative to card
        const peakLabel = document.getElementById("chart-peak-label");
        const avgLabel = document.getElementById("chart-avg-label");

        function getCardRelBox(el: Element | null) {
          if (!el) return null;
          const r = el.getBoundingClientRect();
          if (r.width === 0 && r.height === 0) return null;
          return {
            left: r.left - cardRect.left - borderX,
            right: r.right - cardRect.left - borderX,
            top: r.top - cardRect.top - borderY,
            bottom: r.bottom - cardRect.top - borderY,
          };
        }

        const obstacles = [getCardRelBox(peakLabel), getCardRelBox(avgLabel)].filter(Boolean) as Array<{
          left: number;
          right: number;
          top: number;
          bottom: number;
        }>;

        function checkOverlap(box: { left: number; right: number; top: number; bottom: number }, pad = 4) {
          for (const obs of obstacles) {
            const separated = (
              box.right + pad < obs.left ||
              box.left - pad > obs.right ||
              box.bottom + pad < obs.top ||
              box.top - pad > obs.bottom
            );
            if (!separated) return true;
          }
          return false;
        }

        // Candidate 1: Above cursor (default)
        const aboveLeft = Math.max(4, Math.min(domX - tipW / 2, cardW - tipW - 4));
        const aboveTop = domY - 8 - tipH;
        const aboveBox = { left: aboveLeft, right: aboveLeft + tipW, top: aboveTop, bottom: aboveTop + tipH };

        // Candidate 2: Below cursor (flip vertical)
        const belowLeft = Math.max(4, Math.min(domX - tipW / 2, cardW - tipW - 4));
        const belowTop = domY + 8;
        const belowBox = { left: belowLeft, right: belowLeft + tipW, top: belowTop, bottom: belowTop + tipH };

        // Candidate 3: Shift horizontally left of cursor
        const leftShiftX = domX - 10 - tipW;
        const sideY = Math.max(4, Math.min(domY - tipH / 2, cardH - tipH - 4));
        const leftShiftBox = { left: Math.max(4, leftShiftX), right: Math.max(4, leftShiftX) + tipW, top: sideY, bottom: sideY + tipH };

        // Candidate 4: Shift horizontally right of cursor
        const rightShiftX = domX + 10;
        const rightShiftBox = { left: Math.min(cardW - tipW - 4, rightShiftX), right: Math.min(cardW - tipW - 4, rightShiftX) + tipW, top: sideY, bottom: sideY + tipH };

        let chosenBox = aboveBox;

        if (aboveTop >= 4 && !checkOverlap(aboveBox)) {
          chosenBox = aboveBox;
        } else if (belowTop + tipH <= cardH - 4 && !checkOverlap(belowBox)) {
          chosenBox = belowBox;
        } else if (leftShiftX >= 4 && !checkOverlap(leftShiftBox)) {
          chosenBox = leftShiftBox;
        } else if (rightShiftX + tipW <= cardW - 4 && !checkOverlap(rightShiftBox)) {
          chosenBox = rightShiftBox;
        } else {
          chosenBox = domY < cardH / 2 ? belowBox : aboveBox;
        }

        chartTooltip!.style.left = `${Math.round(chosenBox.left)}px`;
        chartTooltip!.style.top = `${Math.round(chosenBox.top)}px`;
        chartTooltip!.classList.remove("opacity-0");
      }
      
      function hideCrosshair() {
        const layer = document.getElementById("chart-interactive-layer");
        if (layer) layer.classList.add("opacity-0");
        if (chartTooltip) chartTooltip.classList.add("opacity-0");
      }
      
      chartSvg.addEventListener("pointermove", updateCrosshair as EventListener);
      chartSvg.addEventListener("pointerdown", updateCrosshair as EventListener);
      chartSvg.addEventListener("pointerleave", hideCrosshair);
      chartSvg.addEventListener("pointercancel", hideCrosshair);
    }

    // Shareable results: downloadable PNG result card + one-click copy summary (Task 2)
    (function() {
      async function buildShareData(): Promise<import('../scripts/share-card').ShareData> {
        var summary = lastCompletedSummary || (window as any).__lastTestSummary;
        var quote = currentQuoteObj || (window as any).__currentQuoteObj;
        var wpmEl = document.getElementById('res-net-wpm');
        var accEl = document.getElementById('res-accuracy');
        var consEl = document.getElementById('res-consistency');
        var rankEl = document.getElementById('res-rank-title');
        var wpm = summary ? summary.netWpm : (wpmEl ? parseInt(wpmEl.textContent || '0', 10) : 0);
        var acc = summary ? summary.accuracy : (accEl ? parseFloat(accEl.textContent || '100') : 100);
        var consistency = summary ? summary.consistency : (consEl ? parseInt(consEl.textContent || '100', 10) : 100);
        var rank = summary ? summary.rankTitle : (rankEl ? (rankEl.textContent || 'Typist').trim() : 'Typist');
        return {
          wpm: wpm,
          accuracy: acc,
          consistency: consistency,
          rank: rank,
          date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
          quoteAttribution: quote ? `— ${quote.author}, ${quote.source}` : undefined,
        };
      }
