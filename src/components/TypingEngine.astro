              yesLabel: 'Yes, delete',
              noLabel: 'Keep',
              doneLabel: 'Deleted',
              className: 'text-xs',
              onConfirm: () => {
                const keys = [];
                for (let i = 0; i < localStorage.length; i++) {
                  const k = localStorage.key(i);
                  if (k && (k.startsWith('ptt_') || k.startsWith('it_') || k.startsWith('gk'))) keys.push(k);
                }
                keys.forEach(k => localStorage.removeItem(k));
                localStorage.removeItem('it_profile_v1');
                try {
                  window.dispatchEvent(new CustomEvent('it-profile-updated'));
                } catch {}
                notify({ title: 'Data Deleted', description: 'All local typing data has been wiped.', icon: 'check' });
