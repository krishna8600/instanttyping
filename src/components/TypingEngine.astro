          b.classList.remove(
            "font-semibold",
            "!bg-[#1D1D1F]",
            "!text-white",
            "dark:!bg-white",
            "dark:!text-black",
          ),
        );
        btn.classList.add(
          "font-semibold",
          "!bg-[#1D1D1F]",
          "!text-white",
          "dark:!bg-white",
          "dark:!text-black",
        );
        targetWordCount = parseInt(
          (btn as HTMLElement).dataset.wordCountVal || "25",
          10,
