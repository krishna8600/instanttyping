            console.error('Download card failed:', err);
          }
        });
      }

      var copyBtn = document.getElementById('btn-copy-result');
      var copyLabel = document.getElementById('copy-result-label');
      if (copyBtn) {
        copyBtn.addEventListener('click', async function() {
          try {
            var mod = await import('../scripts/share-card');
            var data = await buildShareData();
            var success = await mod.copyShareText(data);
            if (success) {
              notify({
                title: 'Copied to clipboard',
                icon: 'copy',
                duration: 2500,
              });
            }
            if (copyLabel) {
              var originalText = copyLabel.textContent;
              copyLabel.textContent = success ? 'Copied!' : 'Copied!';
              setTimeout(function() {
                if (copyLabel) copyLabel.textContent = originalText;
              }, 2000);
            }
          } catch (err) {
            console.error('Copy result failed:', err);
          }
        });
      }

      var shareBtn = document.getElementById('btn-share-result');
      if (shareBtn) {
