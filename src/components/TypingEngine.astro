    /* ── Hamster Mascot Companion (from scratch) ── */
    (function() {
      var wrap = document.getElementById('mascot-wrap') as HTMLElement | null;
      var vid = document.getElementById('mascot') as HTMLVideoElement | null;
      var fallbackImg = document.getElementById('mascot-fallback') as HTMLImageElement | null;
      if (!wrap || !vid) return;


      var MOODS = ['m-idle','m-typing','m-tap','m-shock','m-slow','m-roast'];
      var current = 'm-idle';
      var moodTimer: ReturnType<typeof setTimeout> | null = null;
      var idleTimer: ReturnType<typeof setTimeout> | null = null;
      var enabled = true;
      var useFallback = false;
      try { if (localStorage.getItem('it_mascot') === 'off') enabled = false; } catch(e) {}
      var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // If video fails, swap to fallback image
      vid.addEventListener('error', function() {
        useFallback = true;
        vid!.classList.add('hidden');
        if (fallbackImg) {
          fallbackImg.classList.remove('hidden');
          // Copy mood classes to fallback
          for (var i = 0; i < MOODS.length; i++) fallbackImg.classList.remove(MOODS[i]);
          fallbackImg.classList.add(current);
        }
      });

      function apply() {
        if (!enabled || reduceMotion) { wrap!.classList.add('mascot-hidden'); return; }
        wrap!.classList.remove('mascot-hidden');
      }


      function setMood(m: string, revertMs?: number) {
        if (!enabled || reduceMotion) return;
        var el = useFallback ? fallbackImg : vid;
        if (!el) return;
        // video mascot: per-mood videos, fallback to img
        var vid2 = document.getElementById('mascot-video') as HTMLVideoElement;
        var moodVideos: Record<string,string> = {
          'm-typing': '/videos/mascot-typing.mp4',
          'm-shock': '/videos/mascot-shock.mp4',
          'm-slow': '/videos/mascot-sleepy.mp4',
  'm-idle': '/videos/mascot-sleepy.mp4',
          'm-roast': '/videos/mascot-roast.mp4',
        };
        if (vid2) {
          var vSrc = moodVideos[m];
          if (vSrc) {
            if (vid2.getAttribute('src') !== vSrc) vid2.src = vSrc;
            el.style.display = 'none';
            vid2.style.display = 'block';
            vid2.play().catch(function(){});
          } else {
            vid2.pause();
            vid2.style.display = 'none';
            el.style.display = '';
          }
        }
        current = m;
        for (var i = 0; i < MOODS.length; i++) el.classList.remove(MOODS[i]);
        el.classList.add(m);
        if (moodTimer) { clearTimeout(moodTimer); moodTimer = null; }
        if (revertMs) moodTimer = setTimeout(function(){ setMood('m-idle'); }, revertMs);
      }

      function tap() {
        if (!enabled || reduceMotion) return;
        if (current !== 'm-typing') setMood('m-typing');
        if (idleTimer) clearTimeout(idleTimer);
        idleTimer = setTimeout(function(){ if (current === 'm-typing') setMood('m-idle'); }, 1600);
        var el = useFallback ? fallbackImg : vid;
        if (!el) return;
        el.classList.remove('m-tap');
        void el.offsetWidth;
        el.classList.add('m-tap');
      }

      window.addEventListener('typing-key-result', function(e: Event) {
        var d = ((e as CustomEvent) && (e as CustomEvent).detail) || {};
        if (d.correct === false) setMood('m-shock', 1200);
        else tap();
      });
      // Fallback: direct keydown listener (in case typing events don't fire)
      document.addEventListener('keydown', function(e) {
        if (e.key && e.key.length === 1) tap();
      });
      window.addEventListener('typing-start', function(){ setMood('m-typing'); });
      window.addEventListener('typing-stop', function(){
        var roastCard = document.getElementById('roast-card');
        if (roastCard && !roastCard.classList.contains('hidden')) setMood('m-roast', 3000);
        else setMood('m-idle');
      });
      window.addEventListener('typing-reset', function(){ setMood('m-idle'); });

      // Settings toggle
      var mascotSelect = document.getElementById('mascot-mode-select') as HTMLSelectElement | null;
      if (mascotSelect) {
        try { mascotSelect.value = enabled ? 'on' : 'off'; } catch(e) {}
        mascotSelect.addEventListener('change', function() {
          var on = mascotSelect!.value !== 'off';
          window.dispatchEvent(new CustomEvent('mascot-toggle', { detail: { enabled: on } }));
        });
      }
      window.addEventListener('mascot-toggle', function(e: Event) {
        var ce = e as CustomEvent;
        enabled = !ce || !ce.detail || ce.detail.enabled !== false;
        try { localStorage.setItem('it_mascot', enabled ? 'on' : 'off'); } catch(e2) {}
        apply();
        if (enabled) setMood('m-idle');
      });

      apply();
    })();
</script>

















