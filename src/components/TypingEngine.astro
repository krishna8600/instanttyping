        } else if (drillKeys.length > 0) {
          coachDrillLabel.textContent = `Drill Problem Keys (${drillKeys.slice(0, 3).join(", ").toUpperCase()})`;
          coachDrillBtn.onclick = () => {
            const corpus = getSelectedCorpus();
