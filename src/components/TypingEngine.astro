<!-- Achievement Toast Container -->
<div id="achievement-toast-container" class="fixed bottom-6 right-6 z-[300] flex flex-col gap-2 pointer-events-none" aria-live="polite"></div>

<script>
  if ((window as any).__typingEngineCleanup) {
    (window as any).__typingEngineCleanup();
  }
  const __activeTimeouts: number[] = [];
  const safeSetTimeout = (cb: TimerHandler, ms?: number) => {
    const id = setTimeout(cb, ms) as any;
    __activeTimeouts.push(id);
    return id;
  };
  import { animate } from "animejs";
  import { getLanguage, updateDOM, t, loadLanguage, type SupportedLanguage } from "../i18n";
  import { recordTest, getLevel, getDailyProgress, loadProgress } from "../scripts/progress";
  import { updateProfileAfterTest, getXpProgressForLevel, getDailyQuote } from "../scripts/profile";
  import type { ProfileUpdateResult } from "../scripts/profile";
  import { notify } from "../scripts/notify";
  import { createDock } from "../scripts/dock";
  import { createCopyButton } from "../scripts/copy-button";
  import { countUp } from "../scripts/count-up";
  import {
    TOP_200_WORDS,
    TOP_1000_WORDS,
    NUMBERS_PUNCTUATION_WORDS,
    BEGINNER_WORDS,
    ADVANCED_WORDS,
    type WordPoolTier,
    FAMOUS_QUOTES,
    QUOTES_BANK,
    CLASSIC_PASSAGES,
    CODE_SNIPPETS,
    SPANISH_WORDS,
    FRENCH_WORDS,
    GERMAN_WORDS,
    PORTUGUESE_WORDS,
    ITALIAN_WORDS,
    getRandomWords,
  } from "../data/wordbanks";
  import {
    THEME_ANIMALS_WORDS,
    THEME_FRUITS_WORDS,
    THEME_VEGETABLES_WORDS,
    THEME_COLORS_WORDS,
    THEME_FLOWERS_WORDS,
    THEME_SPORTS_WORDS,
    THEME_INSTRUMENTS_WORDS,
    THEME_CLOTHING_WORDS,
    THEME_HOUSEHOLD_WORDS,
    THEME_BODY_WORDS,
  } from "../data/themed-packs";
  import type { TypingEventMap } from "../scripts/typing-events";
  import {
    calculateMetrics,
    calculateInstantaneousWpm,
    saveTestResult,
    getPersonalBest,
    getRecommendedTier,
    type MetricSummary,
  } from "../utils/metrics";
  import { 
    playKeyStrokeSound, 
    ensureAudioContext, 
    setSoundTheme, 
    initSoundThemeFromStorage,
    getVolume,
    setVolume,
    toggleAudio,
    isAudioEnabled
  } from "../utils/audio";

  export interface CompletedTestSummary extends MetricSummary {
    missedWords: string[];
    keyMistakes: Record<string, { errors: number; total: number }>;
    keystrokeLog: Array<{
      char: string;
      expectedChar: string;
      isCorrect: boolean;
      timestamp: number;
      deltaMs: number;
      prevChar: string;
    }>;
    perSecondInstantWpm: number[];
    secondBySecondWpm: number[];
  }

  // Script-scoped test summary so results screen, coaching card, and share handlers share identical data
  let lastCompletedSummary: CompletedTestSummary | null = null;
  (window as any).__lastTestSummary = null;
  let currentQuoteObj: { id?: string; text: string; author?: string; source: string } | null = null;
  (window as any).__currentQuoteObj = null;

  const container = document.getElementById("typing-test-container");
  if (container) {
    const initialDurationAttr = parseInt(
      container.dataset.initialDuration || "60",
      10,
    );
    const initialModeAttr = (container.dataset.initialMode || "time") as
      "time" | "words" | "quote" | "custom" | "classics";
    const initialWordbankAttr = container.dataset.initialWordbank || "top1000";
    const initialTierAttr = (container.dataset.initialTier || (initialWordbankAttr === "beginner" ? "beginner" : "auto")) as "auto" | WordPoolTier;
    let savedTier: string | null = null;
    try {
      savedTier = localStorage.getItem("it_tier");
    } catch {}
    let currentTier: "auto" | WordPoolTier = (initialTierAttr !== "auto" ? initialTierAttr : (savedTier as any) || "auto");
    let currentMode: "time" | "words" | "quote" | "custom" | "classics" | "code" = initialModeAttr;
    currentQuoteObj = null;
    (window as any).__currentQuoteObj = null;
    let isDailyQuoteActive = false;

    function getNextQuoteFromCycle(): any {
      let seen: string[] = [];
      try {
        const raw = localStorage.getItem('it_quotes_seen');
        if (raw) seen = JSON.parse(raw);
        if (!Array.isArray(seen)) seen = [];
      } catch {}

      let available = QUOTES_BANK.filter(q => !q.id || !seen.includes(q.id));
      if (available.length === 0) {
        seen = [];
        available = QUOTES_BANK;
      }

      const chosen = available[Math.floor(Math.random() * available.length)];
      if (chosen.id) {
        seen.push(chosen.id);
        try {
          localStorage.setItem('it_quotes_seen', JSON.stringify(seen));
        } catch {}
      }
      return chosen;
    }
    let targetDuration = initialDurationAttr;
    let targetWordCount = 25;
    let currentWordbankName = initialWordbankAttr;
    let testActive = false;
    let testCompleted = false;

    // Timing via performance.now() and requestAnimationFrame
    let startTime = 0;
    let animationFrameId: number | null = null;
    let lastStatUpdate = 0;
    let elapsedSeconds = 0;

    // Idle pause: pause the test after 10s of no typing
    let lastKeystrokeTime = 0;
    let lastCharInputTime = 0;
    let isIdlePaused = false;
    let idlePausedAt = 0;
    const IDLE_PAUSE_MS = 10000;

    // Typing Data
    let wordsList: string[] = [];
    let currentWordIndex = 0;
    let currentInput = "";
    let correctKeystrokes = 0;
    let incorrectKeystrokes = 0;
    let secondBySecondWpm: number[] = [];
    let perSecondInstantWpm: number[] = [];
    let lastSecondRecorded = 0;
    let lastSecondCorrectChars = 0;
    let missedWords: string[] = [];
    let keyMistakes: Record<string, { errors: number; total: number }> = {};
    let keystrokeLog: Array<{
      char: string;
      expectedChar: string;
      isCorrect: boolean;
      timestamp: number;
      deltaMs: number;
      prevChar: string;
    }> = [];
    let customMistakeWords: string[] | null = null;
    let selectedBackspaceMode: "full" | "current" = "full";
    try {
      const savedBackspaceMode = localStorage.getItem("ptt_backspace_mode");
      if (savedBackspaceMode === "current" || savedBackspaceMode === "full") {
        selectedBackspaceMode = savedBackspaceMode;
      }
    } catch {}
    let activeBackspaceMode: "full" | "current" = selectedBackspaceMode;

    let selectedStopOnError: "on" | "off" = "off";
    try {
      const savedStopOnError = localStorage.getItem("it_stop_on_error");
      if (savedStopOnError === "on" || savedStopOnError === "off") {
        selectedStopOnError = savedStopOnError;
      }
    } catch {}

    let roastModeEnabled = true;
    try {
      const savedRoastMode = localStorage.getItem("it_roast_mode");
      if (savedRoastMode === "off") {
        roastModeEnabled = false;
      }
    } catch {}

    const testContainer = document.getElementById("typing-test-container");
    const wordsViewport = document.getElementById("words-viewport")!;
    const wordsWrapper = document.getElementById("words-wrapper")!;
    const typingDisplay = document.getElementById("typing-display")!;
    const caretEl = (document.getElementById("typing-caret") || document.createElement("div")) as HTMLElement;

    // Optimized layout cache & nodes
    let cachedWordNodes: HTMLElement[] = [];
    let cachedCharNodes: HTMLElement[][] = [];
    let extraCharNodes: HTMLElement[][] = [];
    let wordOffsets: { x: number; y: number }[] = [];
    let wordInputs: string[] = [];
    let charWidth = 14.4;
    let lineHeight = 48;
    let caretYOffset = 15;
    let cachedViewportWidth = 900;
    let trackTotalWidth = 0;
    let targetScrollX = 0;
    const typingSurfaceWrapper = document.getElementById(
      "typing-surface-wrapper",
    )!;
    const metricsStrip = document.getElementById("metrics-strip")!;
    const actionBar = document.getElementById("action-bar")!;
    const hiddenInput = document.getElementById(
      "hidden-typing-input",
    ) as HTMLInputElement;
    const focusPrompt = document.getElementById("focus-prompt")!;
    const capsLockWarning = document.getElementById("caps-lock-warning")!;
    let isCapsLockActive: boolean | null = null;
    const idlePausePrompt = document.getElementById("idle-pause-prompt")!;
    const timerMetric = document.getElementById("metric-timer")!;
    const wpmMetric = document.getElementById("metric-wpm")!;
    const accMetric = document.getElementById("metric-accuracy")!;
    const errMetric = document.getElementById("metric-errors")!;
    const restartBtn = document.getElementById("btn-restart-test")!;
    const quoteCitation = document.getElementById("quote-citation")!;
    const wordbankSelect = document.getElementById(
      "wordbank-select",
    ) as HTMLSelectElement;
    const tierSelect = document.getElementById(
      "tier-select",
    ) as HTMLSelectElement | null;
    const tierSelectContainer = document.getElementById(
      "tier-select-container",
    ) as HTMLElement | null;
    if (tierSelect) {
      tierSelect.value = currentTier;
    }
    const themeSelect = document.getElementById(
      "theme-select",
    ) as HTMLSelectElement;
    const soundSelect = document.getElementById(
      "sound-select",
    ) as HTMLSelectElement;
    const backspaceSelect = document.getElementById(
      "backspace-select",
    ) as HTMLSelectElement | null;
    const stopOnErrorSelect = document.getElementById(
      "stop-on-error-select",
    ) as HTMLSelectElement | null;
    const roastModeSelect = document.getElementById(
      "roast-mode-select",
    ) as HTMLSelectElement | null;
    const volumeSlider = document.getElementById(
      "engine-volume-slider",
    ) as HTMLInputElement | null;
    const customTextContainer = document.getElementById(
      "custom-text-container",
    )!;
    const customTextInput = document.getElementById(
      "custom-text-input",
    ) as HTMLTextAreaElement;
    const btnStartCustom = document.getElementById("btn-start-custom")!;

    // Options elements
    const timeOptions = document.getElementById("time-options")!;
    const wordsOptions = document.getElementById("words-options")!;
    const modeBtns = document.querySelectorAll(".mode-tab-btn");
    const timeBtns = document.querySelectorAll(".time-btn");
    const wordCountBtns = document.querySelectorAll(".word-count-btn");

    // Results elements
    const resultsPanel = document.getElementById("results-panel")!;
    const btnModalRestart = document.getElementById("btn-modal-restart")!;
    const btnNextTest = document.getElementById("btn-next-test")!;
    const btnTrainMistakes = document.getElementById("btn-train-mistakes")!;
    const btnOpenCert = document.getElementById("btn-open-certificate")!;
    const certModal = document.getElementById("certificate-modal")!;
    const btnCloseCert = document.getElementById("btn-close-certificate")!;
    const btnDownloadCert = document.getElementById("btn-download-cert")!;
    const certCanvas = document.getElementById(
      "cert-canvas",
    ) as HTMLCanvasElement;
    const personalBestBanner = document.getElementById("personal-best-banner")!;
    const personalBestLabel = document.getElementById("personal-best-label")!;
    
    // Roast Elements
    const roastCard = document.getElementById("roast-card");
    const roastVideo = document.getElementById("roast-video") as HTMLVideoElement | null;
    const roastImg = document.getElementById("roast-img") as HTMLImageElement | null;
    const roastText = document.getElementById("roast-text");
    // Currently displayed roast key (e.g. "roast.good_7"), so a language
    // switch on the results page can re-translate it without a new test.
    let currentRoastKey: string | null = null;
    // Re-translate the visible roast when the language is switched on the
    // results page (updateDOM only handles data-i18n elements).
    window.addEventListener("instanttyping:languagechange", (e) => {
      if (!currentRoastKey || !roastCard || !roastText) return;
      if (roastCard.classList.contains("hidden")) return;
      const newLang = (e as CustomEvent).detail?.language || getLanguage();
      try {
        const line = t(currentRoastKey, newLang);
        if (line && line !== currentRoastKey) {
          roastText.textContent = "\u201C" + line + "\u201D";
        }
      } catch {}
    });

    let lastProfileResult: ProfileUpdateResult | null = null;

    function emitTyping<K extends keyof TypingEventMap>(
      name: K,
      detail?: TypingEventMap[K] extends CustomEvent<infer D> ? D : never
    ) {
      window.dispatchEvent(new CustomEvent(name, { detail }));
    }

    function getActiveTier(): WordPoolTier {
      if (currentTier === "auto") {
        return getRecommendedTier();
      }
      return currentTier;
    }

    function updateTierControlAvailability() {
      if (!tierSelect || !tierSelectContainer) return;
      const isNonTiered = ["es", "fr", "de", "pt", "it", "numbers"].includes(currentWordbankName) || 
                          currentWordbankName.startsWith("theme-") ||
                          ["quote", "classics", "code", "custom"].includes(currentMode);
      if (isNonTiered) {
        tierSelect.disabled = true;
        tierSelectContainer.classList.add("opacity-40", "pointer-events-none");
      } else {
        tierSelect.disabled = false;
        tierSelectContainer.classList.remove("opacity-40", "pointer-events-none");
      }
    }

    function getSelectedCorpus(): string[] {
      if (customMistakeWords && customMistakeWords.length > 0) {
        return customMistakeWords;
      }
      switch (currentWordbankName) {
        case "theme-animals":
          return THEME_ANIMALS_WORDS;
        case "theme-fruits":
          return THEME_FRUITS_WORDS;
        case "theme-vegetables":
          return THEME_VEGETABLES_WORDS;
        case "theme-colors":
          return THEME_COLORS_WORDS;
        case "theme-flowers":
          return THEME_FLOWERS_WORDS;
        case "theme-sports":
          return THEME_SPORTS_WORDS;
        case "theme-instruments":
          return THEME_INSTRUMENTS_WORDS;
        case "theme-clothing":
          return THEME_CLOTHING_WORDS;
        case "theme-household":
          return THEME_HOUSEHOLD_WORDS;
        case "theme-body":
          return THEME_BODY_WORDS;
        case "numbers":
          return NUMBERS_PUNCTUATION_WORDS;
        case "beginner":
          return BEGINNER_WORDS;
        case "es":
          return SPANISH_WORDS;
        case "fr":
          return FRENCH_WORDS;
        case "de":
          return GERMAN_WORDS;
        case "pt":
          return PORTUGUESE_WORDS;
        case "it":
          return ITALIAN_WORDS;
        default: {
          const currentLang = getLanguage();
          if (currentLang === "es") return SPANISH_WORDS;
          if (currentLang === "fr") return FRENCH_WORDS;
          if (currentLang === "de") return GERMAN_WORDS;
          if (currentLang === "pt") return PORTUGUESE_WORDS;
          if (currentLang === "it") return ITALIAN_WORDS;

          // Standard English: apply difficulty tier (Auto, Beginner, Intermediate, Advanced)
          const activeTier = getActiveTier();
          if (activeTier === "beginner") {
            return BEGINNER_WORDS;
          }
          if (activeTier === "advanced") {
            return ADVANCED_WORDS;
          }
          return currentWordbankName === "top1000" ? TOP_1000_WORDS : TOP_200_WORDS;
        }
      }
    }

    function generateWords() {
      wordsList = [];
      quoteCitation.classList.add("hidden");

      if (customMistakeWords && customMistakeWords.length > 0) {
        while (wordsList.length < 50) {
          wordsList.push(...customMistakeWords);
        }
        wordsList = wordsList.slice(0, 50);
      } else if (currentMode === "custom") {
        const text = customTextInput.value.trim();
        if (text) {
          wordsList = text.split(/\s+/);
        } else {
          wordsList = [
            "Please",
            "enter",
            "some",
            "custom",
            "text",
            "to",
            "start",
            "the",
            "test.",
          ];
        }
      } else if (currentMode === "classics" || currentWordbankName === "classics") {
        const passageObj =
          CLASSIC_PASSAGES[Math.floor(Math.random() * CLASSIC_PASSAGES.length)];
        wordsList = passageObj.text.split(" ");
        quoteCitation.textContent = "— " + passageObj.source + " · Public domain";
        quoteCitation.classList.remove("hidden");
      } else if (currentMode === "quote" || currentWordbankName === "quote") {
        let quoteObj: any;
        if (isDailyQuoteActive) {
          quoteObj = getDailyQuote(QUOTES_BANK, new Date());
        } else {
          quoteObj = getNextQuoteFromCycle();
        }
        currentQuoteObj = quoteObj;
        (window as any).__currentQuoteObj = quoteObj;
        wordsList = quoteObj.text.trim().split(/\s+/);
        quoteCitation.textContent = `— ${quoteObj.author}, ${quoteObj.source}`;
        quoteCitation.classList.remove("hidden");
      } else if (currentMode === "code" || currentWordbankName === "code") {
        const snippetObj =
          CODE_SNIPPETS[Math.floor(Math.random() * CODE_SNIPPETS.length)];
        wordsList = snippetObj.text.split(" ");
        quoteCitation.textContent = `</> ${snippetObj.source}`;
        quoteCitation.classList.remove("hidden");
      } else if (currentMode === "words") {
        wordsList = getRandomWords(targetWordCount, getSelectedCorpus());
      } else {
        wordsList = getRandomWords(150, getSelectedCorpus());
      }

      currentWordIndex = 0;
      currentInput = "";
      renderWords();
    }

    function measureLayout() {
      // Robust multi-character pitch measurement (absorbs font glyph width, letter-spacing, and subpixel rendering)
      if (cachedCharNodes.length > 0 && cachedCharNodes[0].length >= 2) {
        const c0 = cachedCharNodes[0][0];
        const cLast = cachedCharNodes[0][cachedCharNodes[0].length - 1];
        const r0 = c0.getBoundingClientRect();
        const rLast = cLast.getBoundingClientRect();
        if (rLast.left > r0.left && cachedCharNodes[0].length > 1) {
          charWidth = (rLast.left - r0.left) / (cachedCharNodes[0].length - 1);
        } else if (r0.width > 0) {
          charWidth = r0.width;
        }
      } else if (cachedCharNodes.length > 0 && cachedCharNodes[0].length > 0) {
        const firstChar = cachedCharNodes[0][0];
        const rect = firstChar.getBoundingClientRect();
        if (rect.width > 0) {
          charWidth = rect.width;
        }
      }

      // Measure caret height once during layout setup to vertically center cleanly on cap-height
      let caretH = 18;
      if (caretEl) {
        const cRect = caretEl.getBoundingClientRect();
        if (cRect.height > 0) {
          caretH = cRect.height;
        }
      }

      wordOffsets = [];
      for (let i = 0; i < cachedWordNodes.length; i++) {
        const el = cachedWordNodes[i];
        const x = el.offsetLeft;
        wordOffsets.push({ x, y: 0 });
      }

      if (cachedWordNodes.length > 0) {
        const lastEl = cachedWordNodes[cachedWordNodes.length - 1];
        trackTotalWidth = lastEl.offsetLeft + lastEl.offsetWidth;
      } else {
        trackTotalWidth = 0;
      }

      const wordH = cachedWordNodes[0]?.offsetHeight || 44;
      lineHeight = wordH;
      caretYOffset = Math.max(0, Math.round((wordH - caretH) / 2));

      if (wordsViewport) {
        cachedViewportWidth = wordsViewport.clientWidth || 900;
        wordsViewport.style.height = `${wordH}px`;
      }
    }

    let isWordOffsetsCacheStale = false;

    function invalidateWordOffsets() {
      isWordOffsetsCacheStale = true;
    }

    function updateWordOffsets(fromIndex: number = 0) {
      const start = Math.max(0, fromIndex);
      for (let i = start; i < cachedWordNodes.length; i++) {
        const el = cachedWordNodes[i];
        if (!el) continue;
        const x = el.offsetLeft;
        if (i < wordOffsets.length) {
          wordOffsets[i].x = x;
          wordOffsets[i].y = 0;
        } else {
          wordOffsets.push({ x, y: 0 });
        }
      }

      if (cachedWordNodes.length > 0) {
        const lastEl = cachedWordNodes[cachedWordNodes.length - 1];
        trackTotalWidth = lastEl.offsetLeft + lastEl.offsetWidth;
      }
    }

    let transformRafId: number | null = null;
    let appliedScrollX = -1;
    let targetCaretX = 0;
    let targetCaretY = 0;

    let pendingKeystrokeEffects: (() => void)[] = [];
    let keystrokeRafId: number | null = null;
    function scheduleKeystrokeEffect(fn: () => void) {
      pendingKeystrokeEffects.push(fn);
      if (!keystrokeRafId) {
        keystrokeRafId = requestAnimationFrame(() => {
          keystrokeRafId = null;
          const batch = pendingKeystrokeEffects;
          pendingKeystrokeEffects = [];
          for (let i = 0; i < batch.length; i++) {
            batch[i]();
          }
        });
      }
    }

    let cachedPrefersReduced = typeof window !== "undefined" && window.matchMedia ? window.matchMedia('(prefers-reduced-motion: reduce)').matches : false;
    if (typeof window !== "undefined" && window.matchMedia) {
      window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener?.('change', (e) => {
        cachedPrefersReduced = e.matches;
      });
    }

    let scrollTransitionTimeout: number | undefined;
    function applyTransforms() {
      transformRafId = null;
      if (appliedScrollX === targetScrollX) return;
      appliedScrollX = targetScrollX;
      if (cachedPrefersReduced) {
        wordsWrapper.style.transition = 'none';
      } else {
        wordsWrapper.style.transition = 'transform 150ms ease-out';
        if (scrollTransitionTimeout) clearTimeout(scrollTransitionTimeout);
        scrollTransitionTimeout = window.setTimeout(() => {
          wordsWrapper.style.transition = 'none';
          scrollTransitionTimeout = undefined;
        }, 160);
        wordsWrapper.addEventListener(
          'transitionend',
          (e) => {
            if (e.target === wordsWrapper && e.propertyName === 'transform') {
              wordsWrapper.style.transition = 'none';
              if (scrollTransitionTimeout) {
                clearTimeout(scrollTransitionTimeout);
                scrollTransitionTimeout = undefined;
              }
            }
          },
          { once: true }
        );
      }
      wordsWrapper.style.transform = `translate3d(-${targetScrollX}px, 0, 0)`;
      if (wordsViewport) {
        wordsViewport.classList.toggle('has-scroll-left', targetScrollX > 0);
      }
    }

    function updateCaretPosition() {
      if (isWordOffsetsCacheStale) {
        measureLayout();
        isWordOffsetsCacheStale = false;
      }

      const wOffset = wordOffsets[currentWordIndex];
      if (!wOffset) return;

      // Fast path: use cached math instead of DOM measurements.
      // Zero getBoundingClientRect() in the hot path.
      const charX = wOffset.x + currentInput.length * charWidth - 1.25;

      // Current caret position relative to the visible strip
      const caretX = charX - targetScrollX;

      const thresholdX = cachedViewportWidth * 0.70;
      const resetX = cachedViewportWidth * 0.25;
      const maxScrollX = Math.max(0, trackTotalWidth - cachedViewportWidth + 48);

      if (caretX > thresholdX) {
        // Shift once when caret exceeds 70% of strip width: one quick hop (~150ms ease-out)
        targetScrollX = Math.min(Math.max(0, charX - resetX), maxScrollX);
      } else if (caretX < resetX && targetScrollX > 0) {
        // Backspace guard: if caretX falls below resetX, shift back so caret never leaves the strip
        targetScrollX = Math.max(0, charX - resetX);
      }

      // Caret walks: caretX = charX - scrollX
      targetCaretX = Math.max(0, charX - targetScrollX);
      targetCaretY = caretYOffset;

      if ((window as any).__smoothCaretTo) {
        (window as any).__smoothCaretTo(targetCaretX, targetCaretY);
      } else {
        caretEl.style.transform = `translate3d(${targetCaretX}px, ${targetCaretY}px, 0)`;
      }

      if (appliedScrollX !== targetScrollX && !transformRafId) {
        transformRafId = requestAnimationFrame(applyTransforms);
      }
    }

    function appendMoreWords(count: number) {
      const newWords = getRandomWords(count, getSelectedCorpus());
      const startIdx = wordsList.length;
      wordsList.push(...newWords);

      const fragment = document.createDocumentFragment();
      for (let i = 0; i < newWords.length; i++) {
        const wIdx = startIdx + i;
        const word = newWords[i];
        const wordEl = document.createElement("span");
        wordEl.className = "word inline-flex items-center transition-opacity shrink-0";
        wordEl.dataset.wordIndex = String(wIdx);

        const charSpans: HTMLElement[] = [];
        const wordChars = Array.from(word);
        for (let cIdx = 0; cIdx < wordChars.length; cIdx++) {
          const charEl = document.createElement("span");
          charEl.className = "char char-untyped";
          charEl.textContent = wordChars[cIdx];
          wordEl.appendChild(charEl);
          charSpans.push(charEl);
        }

        fragment.appendChild(wordEl);
        cachedWordNodes.push(wordEl);
        cachedCharNodes.push(charSpans);
        extraCharNodes.push([]);
        wordInputs.push("");
      }

      wordsWrapper.appendChild(fragment);

      for (let i = startIdx; i < cachedWordNodes.length; i++) {
        const el = cachedWordNodes[i];
        wordOffsets.push({ x: el.offsetLeft, y: 0 });
      }
      if (cachedWordNodes.length > 0) {
        const lastEl = cachedWordNodes[cachedWordNodes.length - 1];
        trackTotalWidth = lastEl.offsetLeft + lastEl.offsetWidth;
      }
    }

    function renderWords() {
      wordsWrapper.innerHTML = "";
      wordsWrapper.style.transform = "translate3d(0, 0, 0)";
      if (wordsViewport) {
        wordsViewport.classList.remove("has-scroll-left");
        if (caretEl.parentElement !== wordsViewport) {
          wordsViewport.appendChild(caretEl);
        }
      }

      cachedWordNodes = [];
      cachedCharNodes = [];
      extraCharNodes = [];
      wordOffsets = [];
      wordInputs = [];

      const fragment = document.createDocumentFragment();

      for (let wIdx = 0; wIdx < wordsList.length; wIdx++) {
        const word = wordsList[wIdx];
        const wordEl = document.createElement("span");
        const isActive = wIdx === currentWordIndex;
        wordEl.className = `word inline-flex items-center transition-opacity shrink-0 ${isActive ? "active-word" : ""}`;
        wordEl.dataset.wordIndex = String(wIdx);

        const charSpans: HTMLElement[] = [];
        const wordChars = Array.from(word);
        for (let cIdx = 0; cIdx < wordChars.length; cIdx++) {
          const charEl = document.createElement("span");
          charEl.className = "char char-untyped";
          charEl.textContent = wordChars[cIdx];
          wordEl.appendChild(charEl);
          charSpans.push(charEl);
        }

        fragment.appendChild(wordEl);
        cachedWordNodes.push(wordEl);
        cachedCharNodes.push(charSpans);
        extraCharNodes.push([]);
        wordInputs.push("");
      }

      wordsWrapper.appendChild(fragment);

      measureLayout();
      isWordOffsetsCacheStale = false;
      targetScrollX = 0;
      updateCaretPosition();
    }

    function dispatchNextChar() {
      if (testCompleted || wordsList.length === 0 || currentWordIndex >= wordsList.length) {
        emitTyping('typing-next-char', { char: null });
        return;
      }
      const targetWord = wordsList[currentWordIndex] || "";
      const charIdx = currentInput.length;
      let nextChar = "";
      if (charIdx < targetWord.length) {
        nextChar = targetWord[charIdx];
      } else {
        nextChar = " ";
      }
      emitTyping('typing-next-char', { char: nextChar });
    }

    function resetTest(userInitiated: boolean = false) {
      const wasActiveOrCompleted = testActive || testCompleted;
      if (testActive) {
        emitTyping('typing-stop');
      }
      emitTyping('typing-reset');

      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      if (transformRafId) {
        cancelAnimationFrame(transformRafId);
        transformRafId = null;
      }
      if (keystrokeRafId) {
        cancelAnimationFrame(keystrokeRafId);
        keystrokeRafId = null;
      }
      pendingKeystrokeEffects = [];
      appliedScrollX = 0;
      testActive = false;
      testCompleted = false;
      if (testContainer) {
        testContainer.classList.remove("engine-running");
      }
      document.body.classList.remove("engine-running");
      startTime = 0;
      elapsedSeconds = 0;
      isIdlePaused = false;
      idlePausedAt = 0;
      lastKeystrokeTime = 0;
      lastCharInputTime = 0;
      idlePausePrompt.classList.add("hidden");
      capsLockWarning.classList.add("hidden");
      typingDisplay.classList.remove("!border-[#FF9F0A]/60", "!shadow-[0_0_0_3px_rgba(255,159,10,0.15)]");
      isCapsLockActive = false;
      correctKeystrokes = 0;
      incorrectKeystrokes = 0;
      secondBySecondWpm = [];
      perSecondInstantWpm = [];
      lastSecondRecorded = 0;
      lastSecondCorrectChars = 0;
      missedWords = [];
      keyMistakes = {};
      keystrokeLog = [];

      // Restore flow layout: show passage, hide results, ensure tooltip visible
      typingSurfaceWrapper.classList.remove("hidden");
      // metrics and action bar stay visible during test; results hidden
      metricsStrip.classList.remove("hidden");
      actionBar.classList.remove("hidden");
      
      resultsPanel.classList.add("hidden");
      focusPrompt.classList.remove("hidden");
      focusPrompt.classList.remove("opacity-0", "pointer-events-none");
      focusPrompt.style.display = "";

      hiddenInput.value = "";
      timerMetric.textContent =
        currentMode === "time"
          ? `${targetDuration}s`
          : currentMode === "words"
            ? `${targetWordCount}`
            : currentMode === "custom"
              ? `${wordsList.length}`
              : "0s";
      wpmMetric.textContent = "0";
      accMetric.textContent = "100%";
      errMetric.textContent = "0";
      lastStatUpdate = 0;

      certModal.classList.add("hidden");
      activeBackspaceMode = selectedBackspaceMode;
      // Item 10 & 3: Reset caret, scroll, and word inputs
      caretEl.style.display = "";
      caretEl.style.opacity = "0";
      caretEl.classList.remove("caret-idle-blink");
      targetScrollX = 0;
      wordsWrapper.style.transition = "none";
      wordsWrapper.style.transform = "translate3d(0, 0, 0)";
      if (currentMode !== "quote" && currentWordbankName !== "quote") {
        currentQuoteObj = null;
        (window as any).__currentQuoteObj = null;
      }
      const resQuoteAttrEl = document.getElementById("res-quote-attribution");
      if (resQuoteAttrEl) resQuoteAttrEl.classList.add("hidden");
      wordInputs = [];
      updateTierControlAvailability();
      generateWords();

      // Scroll passage into view only if explicitly user-initiated or test was in progress
      if (userInitiated || wasActiveOrCompleted) {
        const surfaceRect = typingSurfaceWrapper.getBoundingClientRect();
        if (surfaceRect.top < 0 || surfaceRect.bottom > window.innerHeight) {
          typingSurfaceWrapper.scrollIntoView({
            behavior: "smooth",
            block: "nearest",
          });
        }
      }

      if (testActive || testCompleted) {
        focusTyping();
      } else {
        blurTyping();
      }

      dispatchNextChar();
    }

    function startTest() {
      ensureAudioContext();
      emitTyping('typing-start');
      testActive = true;
      testCompleted = false;
      // Typing started: caret goes solid (remove idle blink)
      if (typeof caretEl !== "undefined" && caretEl) {
        caretEl.classList.remove("caret-idle-blink");
      }
      if (testContainer) {
        testContainer.classList.add("engine-running");
      }
      document.body.classList.add("engine-running");
      startTime = performance.now();
      lastKeystrokeTime = performance.now();
      lastCharInputTime = performance.now();
      isIdlePaused = false;
      idlePausePrompt.classList.add("hidden");
      lastSecondRecorded = 0;
      lastSecondCorrectChars = 0;
      perSecondInstantWpm = [];
      secondBySecondWpm = [];
      runTimerLoop();
    }

    function pauseForIdle() {
      if (!testActive || testCompleted || isIdlePaused) return;
      isIdlePaused = true;
      if (testContainer) {
        testContainer.classList.remove("engine-running");
      }
      document.body.classList.remove("engine-running");
      idlePausedAt = performance.now();
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      idlePausePrompt.classList.remove("hidden");
    }

    function resumeFromIdlePause() {
      if (!isIdlePaused) return;
      isIdlePaused = false;
      if (testContainer) {
        testContainer.classList.add("engine-running");
      }
      document.body.classList.add("engine-running");
      // Shift startTime forward by the paused duration so elapsed time is preserved
      startTime += performance.now() - idlePausedAt;
      lastKeystrokeTime = performance.now();
      idlePausePrompt.classList.add("hidden");
      runTimerLoop();
    }

    function runTimerLoop() {
      if (!testActive || isIdlePaused) return;

      const now = performance.now();
      elapsedSeconds = (now - startTime) / 1000;

      // Idle detection: pause after 10s of no typing
      if (now - lastKeystrokeTime > IDLE_PAUSE_MS) {
        pauseForIdle();
        return;
      }

      const currentSecInt = Math.floor(elapsedSeconds);
      while (currentSecInt > lastSecondRecorded) {
        lastSecondRecorded++;
        const isCurrentSec = lastSecondRecorded === currentSecInt;
        const interimMetrics = calculateMetrics(
          correctKeystrokes,
          incorrectKeystrokes,
          lastSecondRecorded,
        );
        secondBySecondWpm.push(interimMetrics.netWpm);

        const deltaChars = isCurrentSec ? Math.max(0, correctKeystrokes - lastSecondCorrectChars) : 0;
        const instantWpm = calculateInstantaneousWpm(deltaChars, 1);
        perSecondInstantWpm.push(instantWpm);
        if (isCurrentSec) {
          lastSecondCorrectChars = correctKeystrokes;
        }
      }

      let nextTimerText = "";
      if (currentMode === "time") {
        const remaining = Math.max(
          0,
          Math.ceil(targetDuration - elapsedSeconds),
        );
        nextTimerText = `${remaining}s`;

        if (elapsedSeconds >= targetDuration) {
          if (timerMetric.textContent !== nextTimerText) timerMetric.textContent = nextTimerText;
          finishTest();
          return;
        }
      } else if (currentMode === "words" || currentMode === "custom") {
        const wordsLeft = Math.max(0, wordsList.length - currentWordIndex);
        nextTimerText = `${wordsLeft}`;
      } else {
        nextTimerText = `${Math.floor(elapsedSeconds)}s`;
      }
      if (timerMetric.textContent !== nextTimerText) {
        timerMetric.textContent = nextTimerText;
      }
      const nowTs = performance.now();
      if (nowTs - lastStatUpdate > 250 || elapsedSeconds === 0) {
        lastStatUpdate = nowTs;
        const live = calculateMetrics(
          correctKeystrokes,
          incorrectKeystrokes,
          elapsedSeconds,
        );
        wpmMetric.textContent = String(live.netWpm);
        accMetric.textContent = `${live.accuracy}%`;
        errMetric.textContent = String(incorrectKeystrokes);
      }

      animationFrameId = requestAnimationFrame(runTimerLoop);
    }

    function finishTest() {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      if (testActive) {
        emitTyping('typing-stop');
      }
      testActive = false;
      testCompleted = true;
      if (testContainer) {
        testContainer.classList.remove("engine-running");
      }
      document.body.classList.remove("engine-running");
      isIdlePaused = false;
      idlePausePrompt.classList.add("hidden");
      capsLockWarning.classList.add("hidden");
      typingDisplay.classList.remove("!border-[#FF9F0A]/60", "!shadow-[0_0_0_3px_rgba(255,159,10,0.15)]");
      isCapsLockActive = false;

      // Item 10: Hide persistent caret on results screen
      caretEl.style.display = "none";
      caretEl.style.opacity = "0";
      caretEl.classList.remove("caret-idle-blink");

      // Layout bug fix: hide passage + tooltip, show results in normal flow
      typingSurfaceWrapper.classList.add("hidden");
      metricsStrip.classList.add("hidden");
      actionBar.classList.add("hidden");
      focusPrompt.classList.add("hidden");
      focusPrompt.style.display = "none";

      // Item 9: Synchronously flush test timing & metrics including final keystrokes
      const now = performance.now();
      if (startTime > 0) {
        elapsedSeconds = (now - startTime) / 1000;
        const currentSecInt = Math.floor(elapsedSeconds);
        while (currentSecInt > lastSecondRecorded) {
          lastSecondRecorded++;
          const isCurrentSec = lastSecondRecorded === currentSecInt;
          const interimMetrics = calculateMetrics(
            correctKeystrokes,
            incorrectKeystrokes,
            lastSecondRecorded,
          );
          secondBySecondWpm.push(interimMetrics.netWpm);

          const deltaChars = isCurrentSec ? Math.max(0, correctKeystrokes - lastSecondCorrectChars) : 0;
          const instantWpm = calculateInstantaneousWpm(deltaChars, 1);
          perSecondInstantWpm.push(instantWpm);
          if (isCurrentSec) {
            lastSecondCorrectChars = correctKeystrokes;
          }
        }
      }

      const totalTime = Math.max(elapsedSeconds, 1);
      const summary = calculateMetrics(
        correctKeystrokes,
        incorrectKeystrokes,
        totalTime,
        secondBySecondWpm,
      );

      const testSummary: CompletedTestSummary = {
        ...summary,
        missedWords: [...new Set(missedWords)],
        keyMistakes: { ...keyMistakes },
        keystrokeLog: [...keystrokeLog],
        perSecondInstantWpm: [...perSecondInstantWpm],
        secondBySecondWpm: [...secondBySecondWpm],
      };
      lastCompletedSummary = testSummary;
      (window as any).__lastTestSummary = testSummary;

      // P1 Profile Update: XP, Streak, Achievements
      try {
        lastProfileResult = updateProfileAfterTest({
          netWpm: testSummary.netWpm,
          rawWpm: testSummary.rawWpm,
          accuracy: testSummary.accuracy,
          durationSeconds: Math.round(totalTime),
          isDrill: !!(customMistakeWords && customMistakeWords.length > 0),
          isDailyQuote: isDailyQuoteActive,
          dailyQuoteId: currentQuoteObj ? currentQuoteObj.id : undefined,
        });
        if (isDailyQuoteActive) {
          window.dispatchEvent(new CustomEvent('daily-quote-completed', { detail: currentQuoteObj }));
        }
        (window as any).__lastProfileResult = lastProfileResult;
      } catch (e) {
        console.error("Failed to update profile after test:", e);
      }

      saveTestResult({
        id: `ptt_${Date.now()}`,
        timestamp: Date.now(),
        mode:
          currentMode === "time"
            ? `${targetDuration}s`
            : currentMode === "words"
              ? `${targetWordCount} words`
              : currentMode === "custom"
                ? "Custom"
                : currentMode === "code"
                  ? "Code Snippet"
                  : "Quote",
        durationSeconds: Math.round(totalTime),
        netWpm: testSummary.netWpm,
        rawWpm: testSummary.rawWpm,
        accuracy: testSummary.accuracy,
        errors: incorrectKeystrokes,
        correctChars: correctKeystrokes,
        incorrectChars: incorrectKeystrokes,
        missedWords: testSummary.missedWords,
        wpmHistory: testSummary.perSecondInstantWpm,
      });

      showResults(testSummary, recordTest(testSummary.netWpm, testSummary.accuracy, currentMode));
      dispatchNextChar(); // Emits char: null since testCompleted is true
    }

    function updateDockLabels(lang?: SupportedLanguage) {
      const dockMap: Record<string, string> = {
        "btn-dock-restart": "dock.try_again",
        "btn-dock-next": "dock.next_test",
        "btn-dock-target": "dock.train_mistakes",
        "btn-dock-award": "dock.certificate",
        "btn-dock-download": "dock.download_png",
        "btn-dock-copy": "dock.copy_results",
      };
      for (const [id, key] of Object.entries(dockMap)) {
        const el = document.getElementById(id);
        if (el) {
          const translated = t(key, lang);
          el.dataset.label = translated;
          el.setAttribute("aria-label", translated);
        }
      }
    }

    function updateResultsDynamicContent(lang: SupportedLanguage = getLanguage()) {
      updateDOM(lang);
      const activeSummary = lastCompletedSummary || (window as any).__lastTestSummary;
      if (!activeSummary) {
        const coachTaxBadge = document.getElementById("coach-accuracy-tax-badge");
        const coachBottleneckLine = document.getElementById("coach-bottleneck-line");
        const coachBreakdownLine = document.getElementById("coach-breakdown-line");
        const coachDrillLabel = document.getElementById("coach-drill-label");
        const coachDrillHint = document.getElementById("coach-drill-hint");
        if (coachTaxBadge) coachTaxBadge.textContent = t("results.coach_tax_clean", lang);
        if (coachBottleneckLine) coachBottleneckLine.textContent = t("results.coach_analyzing", lang);
        if (coachBreakdownLine) coachBreakdownLine.textContent = t("results.coach_breakdown_clean", lang);
        if (coachDrillLabel) coachDrillLabel.textContent = t("results.coach_drill_practice", lang);
        if (coachDrillHint) coachDrillHint.textContent = t("results.coach_drill_hint", lang);
        updateDockLabels(lang);
        return;
      }

      const bandEl = document.getElementById("res-band");
      const rankEl = document.getElementById("res-rank-title");
      if (bandEl && activeSummary.rankTitle) {
        const locRank = t("rank." + activeSummary.rankTitle.toLowerCase().replace(/[^a-z0-9]/g, '_'), lang) || activeSummary.rankTitle;
        bandEl.textContent = locRank;
        if (rankEl) rankEl.textContent = locRank;
      }

      const weakKeysListEl = document.getElementById("weak-keys-list");
      if (weakKeysListEl) {
        weakKeysListEl.innerHTML = "";
        const activeKeyMistakes = activeSummary.keyMistakes || keyMistakes;
        const mistakesArr = Object.entries(activeKeyMistakes)
          .map(([key, data]: [string, any]) => ({ key, errors: data.errors, total: data.total }))
          .sort((a, b) => b.errors - a.errors)
          .filter((item) => item.errors > 0);

        if (mistakesArr.length > 0) {
          const worstKey = mistakesArr[0];
          const typoWord = worstKey.errors > 1 ? t("results.typos", lang) : t("results.typo", lang);
          const remaining = mistakesArr.slice(1, 8);
          
          const worstDiv = document.createElement("div");
          worstDiv.className = "mb-4 text-[#171717] dark:text-[#E5E5E5] text-[15px] font-medium tracking-tight flex items-center";
          worstDiv.innerHTML = `
            <span class="inline-flex items-center justify-center min-w-[28px] h-7 px-2 rounded bg-[#FAFAFA] dark:bg-[#1D1D1F] border border-red-500/50 shadow-[0_0_12px_rgba(239,68,68,0.4)] dark:shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_0_12px_rgba(239,68,68,0.4)] font-mono text-sm mr-2.5">${worstKey.key}</span>
            <span>${t("results.weakest_key", lang) || "is your weakest key"} &mdash; <span class="text-red-500 font-semibold">${worstKey.errors} ${typoWord}</span></span>
          `;
          weakKeysListEl.appendChild(worstDiv);

          if (remaining.length > 0) {
            const remContainer = document.createElement("div");
            remContainer.className = "flex flex-wrap gap-2";
            
            const maxErrors = worstKey.errors;
            remaining.forEach((item) => {
              const intensity = item.errors / maxErrors;
              const borderOpacity = 0.2 + (0.3 * intensity); 
              const shadowOpacity = 0.1 + (0.3 * intensity);
              const tWord = item.errors > 1 ? t("results.typos", lang) : t("results.typo", lang);
              
              const badge = document.createElement("div");
              badge.className = "flex items-center gap-2 px-2.5 py-1.5 rounded bg-[#FAFAFA] dark:bg-[#1D1D1F] border dark:shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]";
              badge.style.borderColor = `rgba(239,68,68,${borderOpacity})`;
              badge.style.boxShadow = `inset 0 1px 1px rgba(255,255,255,0.1), 0 0 ${4 + 6 * intensity}px rgba(239,68,68,${shadowOpacity})`;
              badge.innerHTML = `
                <span class="font-mono text-[13px] text-[#171717] dark:text-white">${item.key}</span>
                <span class="text-[11px] text-[#86868B]">${item.errors} ${tWord}</span>
              `;
              remContainer.appendChild(badge);
            });
            weakKeysListEl.appendChild(remContainer);
          }
        } else {
          weakKeysListEl.innerHTML =
            `<span class="text-sm font-medium text-emerald-600">${t("results.flawless", lang)}</span>`;
        }
      }

      const activeMissedWords = activeSummary.missedWords || missedWords;
      const uniqueMistakes = [...new Set(activeMissedWords)];
      if (btnTrainMistakes) {
        if (uniqueMistakes.length > 0) {
          btnTrainMistakes.classList.remove("hidden");
          btnTrainMistakes.classList.add("inline-flex");
          const label = document.getElementById("train-label");
          if (label)
            label.textContent = `${t("results.train_mistakes", lang)} (${uniqueMistakes.length})`;
        } else {
          btnTrainMistakes.classList.add("hidden");
          btnTrainMistakes.classList.remove("inline-flex");
        }
      }

      // ── "What's slowing you down" Diagnosis Panel (Task 1) ──
      const coachTaxBadge = document.getElementById("coach-accuracy-tax-badge");
      const coachBottleneckLine = document.getElementById("coach-bottleneck-line");
      const coachBreakdownLine = document.getElementById("coach-breakdown-line");
      const coachDrillBtn = document.getElementById("btn-coach-drill");
      const coachDrillLabel = document.getElementById("coach-drill-label");
      const coachDrillHint = document.getElementById("coach-drill-hint");
      if (coachDrillHint) {
        coachDrillHint.textContent = t("results.coach_drill_hint", lang);
      }

      const accuracyTax = Math.max(0, activeSummary.rawWpm - activeSummary.netWpm);
      if (coachTaxBadge) {
        coachTaxBadge.textContent = accuracyTax > 0 
          ? t("results.coach_tax_wpm", lang, { tax: accuracyTax })
          : t("results.coach_tax_clean", lang);
      }

      const activeKeystrokes = activeSummary.keystrokeLog || keystrokeLog;
      const validKeystrokes = activeKeystrokes.filter((k: any) => k.deltaMs > 20 && k.deltaMs < 6000);
      let medianLatency = 250;
      if (validKeystrokes.length >= 4) {
        const sortedDeltas = [...validKeystrokes].map((k: any) => k.deltaMs).sort((a: any, b: any) => a - b);
        medianLatency = sortedDeltas[Math.floor(sortedDeltas.length / 2)] || 250;
      }
      const hesitationThreshold = Math.max(350, Math.round(medianLatency * 1.8));

      let wrongKeyCount = 0;
      let hesitationCount = 0;
      const keyStats: Record<string, { totalMs: number; count: number; errors: number }> = {};
      const transitionStats: Record<string, { totalMs: number; count: number }> = {};

      for (let i = 0; i < activeKeystrokes.length; i++) {
        const k = activeKeystrokes[i];
        if (!k.isCorrect) {
          wrongKeyCount++;
        } else if (k.deltaMs >= hesitationThreshold && k.deltaMs < 6000) {
          hesitationCount++;
        }

        if (k.char !== " " && k.deltaMs > 20 && k.deltaMs < 5000) {
          const ch = k.char.toLowerCase();
          if (!keyStats[ch]) keyStats[ch] = { totalMs: 0, count: 0, errors: 0 };
          keyStats[ch].totalMs += k.deltaMs;
          keyStats[ch].count++;
          if (!k.isCorrect) keyStats[ch].errors++;
        }

        if (k.prevChar && k.prevChar !== " " && k.char !== " " && k.deltaMs > 20 && k.deltaMs < 5000) {
          const pair = `${k.prevChar.toUpperCase()}→${k.char.toUpperCase()}`;
          if (!transitionStats[pair]) transitionStats[pair] = { totalMs: 0, count: 0 };
          transitionStats[pair].totalMs += k.deltaMs;
          transitionStats[pair].count++;
        }
      }

      if (wrongKeyCount === 0 && activeSummary.incorrectChars > 0) {
        wrongKeyCount = activeSummary.incorrectChars;
      }

      const slowestKeysArr = Object.entries(keyStats)
        .map(([key, data]) => ({ key, avgMs: Math.round(data.totalMs / data.count), count: data.count, errors: data.errors }))
        .filter(d => d.count >= 1)
        .sort((a, b) => b.avgMs - a.avgMs);

      const slowestTransitionsArr = Object.entries(transitionStats)
        .map(([pair, data]: [string, any]) => ({ pair, avgMs: Math.round(data.totalMs / data.count), count: data.count }))
        .filter(d => d.count >= 1)
        .sort((a, b) => b.avgMs - a.avgMs);

      const worstTransition = slowestTransitionsArr[0];
      const activeKeyMistakes = activeSummary.keyMistakes || keyMistakes;
      const mistakesArr = Object.entries(activeKeyMistakes)
        .map(([key, data]: [string, any]) => ({ key, errors: data.errors, total: data.total }))
        .sort((a, b) => b.errors - a.errors)
        .filter((item) => item.errors > 0);

      const slowestKeyList = slowestKeysArr.length > 0 
        ? slowestKeysArr.slice(0, 3).map(k => k.key.toUpperCase())
        : (mistakesArr.length > 0 ? mistakesArr.slice(0, 3).map(m => m.key.toUpperCase()) : []);

      const drillKeys = Array.from(new Set([
        ...(worstTransition ? worstTransition.pair.split("→").map(s => s.toLowerCase()) : []),
        ...slowestKeysArr.slice(0, 2).map(k => k.key.toLowerCase()),
        ...mistakesArr.slice(0, 2).map(m => m.key.toLowerCase())
      ])).filter(Boolean);

      let namedBottleneck = "";
      if (mistakesArr.length > 0) {
        const topErrorKey = mistakesArr[0];
        if (topErrorKey.errors > 1) {
          namedBottleneck = accuracyTax > 0
            ? t("results.coach_bottleneck_typos_tax", lang, { key: topErrorKey.key.toUpperCase(), count: topErrorKey.errors, tax: accuracyTax })
            : t("results.coach_bottleneck_typos", lang, { key: topErrorKey.key.toUpperCase(), count: topErrorKey.errors });
        } else {
          namedBottleneck = accuracyTax > 0
            ? t("results.coach_bottleneck_typo_tax", lang, { key: topErrorKey.key.toUpperCase(), tax: accuracyTax })
            : t("results.coach_bottleneck_typo", lang, { key: topErrorKey.key.toUpperCase() });
        }
      } else if (worstTransition && worstTransition.avgMs > medianLatency * 1.3 && activeSummary.netWpm > 0) {
        const delayPerKeystroke = Math.max(70, worstTransition.avgMs - medianLatency);
        const estCostWpm = Math.max(2, Math.min(20, Math.round((delayPerKeystroke / 1000) * (activeSummary.rawWpm || 50) * 0.35 * worstTransition.count)));
        namedBottleneck = t("results.coach_bottleneck_transition", lang, { pair: worstTransition.pair, wpm: estCostWpm, ms: worstTransition.avgMs });
      } else if (hesitationCount > 2) {
        const hesitationCost = Math.max(2, Math.round(hesitationCount * 1.2));
        namedBottleneck = t("results.coach_bottleneck_hesitations", lang, { wpm: hesitationCost });
      } else if (slowestKeysArr.length > 0 && slowestKeysArr[0].avgMs > 300) {
        namedBottleneck = t("results.coach_bottleneck_slow_key", lang, { key: slowestKeysArr[0].key.toUpperCase(), ms: slowestKeysArr[0].avgMs });
      } else if (accuracyTax > 0) {
        namedBottleneck = t("results.coach_bottleneck_accuracy_tax", lang, { tax: accuracyTax });
      } else {
        namedBottleneck = t("results.coach_bottleneck_clean", lang);
      }

      if (coachBottleneckLine) {
        coachBottleneckLine.innerHTML = `<span class="font-semibold text-neutral-900 dark:text-white">${t("results.coach_bottleneck_prefix", lang)}</span> ${namedBottleneck}.`;
      }

      if (coachBreakdownLine) {
        const slowKeysText = slowestKeyList.length > 0 ? slowestKeyList.join(", ") : t("results.coach_none", lang);
        coachBreakdownLine.textContent = t("results.coach_breakdown", lang, {
          keys: slowKeysText,
          hesitations: hesitationCount,
          wrong: wrongKeyCount,
          tax: accuracyTax,
          raw: activeSummary.rawWpm,
          net: activeSummary.netWpm
        });
      }

      if (coachDrillBtn && coachDrillLabel) {
        if (uniqueMistakes.length > 0) {
          coachDrillLabel.textContent = uniqueMistakes.length > 1
            ? t("results.coach_drill_mistakes", lang, { count: uniqueMistakes.length })
            : t("results.coach_drill_mistakes_singular", lang);
          coachDrillBtn.onclick = () => {
            btnTrainMistakes.click();
          };
        } else if (drillKeys.length > 0) {
          coachDrillLabel.textContent = t("results.coach_drill_problem_keys", lang, { keys: drillKeys.slice(0, 3).join(", ").toUpperCase() });
          coachDrillBtn.onclick = () => {
            const corpus = getSelectedCorpus();
            const targeted = corpus.filter(w => drillKeys.some(k => w.toLowerCase().includes(k)));
            customMistakeWords = targeted.length >= 8 ? targeted.slice(0, 30) : corpus.slice(0, 30);
            resultsPanel.classList.add("hidden");
            resetTest();
          };
        } else {
          coachDrillLabel.textContent = t("results.coach_drill_practice", lang);
          coachDrillBtn.onclick = () => {
            resetTest();
          };
        }
      }

      // Personal best banner
      const pb = getPersonalBest();
      const isNewBest = pb.totalTests <= 1 || activeSummary.netWpm >= pb.highestWpm;
      if (personalBestBanner && personalBestLabel) {
        personalBestBanner.classList.remove("hidden");
        if (isNewBest && pb.totalTests > 1) {
          personalBestLabel.textContent = `🏆 ${t("results.new_best", lang)} — ${activeSummary.netWpm} ${t("results.wpm_short", lang)}`;
        } else if (pb.highestWpm > 0) {
          personalBestLabel.textContent = `${t("results.best", lang)}: ${pb.highestWpm} ${t("results.wpm_short", lang)}`;
          personalBestBanner.classList.remove("aurora-border");
        } else {
          personalBestBanner.classList.add("hidden");
        }
      }

      const resQuoteAttr = document.getElementById("res-quote-attribution");
      if (resQuoteAttr) {
        if (currentQuoteObj) {
          resQuoteAttr.textContent = `— ${currentQuoteObj.author}, ${currentQuoteObj.source}`;
          resQuoteAttr.classList.remove("hidden");
        } else {
          resQuoteAttr.classList.add("hidden");
        }
      }

      // Render P1 XP Receipt
      const xpReceipt = document.getElementById("results-xp-receipt");
      const xpTotalEl = document.getElementById("xp-receipt-total");
      const xpLevelTag = document.getElementById("xp-receipt-level-tag");
      const xpBreakdownEl = document.getElementById("xp-receipt-breakdown");
      const xpProgressLabel = document.getElementById("xp-receipt-progress-label");
      const xpProgressPercent = document.getElementById("xp-receipt-progress-percent");
      const xpProgressBar = document.getElementById("xp-receipt-progress-bar");

      const profileResult = lastProfileResult || (window as any).__lastProfileResult;
      if (xpReceipt && profileResult && profileResult.xpAwarded.eligible) {
        xpReceipt.classList.remove("hidden");
        if (xpTotalEl) countUp(xpTotalEl, profileResult.xpAwarded.total, { duration: 800, prefix: "+", suffix: " XP" });
        if (xpLevelTag) xpLevelTag.textContent = t("results.xp_level", lang, { level: profileResult.levelAfter });

        const parts = [t("results.xp_base", lang, { amount: profileResult.xpAwarded.base })];
        profileResult.xpAwarded.bonuses.forEach((b: any) => {
          let label = b.label;
          if (b.label === "Personal best!") {
            label = t("results.xp_bonus_pb", lang, { amount: b.amount });
          } else if (b.label === "Cleaner than your average") {
            label = t("results.xp_bonus_cleaner", lang, { amount: b.amount });
          } else if (b.label === "Daily warmup") {
            label = t("results.xp_bonus_warmup", lang, { amount: b.amount });
          } else if (b.label.includes("streak")) {
            const days = b.label.match(/\d+/)?.[0] || "1";
            label = t("results.xp_bonus_streak", lang, { days, amount: b.amount });
          } else if (b.label === "Quote of the Day") {
            label = t("results.xp_bonus_daily_quote", lang, { amount: b.amount });
          }
          parts.push(label);
        });
        if (xpBreakdownEl) xpBreakdownEl.textContent = parts.join(" · ");

        const progress = getXpProgressForLevel(profileResult.profile.xp);
        if (xpProgressLabel) {
          xpProgressLabel.textContent = t("results.xp_progress", lang, {
            level: progress.level,
            xp: progress.xpNeededForNext,
            nextLevel: progress.level + 1
          });
        }
        if (xpProgressPercent) {
          xpProgressPercent.textContent = `${Math.round(progress.progressPercent)}%`;
        }
        if (xpProgressBar) {
          xpProgressBar.style.width = `${progress.progressPercent}%`;
        }
      } else if (xpReceipt) {
        xpReceipt.classList.add("hidden");
      }

      updateDockLabels(lang);
    }

    function showResults(summary: CompletedTestSummary, psych?: import("../scripts/progress").TestResult) {
      (window as any).__showTestResults = showResults;
      updateDOM();
      const bandEl = document.getElementById("res-band")!;
      const rankEl = document.getElementById("res-rank-title")!;
      const locRank = t("rank." + summary.rankTitle.toLowerCase().replace(/[^a-z0-9]/g, '_')) || summary.rankTitle;
      bandEl.textContent = locRank;
      rankEl.textContent = locRank;

      const resNetWpmEl = document.getElementById("res-net-wpm")!;
      countUp(resNetWpmEl, summary.netWpm, { duration: 800 });
      const resAccuracyEl = document.getElementById("res-accuracy")!;
      countUp(resAccuracyEl, summary.accuracy, { duration: 800, suffix: "%" });
      const resRawWpmEl = document.getElementById("res-raw-wpm");
      if (resRawWpmEl) countUp(resRawWpmEl, summary.rawWpm, { duration: 800 });
      const resConsistencyEl = document.getElementById("res-consistency");
      if (resConsistencyEl) countUp(resConsistencyEl, summary.consistency, { duration: 800, suffix: "%" });
      document.getElementById("res-correct-chars")!.textContent = String(
        summary.correctChars,
      );
      document.getElementById("res-error-chars")!.textContent = String(
        summary.incorrectChars,
      );
      document.getElementById("res-total-keystrokes")!.textContent = String(
        summary.totalKeystrokes,
      );
      document.getElementById("res-time-elapsed")!.textContent =
        `${Math.round(summary.elapsedSeconds)}s`;


      // ── Psychology engine UI ──
      if (psych) {
        const strip = document.getElementById("res-progress-strip");
        if (strip) strip.classList.remove("hidden");
        const prog = loadProgress();
        const lvl = getLevel(prog.xp);
        const daily = getDailyProgress();
        document.getElementById("res-streak")!.textContent = String(psych.streak);
        document.getElementById("res-level-title")!.textContent = t("level." + lvl.title.toLowerCase()) || lvl.title;
        (document.getElementById("res-xp-bar")! as HTMLElement).style.width = `${Math.round(lvl.progress * 100)}%`;
        const resXpTextEl = document.getElementById("res-xp-text");
        if (resXpTextEl) countUp(resXpTextEl, psych.xpGained, { duration: 800, prefix: "+", suffix: " XP" });
        document.getElementById("res-daily")!.textContent = `${daily.done}/${daily.goal}`;
        const nudge = document.getElementById("res-psych-nudge");
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (psych.isNewPb) {
          if (nudge) nudge.classList.remove("hidden");
          if (nudge) nudge.innerHTML = `<span class="inline-flex items-center px-3 py-1 rounded-full bg-[#0072F5]/10 text-[#004FC4] text-xs font-bold">${t("results.new_best")}</span>`;
          if (!reduceMotion) {
            resNetWpmEl.animate(
              [{ transform: 'scale(1)' }, { transform: 'scale(1.12)' }, { transform: 'scale(1)' }],
              { duration: 300, easing: 'cubic-bezier(0.34, 1.56, 0.64, 1)' }
            );
          }
        } else if (psych.nearMiss !== null) {
          if (nudge) nudge.classList.remove("hidden");
          if (nudge) nudge.innerHTML = `<span class="text-[#6E6E73] dark:text-[#A1A1A6]">${t("results.near_miss", undefined, { wpm: psych.nearMiss })}</span>`;
        } else {
          if (nudge) nudge.classList.add("hidden");
        }
      }
      renderTimelineChart(
        summary.perSecondInstantWpm || perSecondInstantWpm,
        summary.secondBySecondWpm || secondBySecondWpm
      );
      updateResultsDynamicContent();

      // Achievement toasts (fire exactly once on unlock) + level up + streak freeze
      if (lastProfileResult) {
        if (lastProfileResult.newAchievements && lastProfileResult.newAchievements.length > 0) {
          lastProfileResult.newAchievements.forEach(ach => {
            showAchievementToast(ach);
          });
        }
        if (lastProfileResult.levelAfter > lastProfileResult.levelBefore) {
          notify({
            title: t("toast.level_title", { level: lastProfileResult.levelAfter }),
            description: t("toast.level_desc", { level: lastProfileResult.levelAfter }),
            icon: 'trophy',
          });
        }
        if (lastProfileResult.streakSurvivedByFreeze) {
          notify({
            title: t("toast.streak_saved_title"),
            description: t("toast.streak_saved_desc"),
            icon: 'flame',
          });
        }
      }

      // Roast mode: show a performance-picked roast on the results screen.
      // The card stays hidden unless roast mode is enabled.
      (async function showRoast() {
        if (!roastCard || !roastText) return;
        if (!roastModeEnabled) {
          roastCard.classList.add("hidden");
          return;
        }
        const lang = getLanguage();
        // Ensure this language's dictionary is loaded in this module instance
        // (language switches load async; the test may finish first).
        try {
          await loadLanguage(lang);
        } catch {}
        // en has 5 existing good_* roasts, other locales have 6
        const goodCount = lang === "en" ? 39 : 40;
        let prefix: string;
        let count: number;
        if (summary.accuracy < 92) {
          prefix = "roast.low_acc_";
          count = 20;
        } else if (summary.netWpm < 45) {
          prefix = "roast.low_wpm_";
          count = 20;
        } else {
          prefix = "roast.good_";
          count = goodCount;
        }
        const n = 1 + Math.floor(Math.random() * count);
        currentRoastKey = prefix + n;
        const roastLine = t(currentRoastKey, lang);
        roastText.textContent = "\u201C" + roastLine + "\u201D";
        roastCard.classList.remove("hidden");
        // Fall back to the static mascot image if the roast video fails
        if (roastVideo && roastImg) {
          const useImage = () => {
            roastVideo.classList.add("hidden");
            roastImg.classList.remove("hidden");
          };
          roastVideo.addEventListener("error", useImage, { once: true });
          if (roastVideo.networkState === 3) useImage(); // NETWORK_NO_SOURCE
        }
      })();

      resultsPanel.classList.remove("hidden");
      // Natural scroll to results
      safeSetTimeout(() => {
        resultsPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      }, 100);
    }
    (window as any).__showTestResults = showResults;

    function renderTimelineChart(instantData: number[], cumulativeData: number[] = []) {
      const svg = document.getElementById("timeline-chart-svg")!;
      if (!instantData || instantData.length < 2) {
        svg.innerHTML =
          `<text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#86868B" font-size="12" font-family="system-ui">${t("results.chart_no_data")}</text>`;
        (svg as any).__chartData = null;
        return;
      }

      const allValues = [...instantData, ...(cumulativeData || [])];
      const maxWpm = Math.max(...allValues, 40);
      let yStep = 20;
      if (maxWpm > 400) {
        yStep = 200;
      } else if (maxWpm > 200) {
        yStep = 100;
      } else if (maxWpm > 120) {
        yStep = 50;
      } else if (maxWpm > 70) {
        yStep = 30;
      } else {
        yStep = 20;
      }
      const roundedMax = Math.max(yStep * 2, Math.ceil(maxWpm / yStep) * yStep);

      // Overall average Net WPM (from final cumulative point if available, else mean of instantData)
      const avgWpm = cumulativeData && cumulativeData.length > 0
        ? Math.round(cumulativeData[cumulativeData.length - 1])
        : Math.round(instantData.reduce((a, b) => a + b, 0) / instantData.length);
      (svg as any).__avgWpm = avgWpm;
      
      const width = 500;
      const height = 100;
      const pl = 35; // padding left
      const pr = 10; // padding right
      const pt = 10; // padding top
      const pb = 20; // padding bottom

      const plotW = width - pl - pr;
      const plotH = height - pt - pb;

      const chartPoints = instantData.map((val, idx) => {
        const x = pl + (idx / (instantData.length - 1)) * plotW;
        const y = pt + plotH - ((val / roundedMax) * plotH);
        return { x, y, val, sec: idx + 1 };
      });
      (svg as any).__chartData = chartPoints;

      function generateSmoothPath(points: Array<{ x: number; y: number }>): string {
        if (!points || points.length === 0) return "";
        let path = `M ${points[0].x},${points[0].y}`;
        const tension = 0.2;
        for (let i = 0; i < points.length - 1; i++) {
          const p0 = i > 0 ? points[i - 1] : points[i];
          const p1 = points[i];
          const p2 = points[i + 1];
          const p3 = i !== points.length - 2 ? points[i + 2] : p2;
          
          const cp1x = p1.x + (p2.x - p0.x) * tension;
          const cp1y = p1.y + (p2.y - p0.y) * tension;
          const cp2x = p2.x - (p3.x - p1.x) * tension;
          const cp2y = p2.y - (p3.y - p1.y) * tension;
          
          path += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p2.x},${p2.y}`;
        }
        return path;
      }

      const instantPathData = generateSmoothPath(chartPoints);
      const instantAreaPath = instantPathData + (chartPoints.length > 0 ? ` L ${chartPoints[chartPoints.length - 1].x},${height - pb} L ${pl},${height - pb} Z` : "");

      const isDark = document.documentElement.classList.contains("dark");
      const strokeColor = "#0072F5";
      const gridColor = isDark ? "rgba(255,255,255,0.08)" : "rgba(0,0,0,0.08)";
      const dotBg = isDark ? "#1D1D1F" : "#FAFAFA";
      const labelColor = isDark ? "#A1A1A6" : "#6E6E73";

      let cumulativePathHtml = "";
      if (cumulativeData && cumulativeData.length >= 2) {
        const cumulativePoints = cumulativeData.map((val, idx) => {
          const x = pl + (idx / (cumulativeData.length - 1)) * plotW;
          const y = pt + plotH - ((val / roundedMax) * plotH);
          return { x, y };
        });
        const cumulativePathData = generateSmoothPath(cumulativePoints);
        cumulativePathHtml = `<path d="${cumulativePathData}" fill="none" stroke="${labelColor}" stroke-dasharray="4 4" stroke-width="1.5" opacity="0.65" stroke-linecap="round" stroke-linejoin="round" />`;
      }
      
      let gridHtml = "";
      
      for (let w = 0; w <= roundedMax; w += yStep) {
        const y = pt + plotH - ((w / roundedMax) * plotH);
        gridHtml += `<line x1="${pl}" y1="${y}" x2="${width - pr}" y2="${y}" stroke="${gridColor}" stroke-dasharray="3 3" stroke-width="0.75" />`;
        gridHtml += `<text x="${pl - 6}" y="${y}" fill="${labelColor}" font-size="9" font-family="'Geist Variable', system-ui, sans-serif" style="font-variant-numeric: tabular-nums;" text-anchor="end" dominant-baseline="central">${w}</text>`;
      }
      
      const totalSecs = instantData.length;
      let xStep = 1;
      if (totalSecs > 120) xStep = 30;
      else if (totalSecs > 60) xStep = 15;
      else if (totalSecs > 30) xStep = 10;
      else if (totalSecs > 15) xStep = 5;
      else if (totalSecs > 12) xStep = 2;

      for (let s = 1; s <= totalSecs; s += xStep) {
        if (s - 1 < chartPoints.length) {
          const ptData = chartPoints[s - 1];
          // Prevent overlap with final label
          if (s !== totalSecs && (totalSecs - s) < (xStep * 0.5)) continue;
          gridHtml += `<text x="${ptData.x}" y="${height - pb + 14}" fill="${labelColor}" font-size="9" font-family="'Geist Variable', system-ui, sans-serif" style="font-variant-numeric: tabular-nums;" text-anchor="middle">${s}</text>`;
        }
      }
      
      if ((totalSecs - 1) % xStep !== 0) {
        const endPt = chartPoints[chartPoints.length - 1];
        gridHtml += `<text x="${endPt.x}" y="${height - pb + 14}" fill="${labelColor}" font-size="9" font-family="'Geist Variable', system-ui, sans-serif" style="font-variant-numeric: tabular-nums;" text-anchor="middle">${totalSecs}</text>`;
      }

      // Average Line
      const avgY = pt + plotH - ((avgWpm / roundedMax) * plotH);
      const labelAvgY = avgY < pt + 10 ? avgY + 11 : avgY - 4;
      gridHtml += `<line x1="${pl}" y1="${avgY}" x2="${width - pr}" y2="${avgY}" stroke="${labelColor}" stroke-dasharray="4 4" stroke-width="1" opacity="0.4" />`;
      gridHtml += `<text id="chart-avg-label" x="${width - pr}" y="${labelAvgY}" fill="${labelColor}" font-size="9" font-family="'Geist Variable', system-ui, sans-serif" style="font-variant-numeric: tabular-nums;" text-anchor="end">${t("results.chart_avg", { wpm: avgWpm })}</text>`;

      // Peak Marker (true instantaneous peak)
      let peakPt = chartPoints[0];
      for (let pt of chartPoints) {
        if (pt.val > peakPt.val) peakPt = pt;
      }
      
      let peakAnchor = "middle";
      let peakX = peakPt.x;
      if (peakX > width - pr - 35) {
        peakAnchor = "end";
        peakX = width - pr - 4;
      } else if (peakX < pl + 35) {
        peakAnchor = "start";
        peakX = pl + 6;
      }

      const peakY = peakPt.y < pt + 12 ? peakPt.y + 14 : peakPt.y - 8;
      
      gridHtml += `<text id="chart-peak-label" x="${peakX}" y="${peakY}" fill="${strokeColor}" font-size="9" font-weight="bold" font-family="'Geist Variable', system-ui, sans-serif" style="font-variant-numeric: tabular-nums;" text-anchor="${peakAnchor}">${t("results.chart_peak", { wpm: Math.round(peakPt.val) })}</text>`;
      
      const endPt = chartPoints[chartPoints.length - 1];
      if (peakPt !== endPt) {
        gridHtml += `<circle cx="${peakPt.x}" cy="${peakPt.y}" r="3" fill="${strokeColor}" />`;
      }
      
      // Final luminous dot
      gridHtml += `<circle cx="${endPt.x}" cy="${endPt.y}" r="3" fill="${strokeColor}" />`;
      gridHtml += `<circle cx="${endPt.x}" cy="${endPt.y}" r="6" fill="${strokeColor}" opacity="0.3" />`;

      svg.innerHTML = `
        <defs>
          <linearGradient id="chart-area-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="${strokeColor}" stop-opacity="0.25" />
            <stop offset="100%" stop-color="${strokeColor}" stop-opacity="0" />
          </linearGradient>
        </defs>
        ${gridHtml}
        <path d="${instantAreaPath}" fill="url(#chart-area-grad)" />
        ${cumulativePathHtml}
        <path d="${instantPathData}" fill="none" stroke="${strokeColor}" stroke-width="6" opacity="0.15" stroke-linecap="round" stroke-linejoin="round" />
        <path d="${instantPathData}" fill="none" stroke="${strokeColor}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <g id="chart-interactive-layer" class="opacity-0 transition-opacity duration-75 motion-reduce:transition-none pointer-events-none">
          <line id="chart-crosshair-line" y1="${pt}" y2="${height - pb}" stroke="${strokeColor}" stroke-dasharray="4 4" stroke-width="1.5" opacity="0.5" />
          <circle id="chart-crosshair-dot" r="4.5" fill="${strokeColor}" stroke="${dotBg}" stroke-width="2" />
        </g>
      `;
    }

    let cachedIsMobile = typeof window !== "undefined" && window.matchMedia ? window.matchMedia('(pointer: coarse)').matches : false;

    function focusTyping() {
      if (testCompleted) return;
      try { ensureAudioContext(); } catch {}
      const targetInput = hiddenInput || (document.getElementById("hidden-typing-input") as HTMLInputElement);
      const targetCaret = caretEl || (document.getElementById("typing-caret") as HTMLElement);
      const targetPrompt = focusPrompt || (document.getElementById("focus-prompt") as HTMLElement);
      const targetDisplay = typingDisplay || (document.getElementById("typing-display") as HTMLElement);
      try {
        if (cachedIsMobile) {
          targetInput?.focus();
        } else {
          targetInput?.focus({ preventScroll: true });
        }
      } catch (e) {
        try { targetInput?.focus(); } catch {}
      }
      targetPrompt?.classList.add("opacity-0", "pointer-events-none");
      targetDisplay?.classList.add("!border-[#0072F5]/30");
      if (targetCaret) {
        targetCaret.style.display = "";
        targetCaret.style.opacity = "1";
        // Monkeytype-style: blink while idle at the start position.
        // Removed on first keystroke (startTest) so the caret goes solid.
        if (!testActive && !testCompleted) {
          targetCaret.classList.add("caret-idle-blink");
        }
      }
    }

    function blurTyping() {
      if (testCompleted) return;
      focusPrompt.classList.remove("opacity-0", "pointer-events-none");
      typingDisplay.classList.remove("!border-[#0072F5]/30");
      caretEl.style.opacity = "0";
    }

    typingDisplay.addEventListener("click", focusTyping);
    typingDisplay.addEventListener("touchstart", focusTyping, { passive: true });
    // Prevent the display div (tabindex="0") from stealing focus on mouse
    // click. Focus must go straight to the hidden input so keystrokes
    // register and the caret stays visible. (Does not block click/touch.)
    typingDisplay.addEventListener("mousedown", (e) => e.preventDefault());
    focusPrompt.addEventListener("click", focusTyping);
    focusPrompt.addEventListener("touchstart", focusTyping, { passive: true });
    hiddenInput.addEventListener("focus", focusTyping);
    hiddenInput.addEventListener("blur", blurTyping);

    function handleCharacterInput(char: string) {
      if (testCompleted) return;
      if (!testActive) startTest();
      const nowInput = performance.now();
      const deltaMs = lastCharInputTime > 0 ? (nowInput - lastCharInputTime) : 0;
      lastCharInputTime = nowInput;
      lastKeystrokeTime = nowInput;
      if (isIdlePaused) resumeFromIdlePause();

      const targetWord = wordsList[currentWordIndex] || "";

      if (char === " ") {
        if (currentInput.length === 0) {
          dispatchNextChar();
          return;
        }

        const isWordCorrect = currentInput === targetWord;
        wordInputs[currentWordIndex] = currentInput;

        if (deltaMs > 20 && deltaMs < 8000) {
          const prevEntry = keystrokeLog[keystrokeLog.length - 1];
          keystrokeLog.push({
            char: " ",
            expectedChar: " ",
            isCorrect: isWordCorrect,
            timestamp: nowInput,
            deltaMs,
            prevChar: prevEntry ? prevEntry.char : ""
          });
        }

        if (!isWordCorrect) {
          if (selectedStopOnError === "on") {
            incorrectKeystrokes++;
            scheduleKeystrokeEffect(() => {
              playKeyStrokeSound(" ", true, true);
              emitTyping('typing-key-result', { char: " ", correct: false });
            });
            return;
          }
          missedWords.push(targetWord);
          scheduleKeystrokeEffect(() => {
            playKeyStrokeSound(" ", true, true);
            emitTyping('typing-key-result', { char: " ", correct: false });
          });
        } else {
          correctKeystrokes += 1;
          scheduleKeystrokeEffect(() => {
            playKeyStrokeSound(" ", true, false);
            emitTyping('typing-key-result', { char: " ", correct: true });
          });
        }

        // Complete previous word on cached node
        const prevWordEl = cachedWordNodes[currentWordIndex];
        if (prevWordEl) {
          prevWordEl.classList.remove("active-word");
          prevWordEl.classList.add("word-completed");
          if (!isWordCorrect) {
            prevWordEl.classList.add("word-has-error");
          }
        }

        currentWordIndex++;
        currentInput = "";
        hiddenInput.value = "";

        // Guardrail 2: Preserve on-demand word appending for timed modes
        if (currentMode === "time" && wordsList.length - currentWordIndex < 35) {
          appendMoreWords(50);
        }

        if (currentWordIndex >= wordsList.length) {
          finishTest();
          return;
        }

        // Activate next word on cached node
        const nextWordEl = cachedWordNodes[currentWordIndex];
        if (nextWordEl) {
          nextWordEl.classList.add("active-word");
          const chars = cachedCharNodes[currentWordIndex] || [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className = "char char-untyped";
          }
        }

        const hadExtras = extraCharNodes[currentWordIndex]?.length > 0 || (currentWordIndex > 0 && extraCharNodes[currentWordIndex - 1]?.length > 0);
        if (hadExtras) {
          updateWordOffsets(currentWordIndex);
        } else {
          // Cheap staleness guard on the space path: single read of live offsetLeft/offsetTop.
          // If diverged by more than 1px, recalculate instead of reusing.
          const liveWordEl = cachedWordNodes[currentWordIndex];
          const cached = wordOffsets[currentWordIndex];
          if (liveWordEl && cached) {
            const dx = Math.abs(liveWordEl.offsetLeft - cached.x);
            if (dx > 1) {
              updateWordOffsets(currentWordIndex);
            }
          } else if (liveWordEl && !cached) {
            updateWordOffsets(currentWordIndex);
          }
        }
        updateCaretPosition();
        scheduleKeystrokeEffect(() => dispatchNextChar());
        return;
      }

      if (!keyMistakes[char]) keyMistakes[char] = { errors: 0, total: 0 };
      keyMistakes[char].total++;

      const charIdx = currentInput.length;
      const targetWordLen = targetWord.length;
      const targetChar = charIdx < targetWordLen ? targetWord[charIdx] : "";
      const isCorrectChar = char === targetChar || (char.charCodeAt(0) > 127 && char.normalize("NFC") === targetChar.normalize("NFC"));

      if (deltaMs > 20 && deltaMs < 8000) {
        const prevEntry = keystrokeLog[keystrokeLog.length - 1];
        keystrokeLog.push({
          char,
          expectedChar: targetChar,
          isCorrect: isCorrectChar,
          timestamp: nowInput,
          deltaMs,
          prevChar: prevEntry ? prevEntry.char : ""
        });
      }

      // VISUAL FIRST: update letter color immediately, before audio/events.
      // This is the most time-critical update — the user must see feedback instantly.
      const charsEarly = cachedCharNodes[currentWordIndex];
      if (charIdx < targetWordLen && charsEarly && charsEarly[charIdx]) {
        charsEarly[charIdx].className = isCorrectChar ? "char char-correct" : "char char-error";
      }

      if (isCorrectChar) {
        correctKeystrokes++;
        scheduleKeystrokeEffect(() => {
          playKeyStrokeSound(char, false, false);
          emitTyping('typing-key-result', { char, correct: true });
        });
      } else {
        if (selectedStopOnError === "on") {
          incorrectKeystrokes++;
          if (!keyMistakes[char]) keyMistakes[char] = { errors: 0, total: 0 };
          keyMistakes[char].errors++;
          scheduleKeystrokeEffect(() => {
            playKeyStrokeSound(char, false, true);
            emitTyping('typing-key-result', { char, correct: false });
          });
          return;
        }

        incorrectKeystrokes++;
        keyMistakes[char].errors++;
        scheduleKeystrokeEffect(() => {
          playKeyStrokeSound(char, false, true);
          emitTyping('typing-key-result', { char, correct: false });
        });
      }

      currentInput += char;

      // Update char class on cached node (already done above for the main case;
      // this handles extra characters beyond word length)
      const chars = cachedCharNodes[currentWordIndex];
      if (charIdx >= targetWordLen) {
        // Extra characters beyond target word length
        const activeWordEl = cachedWordNodes[currentWordIndex];
        if (activeWordEl) {
          const extraSpan = document.createElement("span");
          extraSpan.className = "extra-char char-extra";
          extraSpan.textContent = char;
          activeWordEl.appendChild(extraSpan);
          if (extraCharNodes[currentWordIndex]) {
            extraCharNodes[currentWordIndex].push(extraSpan);
          }
          updateWordOffsets(currentWordIndex);
        }
      }

      updateCaretPosition();
      scheduleKeystrokeEffect(() => dispatchNextChar());

      if ((currentMode === "quote" || currentMode === "classics") && currentWordIndex === wordsList.length - 1 && currentInput === targetWord) {
        wordInputs[currentWordIndex] = currentInput;
        finishTest();
      }
    }

    function handleBackspace() {
      if (testCompleted) return;
      if (testActive) lastKeystrokeTime = performance.now();
      if (isIdlePaused) resumeFromIdlePause();

      if (currentInput.length > 0) {
        const lastIdx = currentInput.length - 1;
        const targetWord = wordsList[currentWordIndex] || "";

        if (lastIdx >= targetWord.length) {
          // Remove extra character
          const extras = extraCharNodes[currentWordIndex];
          if (extras && extras.length > 0) {
            const extraSpan = extras.pop();
            extraSpan?.remove();
            updateWordOffsets(currentWordIndex);
          }
        } else {
          const chars = cachedCharNodes[currentWordIndex];
          if (chars && chars[lastIdx]) {
            chars[lastIdx].className = "char char-untyped";
          }
        }

        currentInput = currentInput.slice(0, -1);
        hiddenInput.value = currentInput;
        updateCaretPosition();
        scheduleKeystrokeEffect(() => {
          playKeyStrokeSound("Backspace", false, false);
          emitTyping('typing-backspace');
          dispatchNextChar();
        });
      } else if (currentWordIndex > 0) {
        if (activeBackspaceMode === "current") {
          return;
        }
        // Backspacing across word boundary into previous word
        const currentWordEl = cachedWordNodes[currentWordIndex];
        if (currentWordEl) {
          currentWordEl.classList.remove("active-word");
          const chars = cachedCharNodes[currentWordIndex] || [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className = "char char-untyped";
          }
        }

        currentWordIndex--;
        const prevWordEl = cachedWordNodes[currentWordIndex];
        if (prevWordEl) {
          prevWordEl.classList.remove("word-completed", "word-has-error");
          prevWordEl.classList.add("active-word");
        }

        // Pop last missed word if it was this word
        const targetWord = wordsList[currentWordIndex] || "";
        const lastMissed = missedWords[missedWords.length - 1];
        if (lastMissed === targetWord) {
          missedWords.pop();
        }

        currentInput = wordInputs[currentWordIndex] || "";
        hiddenInput.value = currentInput;
        updateWordOffsets(currentWordIndex);
        updateCaretPosition();
        scheduleKeystrokeEffect(() => {
          playKeyStrokeSound("Backspace", false, false);
          emitTyping('typing-backspace');
          dispatchNextChar();
        });
      }
    }

    function handleCtrlBackspace() {
      if (testCompleted) return;

      if (currentInput.length > 0) {
        // Clear current word mid-word
        const extras = extraCharNodes[currentWordIndex];
        let hadExtras = false;
        if (extras && extras.length > 0) {
          hadExtras = true;
          while (extras.length > 0) {
            extras.pop()?.remove();
          }
        }
        const chars = cachedCharNodes[currentWordIndex] || [];
        for (let i = 0; i < chars.length; i++) {
          chars[i].className = "char char-untyped";
        }
        currentInput = "";
        hiddenInput.value = "";
        if (hadExtras) {
          updateWordOffsets(currentWordIndex);
        }
        updateCaretPosition();
        scheduleKeystrokeEffect(() => {
          playKeyStrokeSound("Backspace", false, false);
          emitTyping('typing-backspace');
          dispatchNextChar();
        });
      } else if (currentWordIndex > 0) {
        if (activeBackspaceMode === "current") {
          return;
        }
        // Clear previous word when at start of word
        const currentWordEl = cachedWordNodes[currentWordIndex];
        if (currentWordEl) {
          currentWordEl.classList.remove("active-word");
          const chars = cachedCharNodes[currentWordIndex] || [];
          for (let i = 0; i < chars.length; i++) {
            chars[i].className = "char char-untyped";
          }
        }

        currentWordIndex--;
        const prevWordEl = cachedWordNodes[currentWordIndex];
        if (prevWordEl) {
          prevWordEl.classList.remove("word-completed", "word-has-error");
          prevWordEl.classList.add("active-word");
        }

        const targetWord = wordsList[currentWordIndex] || "";
        const lastMissed = missedWords[missedWords.length - 1];
        if (lastMissed === targetWord) {
          missedWords.pop();
        }

        const extras = extraCharNodes[currentWordIndex];
        if (extras && extras.length > 0) {
          while (extras.length > 0) {
            extras.pop()?.remove();
          }
        }
        const chars = cachedCharNodes[currentWordIndex] || [];
        for (let i = 0; i < chars.length; i++) {
          chars[i].className = "char char-untyped";
        }

        currentInput = "";
        wordInputs[currentWordIndex] = "";
        hiddenInput.value = "";
        updateWordOffsets(currentWordIndex);
        updateCaretPosition();
        scheduleKeystrokeEffect(() => {
          playKeyStrokeSound("Backspace", false, false);
          emitTyping('typing-backspace');
          dispatchNextChar();
        });
      }
    }

    function handleKeydown(e: KeyboardEvent) {
      ensureAudioContext();
      // Caps Lock warning: show pill + amber ring on typing area when on
      try {
        const capsOn = !!(e.getModifierState && e.getModifierState("CapsLock"));
        if (capsOn !== isCapsLockActive) {
          isCapsLockActive = capsOn;
          capsLockWarning.classList.toggle("hidden", !capsOn);
          typingDisplay.classList.toggle("!border-[#FF9F0A]/60", capsOn);
          typingDisplay.classList.toggle("!shadow-[0_0_0_3px_rgba(255,159,10,0.15)]", capsOn);
        }
      } catch {}

      // Idle resume: if paused due to inactivity, resume on any keystroke
      if (isIdlePaused && testActive && !testCompleted && e.key.length === 1) {
        resumeFromIdlePause();
      }

      // Tab to instantly restart: only hijack when a test is active or on the results screen
      const isResultsVisible = !resultsPanel.classList.contains("hidden");
      if (e.key === "Tab" && (testActive || isResultsVisible)) {
        e.preventDefault();
        resetTest();
        focusTyping();
        return;
      }

      if (e.key === "Enter" && (e.shiftKey || !resultsPanel.classList.contains("hidden"))) {
        e.preventDefault();
        resetTest();
        focusTyping();
        return;
      }

      if (e.key === "Escape") {
        if (!certModal.classList.contains("hidden")) {
          certModal.classList.add("hidden");
          return;
        }
        resetTest();
        return;
      }

      // Handle Backspace
      if (e.key === "Backspace") {
        e.preventDefault();
        if (e.ctrlKey || e.altKey || e.metaKey) {
          handleCtrlBackspace();
          return;
        }
        handleBackspace();
        return;
      }

      if (
        !testCompleted &&
        e.key.length === 1 &&
        !e.ctrlKey &&
        !e.metaKey &&
        !e.altKey
      ) {
        if (!testActive || document.activeElement !== hiddenInput || caretEl.style.opacity !== "1") {
          focusTyping();
        }
      }

      if (
        document.activeElement === hiddenInput ||
        document.activeElement === typingDisplay
      ) {
        if (e.key === " ") {
          e.preventDefault();
          handleCharacterInput(" ");
        }
        // Fast path: handle regular characters directly in keydown to bypass
        // the slow hidden-input event path (which was causing 88-112ms lag).
        if (
          testActive &&
          !testCompleted &&
          e.key.length === 1 &&
          !e.ctrlKey &&
          !e.metaKey &&
          !e.altKey &&
          e.key !== " "
        ) {
          e.preventDefault();
          handleCharacterInput(e.key);
          return;
        }
        if (testActive && (e.key === "ArrowUp" || e.key === "ArrowDown" || e.key === "ArrowLeft" || e.key === "ArrowRight")) {
          e.preventDefault();
        }
      }
    }
    window.addEventListener("keydown", handleKeydown);

    // Item 1: Window resize & ResizeObserver for zoom / container changes
    function onLayoutChange() {
      if (cachedWordNodes.length === 0) return;
      invalidateWordOffsets();
      measureLayout();
      isWordOffsetsCacheStale = false;
      updateCaretPosition();
    }

    window.addEventListener("resize", onLayoutChange);
    window.addEventListener("orientationchange", onLayoutChange);

    let resizeObserver: ResizeObserver | null = null;
    if (typeof ResizeObserver !== "undefined" && typingDisplay) {
      resizeObserver = new ResizeObserver(onLayoutChange);
      resizeObserver.observe(typingDisplay);
    }
    
    if (document.fonts) {
      document.fonts.ready.then(() => {
        invalidateWordOffsets();
        onLayoutChange();
      });
    }
    window.addEventListener("load", onLayoutChange);

    // Item 2: Gate measurement on document.fonts.ready with 350ms fallback timeout
    if (document.fonts && document.fonts.ready) {
      const timeoutPromise = new Promise<void>((resolve) => safeSetTimeout(resolve as TimerHandler, 350));
      Promise.race([document.fonts.ready, timeoutPromise]).then(() => {
        invalidateWordOffsets();
        onLayoutChange();
      });
    }

    function handleInput(e: Event) {
      const inputEv = e as InputEvent;
      const newValue = hiddenInput.value;

      // Keep the caret visible whenever keystrokes arrive. The keydown ->
      // focusTyping path can be silently lost (dropped listener, focus quirks)
      // while input events still fire, so the caret must not depend on
      // keydown alone to become visible.
      if (!testCompleted && caretEl.style.opacity !== "1") {
        caretEl.style.display = "";
        caretEl.style.opacity = "1";
      }

      if (
        inputEv.inputType === "deleteContentBackward" ||
        inputEv.inputType === "deleteWordBackward" ||
        newValue.length < currentInput.length
      ) {
        if (inputEv.inputType === "deleteWordBackward") {
          handleCtrlBackspace();
        } else {
          handleBackspace();
        }
      } else {
        let commonPrefixLen = 0;
        const minLen = Math.min(currentInput.length, newValue.length);
        while (commonPrefixLen < minLen && currentInput[commonPrefixLen] === newValue[commonPrefixLen]) {
          commonPrefixLen++;
        }
        
        const newChars = newValue.slice(commonPrefixLen);
        for (let i = 0; i < newChars.length; i++) {
          handleCharacterInput(newChars[i]);
        }
      }

      hiddenInput.value = currentInput;
    }
    hiddenInput.addEventListener("input", handleInput);



    function moveTabSlider(activeBtn: HTMLElement) {
      const slider = document.getElementById("mode-tab-slider");
      if (!slider) return;
      const applyPos = () => {
        const x = activeBtn.offsetLeft;
        const w = activeBtn.offsetWidth;
        slider.style.width = w + "px";
        slider.style.transform = `translateX(${x}px)`;
      };
      applyPos();
      requestAnimationFrame(applyPos);
    }
    const initTabBtn = document.querySelector(`[data-mode-btn="${currentMode}"]`) as HTMLElement;
    if (initTabBtn) {
      requestAnimationFrame(() => moveTabSlider(initTabBtn));
    }

    
    // Listen for nav mode switches (from header nav)
    window.addEventListener('nav-mode-switch', ((ev: CustomEvent) => {
      var mode = ev.detail;
      var btn = document.querySelector('[data-mode-btn="' + mode + '"]');
      if (btn) (btn as HTMLElement).click();
    }) as EventListener);

    window.addEventListener('start-daily-quote', ((ev: CustomEvent) => {
      const quote = ev.detail || getDailyQuote(QUOTES_BANK, new Date());
      isDailyQuoteActive = true;
      currentQuoteObj = quote;
      (window as any).__currentQuoteObj = quote;

      const quoteBtn = document.querySelector('[data-mode-btn="quote"]') as HTMLElement;
      if (quoteBtn) {
        moveTabSlider(quoteBtn);
        modeBtns.forEach((b) => {
          b.classList.remove("active-mode-btn", "!text-white", "dark:!text-black", "font-semibold");
          b.classList.add("font-medium", "text-[#6E6E73]", "dark:text-[#A1A1A6]");
        });
        quoteBtn.classList.remove("font-medium", "text-[#6E6E73]", "dark:text-[#A1A1A6]");
        quoteBtn.classList.add("active-mode-btn", "!text-white", "dark:!text-black", "font-semibold");
      }

      currentMode = "quote";
      timeOptions.classList.add("hidden");
      timeOptions.classList.remove("flex");
      wordsOptions.classList.add("hidden");
      wordsOptions.classList.remove("flex");
      customTextContainer.classList.add("hidden");
      customTextContainer.classList.remove("flex");
      typingSurfaceWrapper.classList.remove("hidden");

      resetTest();
      hiddenInput.focus();
    }) as EventListener);

    window.addEventListener("resize", () => {
      const active = document.querySelector(".mode-tab-btn.active-mode-btn") as HTMLElement
        || document.querySelector(`[data-mode-btn="${currentMode}"]`) as HTMLElement;
      if (active) moveTabSlider(active);
    });
    modeBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const mode = (btn as HTMLElement).dataset.modeBtn as
          "time" | "words" | "quote" | "custom" | "classics";
        if (mode === currentMode && !testActive && !testCompleted) {
          if (mode === "quote") {
            isDailyQuoteActive = false;
            resetTest();
          }
          return;
        }
        modeBtns.forEach((b) => {
          b.classList.remove(
            "active-mode-btn",
            "!text-white",
            "dark:!text-black",
            "font-semibold",
          );
          b.classList.add("font-medium", "text-[#6E6E73]", "dark:text-[#A1A1A6]");
        });
        btn.classList.remove("font-medium", "text-[#6E6E73]", "dark:text-[#A1A1A6]");
        btn.classList.add(
          "active-mode-btn",
          "!text-white",
          "dark:!text-black",
          "font-semibold",
        );
        moveTabSlider(btn as HTMLElement);
        (btn as HTMLElement).scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });

        currentMode = mode;
        customMistakeWords = null;
        if (mode !== "quote") {
          isDailyQuoteActive = false;
          currentQuoteObj = null;
          (window as any).__currentQuoteObj = null;
        } else {
          isDailyQuoteActive = false;
        }

        if (mode === "time") {
          timeOptions.classList.remove("hidden");
          timeOptions.classList.add("flex");
          wordsOptions.classList.add("hidden");
          wordsOptions.classList.remove("flex");
          customTextContainer.classList.add("hidden");
          customTextContainer.classList.remove("flex");
          typingSurfaceWrapper.classList.remove("hidden");
        } else if (mode === "words") {
          timeOptions.classList.add("hidden");
          timeOptions.classList.remove("flex");
          wordsOptions.classList.remove("hidden");
          wordsOptions.classList.add("flex");
          customTextContainer.classList.add("hidden");
          customTextContainer.classList.remove("flex");
          typingSurfaceWrapper.classList.remove("hidden");
        } else if (mode === "custom") {
          timeOptions.classList.add("hidden");
          timeOptions.classList.remove("flex");
          wordsOptions.classList.add("hidden");
          wordsOptions.classList.remove("flex");
          customTextContainer.classList.remove("hidden");
          customTextContainer.classList.add("flex");
          typingSurfaceWrapper.classList.add("hidden");
        } else {
          timeOptions.classList.add("hidden");
          timeOptions.classList.remove("flex");
          wordsOptions.classList.add("hidden");
          wordsOptions.classList.remove("flex");
          customTextContainer.classList.add("hidden");
          customTextContainer.classList.remove("flex");
          typingSurfaceWrapper.classList.remove("hidden");
        }

        if (mode !== "custom") {
          resetTest();
        }
      });
    });

    btnStartCustom.addEventListener("click", () => {
      customTextContainer.classList.add("hidden");
      customTextContainer.classList.remove("flex");
      typingSurfaceWrapper.classList.remove("hidden");
      resetTest();
    });

    const segControl = timeOptions.querySelector(".seg");
    if (segControl) {
      const initialRadio = segControl.querySelector<HTMLInputElement>(`input[value="${targetDuration}"]`);
      if (initialRadio) initialRadio.checked = true;
      segControl.addEventListener("change", (e) => {
        const target = e.target as HTMLInputElement;
        if (target && target.value) {
          targetDuration = parseInt(target.value, 10);
