---
import Icon from './Icon.astro';

interface Props {
  initialDuration?: number;
  initialMode?: 'time' | 'words' | 'quote' | 'custom';
  initialWordbank?: 'top200' | 'top1000' | 'numbers' | 'beginner' | 'quote';
  pageHeading?: string;
  pageSubheading?: string;
}

const {
  initialDuration = 60,
  initialMode = 'time',
  initialWordbank = 'top200',
  pageHeading = 'Typing Speed & Accuracy Test',
  pageSubheading = 'Test your typing speed with real-time Words Per Minute (WPM), accuracy, and detailed error analysis.'
} = Astro.props;
---

<div class="w-full space-y-8" id="typing-test-container" data-initial-duration={initialDuration} data-initial-mode={initialMode} data-initial-wordbank={initialWordbank}>
  <!-- Heading Section -->
  <div class="pb-6 border-b border-[#E5E5E5] dark:border-white/10">
    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-balance mb-3" style="letter-spacing:-0.02em">
      {pageHeading}
    </h1>
    <p class="text-[1.125rem] leading-[1.6] text-[#6E6E73] dark:text-[#A1A1A6] max-w-2xl">
      {pageSubheading}
    </p>
  </div>

  <!-- Mode & Configuration Bar -->
  <div class="apple-card flex flex-wrap items-center justify-between gap-3 text-sm">
    <!-- Test Type Selector -->
    <div class="flex items-center gap-1 bg-[#F5F5F7] dark:bg-white/10 p-1 rounded-full">
      <button type="button" data-mode-btn="time" class="mode-tab-btn px-4 py-1.5 rounded-full font-semibold transition-colors text-sm">
        Time
      </button>
      <button type="button" data-mode-btn="words" class="mode-tab-btn px-4 py-1.5 rounded-full font-medium transition-colors text-sm">
        Words
      </button>
      <button type="button" data-mode-btn="quote" class="mode-tab-btn px-4 py-1.5 rounded-full font-medium transition-colors text-sm">
        Quote
      </button>
      <button type="button" data-mode-btn="custom" class="mode-tab-btn px-4 py-1.5 rounded-full font-medium transition-colors text-sm">
        Custom
      </button>
    </div>

    <!-- Duration / Count Options -->
    <div id="time-options" class="flex items-center gap-1.5 font-mono">
      <span class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold">Duration:</span>
      <button type="button" data-time-val="15" class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-colors">
        15s
      </button>
      <button type="button" data-time-val="30" class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-colors">
        30s
      </button>
      <button type="button" data-time-val="60" class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-colors">
        60s
      </button>
      <button type="button" data-time-val="120" class="time-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] hover:border-[#86868B] text-xs font-medium transition-colors">
        120s
      </button>
    </div>

    <div id="words-options" class="hidden items-center gap-1.5 font-mono">
      <span class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold">Words:</span>
      <button type="button" data-word-count-val="10" class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium">10</button>
      <button type="button" data-word-count-val="25" class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium">25</button>
      <button type="button" data-word-count-val="50" class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium">50</button>
      <button type="button" data-word-count-val="100" class="word-count-btn px-2.5 py-1.5 rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/10 text-[#1D1D1F] dark:text-[#F5F5F7] text-xs font-medium">100</button>
    </div>

    <!-- Wordbank Difficulty Selector -->
    <div id="wordbank-select-container" class="flex items-center gap-1.5 font-mono">
      <label for="wordbank-select" class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold">Corpus:</label>
      <select
        id="wordbank-select"
        class="h-8 px-3 text-xs rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] cursor-pointer focus:outline-none focus:border-[#0071E3]"
      >
        <option value="top200">Common Words (Top 200)</option>
        <option value="top1000">Expanded Vocabulary (Top 1000)</option>
        <option value="numbers">Numbers & Symbols</option>
        <option value="beginner">Beginner Friendly</option>
        <option value="quote">Famous Quotes</option>
      </select>
    </div>

    <!-- Visual Theme Selector -->
    <div class="flex items-center gap-1.5 font-mono ml-auto sm:ml-0">
      <label for="theme-select" class="text-[#6E6E73] dark:text-[#A1A1A6] text-[11px] hidden sm:inline uppercase tracking-wide font-semibold">Theme:</label>
      <select
        id="theme-select"
        class="h-8 px-3 text-xs rounded-full border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] cursor-pointer focus:outline-none"
      >
        <option value="default">Default</option>
        <option value="theme-cyberpunk">Cyberpunk Neon</option>
        <option value="theme-gradient">Ocean Gradient</option>
        <option value="theme-3d">3D Embossed</option>
      </select>
    </div>
  </div>

  <!-- Custom Text Input Section -->
  <div id="custom-text-container" class="hidden flex-col gap-3 apple-card">
    <label for="custom-text-input" class="text-[0.9375rem] font-semibold text-[#1D1D1F] dark:text-[#F5F5F7]">Enter your own text to practice:</label>
    <textarea id="custom-text-input" class="w-full h-32 p-4 text-[1.125rem] leading-[1.6] rounded-xl border border-[#E5E5E5] dark:border-white/10 bg-[#FAFAFA] dark:bg-white/5 text-[#1D1D1F] dark:text-[#F5F5F7] focus:outline-none focus:border-[#0071E3] resize-none" placeholder="Paste or type your custom text here..."></textarea>
    <div class="flex justify-end">
      <button type="button" id="btn-start-custom" class="apple-btn-primary">Start Custom Test</button>
    </div>
  </div>

  <!-- Real-Time Metrics Strip -->
  <div id="metrics-strip" class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="apple-card flex items-start gap-3">
      <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#0071E3]/10 text-[#0071E3] shrink-0" aria-hidden="true">
        <Icon name="timer" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="apple-stat-label">Timer</div>
        <div id="metric-timer" class="apple-stat-value mt-1 text-[#1D1D1F] dark:text-[#F5F5F7] font-mono">60s</div>
      </div>
    </div>
    <div class="apple-card flex items-start gap-3">
      <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-[#0071E3]/10 text-[#0071E3] shrink-0" aria-hidden="true">
        <Icon name="bolt" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="apple-stat-label">Net WPM</div>
        <div id="metric-wpm" class="apple-stat-value mt-1 text-[#0071E3] font-mono">0</div>
      </div>
    </div>
    <div class="apple-card flex items-start gap-3">
      <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-600 shrink-0" aria-hidden="true">
        <Icon name="target" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="apple-stat-label">Accuracy</div>
        <div id="metric-accuracy" class="apple-stat-value mt-1 text-[#1D1D1F] dark:text-[#F5F5F7] font-mono">100%</div>
      </div>
    </div>
    <div class="apple-card flex items-start gap-3">
      <span class="flex items-center justify-center w-9 h-9 rounded-xl bg-red-500/10 text-red-600 shrink-0" aria-hidden="true">
        <Icon name="cancel" class="w-4 h-4" />
      </span>
      <div class="min-w-0">
        <div class="apple-stat-label">Errors</div>
        <div id="metric-errors" class="apple-stat-value mt-1 text-[#1D1D1F] dark:text-[#F5F5F7] font-mono">0</div>
      </div>
    </div>
  </div>

  <!-- Active Typing Surface -->
  <div id="typing-surface-wrapper" class="relative">
    <div
      id="typing-display"
      tabindex="0"
      role="textbox"
      aria-label="Typing test text area. Click or press any key to type."
      class="relative w-full min-h-[168px] p-6 font-mono text-xl sm:text-2xl leading-loose tracking-[0.01em] select-none cursor-text transition-all duration-200"
    >
      <div id="words-wrapper" class="flex flex-wrap gap-x-2 gap-y-1.5 items-center">
        <!-- Words rendered dynamically here -->
      </div>
      
      <!-- Click to focus banner -->
      <div id="focus-prompt" class="absolute inset-0 bg-white/60 dark:bg-black/40 backdrop-blur-[2px] flex items-center justify-center rounded-[20px] transition-opacity">
        <div class="px-4 py-2 rounded-full bg-[#1D1D1F] dark:bg-[#F5F5F7] text-white dark:text-black text-xs font-semibold flex items-center gap-2 shadow-lg">
          <Icon name="keyboard" class="w-4 h-4" />
          <span>Click or tap to focus and begin</span>
        </div>
      </div>
    </div>

    <!-- Hidden Mobile-Friendly Text Input -->
    <input
      type="text"
      id="hidden-typing-input"
      autocomplete="off"
      autocorrect="off"
      autocapitalize="off"
      spellcheck="false"
      class="absolute opacity-0 pointer-events-none -top-10 left-0 h-1 w-1"
      aria-hidden="true"
    />
  </div>

  <!-- Bottom Action Bar & Shortcuts -->
  <div id="action-bar" class="flex flex-wrap items-center justify-between gap-3 text-sm">
    <div class="flex items-center gap-2">
      <button
        id="btn-restart-test"
        type="button"
        class="apple-btn-secondary h-9 px-4 text-xs"
      >
        <Icon name="replay" class="w-4 h-4" />
        <span>Restart Test</span>
      </button>
      <span class="hidden sm:inline font-mono text-[11px] text-[#86868B]">
        Shortcut: <kbd class="px-1.5 py-0.5 rounded-md border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 font-sans">Tab</kbd> + <kbd class="px-1.5 py-0.5 rounded-md border border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-white/5 font-sans">Enter</kbd>
      </span>
    </div>

    <div id="quote-citation" class="hidden text-right italic font-mono text-[11px] text-[#6E6E73] dark:text-[#A1A1A6]">
      <!-- Quote author -->
    </div>
  </div>

  <!-- ── Premium Apple-Style Results Panel (inline flow, no overlap) ── -->
  <section id="results-panel" class="hidden w-full space-y-8 animate-spring-enter" aria-label="Test results">
    
    <!-- 1. Rank / Header Card -->
    <div class="apple-card text-center space-y-3">
      <div class="flex justify-center">
        <span id="res-band" class="inline-flex items-center px-3.5 py-1 rounded-full bg-[#0071E3]/10 text-[#0071E3] dark:bg-[#0071E3]/20 text-xs font-bold tracking-wide uppercase">Starting</span>
      </div>
      <h2 id="res-rank-title" class="text-3xl sm:text-4xl font-bold tracking-tight" style="letter-spacing:-0.02em">Starting</h2>
      <p class="text-[0.9375rem] text-[#6E6E73] dark:text-[#A1A1A6]">Honest skill band based on Net WPM — no inflated percentiles.</p>
    </div>

    <!-- 2. Main Score Grid — each stat is its own card, 24px padding, no overlap -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <div class="apple-card text-center">
        <div class="apple-stat-label">Net Speed</div>
        <div id="res-net-wpm" class="apple-stat-value text-[#0071E3] mt-2 font-mono">0</div>
        <div class="text-[11px] text-[#86868B] mt-2 font-medium uppercase tracking-wide">Words / Min</div>
      </div>
      <div class="apple-card text-center">
        <div class="apple-stat-label">Accuracy</div>
        <div id="res-accuracy" class="apple-stat-value mt-2 font-mono text-[#1D1D1F] dark:text-[#F5F5F7]">100%</div>
        <div class="text-[11px] text-[#86868B] mt-2 font-medium uppercase tracking-wide">Keystroke Precision</div>
      </div>
      <div class="apple-card text-center">
        <div class="apple-stat-label">Raw Speed</div>
        <div id="res-raw-wpm" class="apple-stat-value mt-2 font-mono text-[#1D1D1F] dark:text-[#F5F5F7]">0</div>
        <div class="text-[11px] text-[#86868B] mt-2 font-medium uppercase tracking-wide">Gross WPM</div>
      </div>
      <div class="apple-card text-center">
        <div class="apple-stat-label">Consistency</div>
        <div id="res-consistency" class="apple-stat-value mt-2 font-mono text-[#1D1D1F] dark:text-[#F5F5F7]">0%</div>
        <div class="text-[11px] text-[#86868B] mt-2 font-medium uppercase tracking-wide">Rhythm Stability</div>
      </div>
    </div>

    <!-- 3. Character Breakdown Card -->
    <div class="apple-card">
      <h3 class="text-sm font-bold tracking-tight mb-4" style="letter-spacing:-0.02em">Character Breakdown</h3>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-sm">
        <div class="flex flex-col gap-1 p-3 rounded-xl bg-[#FAFAFA] dark:bg-white/5 border border-[#E5E5E5]/60 dark:border-white/10">
          <span class="text-xs font-semibold uppercase tracking-wide text-[#6E6E73] dark:text-[#A1A1A6]">Correct Chars</span>
          <strong class="text-lg font-mono font-bold text-emerald-600" id="res-correct-chars">0</strong>
        </div>
        <div class="flex flex-col gap-1 p-3 rounded-xl bg-[#FAFAFA] dark:bg-white/5 border border-[#E5E5E5]/60 dark:border-white/10">
          <span class="text-xs font-semibold uppercase tracking-wide text-[#6E6E73] dark:text-[#A1A1A6]">Errors</span>
          <strong class="text-lg font-mono font-bold text-red-600" id="res-error-chars">0</strong>
        </div>
        <div class="flex flex-col gap-1 p-3 rounded-xl bg-[#FAFAFA] dark:bg-white/5 border border-[#E5E5E5]/60 dark:border-white/10">
          <span class="text-xs font-semibold uppercase tracking-wide text-[#6E6E73] dark:text-[#A1A1A6]">Total Keystrokes</span>
          <strong class="text-lg font-mono font-bold" id="res-total-keystrokes">0</strong>
        </div>
        <div class="flex flex-col gap-1 p-3 rounded-xl bg-[#FAFAFA] dark:bg-white/5 border border-[#E5E5E5]/60 dark:border-white/10">
          <span class="text-xs font-semibold uppercase tracking-wide text-[#6E6E73] dark:text-[#A1A1A6]">Duration</span>
          <strong class="text-lg font-mono font-bold" id="res-time-elapsed">60s</strong>
        </div>
      </div>
    </div>

    <!-- 4. Speed Progression Card -->
    <div class="apple-card space-y-4">
      <h3 class="text-sm font-bold tracking-tight flex items-center gap-2" style="letter-spacing:-0.02em">
        <Icon name="analytics" class="w-4 h-4 text-[#0071E3]" />
        Speed Progression
      </h3>
      <p class="text-xs text-[#6E6E73] dark:text-[#A1A1A6] -mt-2">WPM sampled each second</p>
      <div class="w-full h-36 rounded-xl bg-[#FAFAFA] dark:bg-white/[0.04] border border-[#E5E5E5] dark:border-white/10 p-3 flex items-center justify-center overflow-hidden">
        <svg id="timeline-chart-svg" class="w-full h-full" viewBox="0 0 500 100" preserveAspectRatio="none" role="img" aria-label="WPM over time">
          <!-- Dynamic path rendered in JS -->
        </svg>
      </div>
    </div>

    <!-- 5. Weak-Key Diagnostic Card -->
    <div id="weak-keys-section" class="apple-card space-y-4">
      <h3 class="text-sm font-bold tracking-tight flex items-center gap-2" style="letter-spacing:-0.02em">
        <Icon name="warning" class="w-4 h-4 text-amber-500" />
        Weak-Key Diagnostic
      </h3>
      <div id="weak-keys-list" class="flex flex-wrap gap-2 min-h-[28px]">
        <span class="text-sm text-[#6E6E73] dark:text-[#A1A1A6]">Zero errors registered. Flawless run!</span>
      </div>
      <p class="text-xs leading-relaxed text-[#86868B] pt-2 border-t border-[#E5E5E5] dark:border-white/10">Heatmap of keys with the most typos — focus your next practice on these.</p>
    </div>

    <!-- 6. Actions Card -->
    <div class="apple-card flex flex-col sm:flex-row items-center justify-center gap-3">
      <button
        id="btn-modal-restart"
        type="button"
        class="apple-btn-primary w-full sm:w-auto"
      >
        <Icon name="replay" class="w-4 h-4" />
        Restart Test
      </button>
      
      <button
        id="btn-train-mistakes"
        type="button"
        class="hidden apple-btn-secondary w-full sm:w-auto"
      >
        <Icon name="school" class="w-4 h-4" />
        <span id="train-label">Train My Mistakes</span>
      </button>

      <button
        id="btn-open-certificate"
        type="button"
        class="apple-btn-secondary w-full sm:w-auto border-[#0071E3]/20 text-[#0071E3] hover:bg-[#0071E3]/5"
      >
        <Icon name="verified-user" class="w-4 h-4" />
        View Certificate
      </button>
    </div>
  </section>

  <!-- Skill Certificate Modal (overlay isolated from page flow) -->
  <div id="certificate-modal" class="hidden fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
    <div class="w-full max-w-xl apple-card p-6 space-y-4 my-8 animate-spring-enter">
      <div class="flex items-center justify-between pb-3 border-b border-[#E5E5E5] dark:border-white/10">
        <h3 class="text-base font-bold flex items-center gap-2" style="letter-spacing:-0.02em"><Icon name="verified-user" class="w-5 h-5 text-[#0071E3]" />Typing Skill Certificate</h3>
        <button id="btn-close-certificate" type="button" class="p-2 rounded-full hover:bg-[#F5F5F7] dark:hover:bg-white/10 text-[#86868B]">
          <Icon name="close" class="w-4 h-4" />
        </button>
      </div>

      <div class="flex flex-col items-center">
        <canvas id="cert-canvas" width="800" height="500" class="w-full h-auto border border-[#E5E5E5] dark:border-white/10 rounded-xl shadow-sm"></canvas>
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-2">
        <div class="text-xs text-[#86868B] font-mono" id="cert-verification-id">ID: PTT-VERIFIED</div>
        <button
          id="btn-download-cert"
          type="button"
          class="apple-btn-primary text-xs h-9 px-4"
        >
          Download PNG Certificate
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  import { TOP_200_WORDS, TOP_1000_WORDS, NUMBERS_PUNCTUATION_WORDS, BEGINNER_WORDS, FAMOUS_QUOTES, getRandomWords } from '../data/wordbanks';
  import { calculateMetrics, saveTestResult, type MetricSummary } from '../utils/metrics';
  import { playKeyStrokeSound, ensureAudioContext } from '../utils/audio';

  const container = document.getElementById('typing-test-container');
  if (container) {
    const initialDurationAttr = parseInt(container.dataset.initialDuration || '60', 10);
    const initialModeAttr = (container.dataset.initialMode || 'time') as 'time' | 'words' | 'quote' | 'custom';
    const initialWordbankAttr = container.dataset.initialWordbank || 'top200';

    // State Variables
    let currentMode: 'time' | 'words' | 'quote' | 'custom' = initialModeAttr;
    let targetDuration = initialDurationAttr;
    let targetWordCount = 25;
    let currentWordbankName = initialWordbankAttr;
    let testActive = false;
    let testCompleted = false;

    // Timing via performance.now() and requestAnimationFrame
    let startTime = 0;
    let animationFrameId: number | null = null;
    let elapsedSeconds = 0;

    // Typing Data
    let wordsList: string[] = [];
    let currentWordIndex = 0;
    let currentInput = '';
    let correctKeystrokes = 0;
    let incorrectKeystrokes = 0;
    let secondBySecondWpm: number[] = [];
    let lastSecondRecorded = 0;
    let missedWords: string[] = [];
    let keyMistakes: Record<string, { errors: number; total: number }> = {};
    let customMistakeWords: string[] | null = null;

    // DOM Elements
    const wordsWrapper = document.getElementById('words-wrapper')!;
    const typingDisplay = document.getElementById('typing-display')!;
    const typingSurfaceWrapper = document.getElementById('typing-surface-wrapper')!;
    const metricsStrip = document.getElementById('metrics-strip')!;
    const actionBar = document.getElementById('action-bar')!;
    const hiddenInput = document.getElementById('hidden-typing-input') as HTMLInputElement;
    const focusPrompt = document.getElementById('focus-prompt')!;
    const timerMetric = document.getElementById('metric-timer')!;
    const wpmMetric = document.getElementById('metric-wpm')!;
    const accMetric = document.getElementById('metric-accuracy')!;
    const errMetric = document.getElementById('metric-errors')!;
    const restartBtn = document.getElementById('btn-restart-test')!;
    const quoteCitation = document.getElementById('quote-citation')!;
    const wordbankSelect = document.getElementById('wordbank-select') as HTMLSelectElement;
    const themeSelect = document.getElementById('theme-select') as HTMLSelectElement;
    const customTextContainer = document.getElementById('custom-text-container')!;
    const customTextInput = document.getElementById('custom-text-input') as HTMLTextAreaElement;
    const btnStartCustom = document.getElementById('btn-start-custom')!;

    // Options elements
    const timeOptions = document.getElementById('time-options')!;
    const wordsOptions = document.getElementById('words-options')!;
    const modeBtns = document.querySelectorAll('.mode-tab-btn');
    const timeBtns = document.querySelectorAll('.time-btn');
    const wordCountBtns = document.querySelectorAll('.word-count-btn');

    // Results elements
    const resultsPanel = document.getElementById('results-panel')!;
    const btnModalRestart = document.getElementById('btn-modal-restart')!;
    const btnTrainMistakes = document.getElementById('btn-train-mistakes')!;
    const btnOpenCert = document.getElementById('btn-open-certificate')!;
    const certModal = document.getElementById('certificate-modal')!;
    const btnCloseCert = document.getElementById('btn-close-certificate')!;
    const btnDownloadCert = document.getElementById('btn-download-cert')!;
    const certCanvas = document.getElementById('cert-canvas') as HTMLCanvasElement;

    let lastCompletedSummary: MetricSummary | null = null;

    function getSelectedCorpus(): string[] {
      if (customMistakeWords && customMistakeWords.length > 0) {
        return customMistakeWords;
      }
      switch (currentWordbankName) {
        case 'top1000': return TOP_1000_WORDS;
        case 'numbers': return NUMBERS_PUNCTUATION_WORDS;
        case 'beginner': return BEGINNER_WORDS;
        default: return TOP_200_WORDS;
      }
    }

    function generateWords() {
      wordsList = [];
      quoteCitation.classList.add('hidden');

      if (customMistakeWords && customMistakeWords.length > 0) {
        while (wordsList.length < 50) {
          wordsList.push(...customMistakeWords);
        }
        wordsList = wordsList.slice(0, 50);
      } else if (currentMode === 'custom') {
        const text = customTextInput.value.trim();
        if (text) {
          wordsList = text.split(/\s+/);
        } else {
          wordsList = ['Please', 'enter', 'some', 'custom', 'text', 'to', 'start', 'the', 'test.'];
        }
      } else if (currentMode === 'quote' || currentWordbankName === 'quote') {
        const quoteObj = FAMOUS_QUOTES[Math.floor(Math.random() * FAMOUS_QUOTES.length)];
        wordsList = quoteObj.text.split(' ');
        quoteCitation.textContent = `— ${quoteObj.source}`;
        quoteCitation.classList.remove('hidden');
      } else if (currentMode === 'words') {
        wordsList = getRandomWords(targetWordCount, getSelectedCorpus());
      } else {
        wordsList = getRandomWords(150, getSelectedCorpus());
      }

      currentWordIndex = 0;
      currentInput = '';
      renderWords();
    }

    function renderWords() {
      wordsWrapper.innerHTML = '';
      wordsList.forEach((word, wIdx) => {
        const wordEl = document.createElement('span');
        const isActive = wIdx === currentWordIndex;
        wordEl.className = `word inline-flex items-center transition-opacity ${isActive ? 'active-word' : ''}`;
        wordEl.dataset.wordIndex = String(wIdx);

        for (let cIdx = 0; cIdx < word.length; cIdx++) {
          const charEl = document.createElement('span');
          charEl.className = isActive ? 'char char-pending' : 'char char-untyped';
          charEl.textContent = word[cIdx];
          wordEl.appendChild(charEl);
        }

        wordsWrapper.appendChild(wordEl);
      });
      updateActiveWordDisplay();
    }

    function updateActiveWordDisplay() {
      const activeWordEl = wordsWrapper.querySelector(`[data-word-index="${currentWordIndex}"]`) as HTMLElement;
      if (!activeWordEl) return;

      const targetWord = wordsList[currentWordIndex] || '';
      const chars = activeWordEl.querySelectorAll('.char');

      activeWordEl.querySelectorAll('.caret-elem, .extra-char').forEach(el => el.remove());

      const inputLen = currentInput.length;
      for (let i = 0; i < chars.length; i++) {
        const charSpan = chars[i] as HTMLElement;
        if (i < inputLen) {
          if (currentInput[i] === targetWord[i]) {
            charSpan.className = 'char char-correct';
          } else {
            charSpan.className = 'char char-error';
          }
        } else {
          charSpan.className = 'char char-pending';
        }
      }

      if (inputLen > targetWord.length) {
        for (let i = targetWord.length; i < inputLen; i++) {
          const extraSpan = document.createElement('span');
          extraSpan.className = 'extra-char char-extra';
          extraSpan.textContent = currentInput[i];
          activeWordEl.appendChild(extraSpan);
        }
      }

      const caret = document.createElement('span');
      caret.className = 'caret-elem typing-caret inline-block w-[3px] h-[1.15em] rounded-[1px] ml-[-2px] align-[-0.1em]';
      caret.style.backgroundColor = 'var(--color-caret)';

      const allLetters = activeWordEl.querySelectorAll('.char, .extra-char');
      if (inputLen < allLetters.length) {
        activeWordEl.insertBefore(caret, allLetters[inputLen]);
      } else {
        activeWordEl.appendChild(caret);
      }

      const wrapperTop = wordsWrapper.getBoundingClientRect().top;
      const wordTop = activeWordEl.getBoundingClientRect().top;
      if (wordTop - wrapperTop > 60) {
        wordsWrapper.scrollTop += 32;
      }
    }

    function resetTest() {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      testActive = false;
      testCompleted = false;
      startTime = 0;
      elapsedSeconds = 0;
      correctKeystrokes = 0;
      incorrectKeystrokes = 0;
      secondBySecondWpm = [];
      lastSecondRecorded = 0;
      missedWords = [];
      keyMistakes = {};

      // Restore flow layout: show passage, hide results, ensure tooltip visible
      typingSurfaceWrapper.classList.remove('hidden');
      // metrics and action bar stay visible during test; results hidden
      resultsPanel.classList.add('hidden');
      focusPrompt.classList.remove('hidden');
      focusPrompt.classList.remove('opacity-0');
      focusPrompt.style.display = '';

      hiddenInput.value = '';
      timerMetric.textContent = currentMode === 'time' ? `${targetDuration}s` : (currentMode === 'words' ? `${targetWordCount}` : (currentMode === 'custom' ? `${wordsList.length}` : '0s'));
      wpmMetric.textContent = '0';
      accMetric.textContent = '100%';
      errMetric.textContent = '0';

      certModal.classList.add('hidden');
      generateWords();
      
      // Scroll passage into view
      typingSurfaceWrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
      
      if (testActive || testCompleted) {
        focusTyping();
      } else {
        blurTyping();
      }
    }

    function startTest() {
      ensureAudioContext();
      testActive = true;
      testCompleted = false;
      startTime = performance.now();
      lastSecondRecorded = 0;
      runTimerLoop();
    }

    function runTimerLoop() {
      if (!testActive) return;

      const now = performance.now();
      elapsedSeconds = (now - startTime) / 1000;

      const currentSecInt = Math.floor(elapsedSeconds);
      if (currentSecInt > lastSecondRecorded) {
        const interimMetrics = calculateMetrics(correctKeystrokes, incorrectKeystrokes, elapsedSeconds);
        secondBySecondWpm.push(interimMetrics.netWpm);
        lastSecondRecorded = currentSecInt;
      }

      if (currentMode === 'time') {
        const remaining = Math.max(0, Math.ceil(targetDuration - elapsedSeconds));
        timerMetric.textContent = `${remaining}s`;

        if (elapsedSeconds >= targetDuration) {
          finishTest();
          return;
        }
      } else if (currentMode === 'words' || currentMode === 'custom') {
        const wordsLeft = Math.max(0, wordsList.length - currentWordIndex);
        timerMetric.textContent = `${wordsLeft}`;
      } else {
        timerMetric.textContent = `${Math.floor(elapsedSeconds)}s`;
      }

      const live = calculateMetrics(correctKeystrokes, incorrectKeystrokes, elapsedSeconds);
      wpmMetric.textContent = String(live.netWpm);
      accMetric.textContent = `${live.accuracy}%`;
      errMetric.textContent = String(incorrectKeystrokes);

      animationFrameId = requestAnimationFrame(runTimerLoop);
    }

    function finishTest() {
      if (animationFrameId) {
        cancelAnimationFrame(animationFrameId);
        animationFrameId = null;
      }
      testActive = false;
      testCompleted = true;

      // Layout bug fix: hide passage + tooltip, show results in normal flow
      typingSurfaceWrapper.classList.add('hidden');
      focusPrompt.classList.add('hidden');
      focusPrompt.style.display = 'none';

      const totalTime = Math.max(elapsedSeconds, 1);
      const summary = calculateMetrics(correctKeystrokes, incorrectKeystrokes, totalTime, secondBySecondWpm);
      lastCompletedSummary = summary;

      saveTestResult({
        id: `ptt_${Date.now()}`,
        timestamp: Date.now(),
        mode: currentMode === 'time' ? `${targetDuration}s` : (currentMode === 'words' ? `${targetWordCount} words` : (currentMode === 'custom' ? 'Custom' : 'Quote')),
        durationSeconds: Math.round(totalTime),
        netWpm: summary.netWpm,
        rawWpm: summary.rawWpm,
        accuracy: summary.accuracy,
        errors: incorrectKeystrokes,
        correctChars: correctKeystrokes,
        incorrectChars: incorrectKeystrokes,
        missedWords: [...new Set(missedWords)]
      });

      showResults(summary);
    }

    function showResults(summary: MetricSummary) {
      const bandEl = document.getElementById('res-band')!;
      const rankEl = document.getElementById('res-rank-title')!;
      bandEl.textContent = summary.rankTitle;
      rankEl.textContent = summary.rankTitle;

      document.getElementById('res-net-wpm')!.textContent = String(summary.netWpm);
      document.getElementById('res-accuracy')!.textContent = `${summary.accuracy}%`;
      document.getElementById('res-raw-wpm')!.textContent = String(summary.rawWpm);
      document.getElementById('res-consistency')!.textContent = `${summary.consistency}%`;
      document.getElementById('res-correct-chars')!.textContent = String(summary.correctChars);
      document.getElementById('res-error-chars')!.textContent = String(summary.incorrectChars);
      document.getElementById('res-total-keystrokes')!.textContent = String(summary.totalKeystrokes);
      document.getElementById('res-time-elapsed')!.textContent = `${Math.round(summary.elapsedSeconds)}s`;

      renderTimelineChart(secondBySecondWpm);

      const weakKeysListEl = document.getElementById('weak-keys-list')!;
      weakKeysListEl.innerHTML = '';
      const mistakesArr = Object.entries(keyMistakes)
        .map(([key, data]) => ({ key, errors: data.errors, total: data.total }))
        .sort((a, b) => b.errors - a.errors)
        .filter(item => item.errors > 0);

      if (mistakesArr.length > 0) {
        mistakesArr.slice(0, 8).forEach(item => {
          const badge = document.createElement('span');
          badge.className = 'inline-flex items-center px-3 py-1.5 rounded-full bg-red-500/10 text-red-600 dark:text-red-400 text-xs font-semibold border border-red-500/15 whitespace-nowrap';
          badge.textContent = `‘${item.key}’ · ${item.errors} typo${item.errors > 1 ? 's' : ''}`;
          weakKeysListEl.appendChild(badge);
        });
      } else {
        weakKeysListEl.innerHTML = '<span class="text-sm font-medium text-emerald-600">Zero typos — flawless run!</span>';
      }

      const uniqueMistakes = [...new Set(missedWords)];
      if (uniqueMistakes.length > 0) {
        btnTrainMistakes.classList.remove('hidden');
        btnTrainMistakes.classList.add('inline-flex');
        const label = document.getElementById('train-label');
        if (label) label.textContent = `Train My Mistakes (${uniqueMistakes.length})`;
      } else {
        btnTrainMistakes.classList.add('hidden');
        btnTrainMistakes.classList.remove('inline-flex');
      }

      resultsPanel.classList.remove('hidden');
      // Natural scroll to results
      setTimeout(() => {
        resultsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 100);
    }

    function renderTimelineChart(data: number[]) {
      const svg = document.getElementById('timeline-chart-svg')!;
      if (!data || data.length < 2) {
        svg.innerHTML = '<text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#86868B" font-size="12" font-family="system-ui">Insufficient data for chart — try a longer test</text>';
        return;
      }

      const maxWpm = Math.max(...data, 40);
      const width = 500;
      const height = 100;
      const padding = 10;

      const points = data.map((val, idx) => {
        const x = (idx / (data.length - 1)) * (width - padding * 2) + padding;
        const y = height - ((val / maxWpm) * (height - padding * 2) + padding);
        return `${x},${y}`;
      });

      const pathData = `M ${points.join(' L ')}`;
      const isDark = document.documentElement.classList.contains('dark');
      const strokeColor = isDark ? '#0071E3' : '#0071E3';
      const gridColor = isDark ? 'rgba(255,255,255,0.08)' : '#E5E5E5';
      svg.innerHTML = `
        <line x1="${padding}" y1="${height - padding}" x2="${width - padding}" y2="${height - padding}" stroke="${gridColor}" stroke-dasharray="3 3" stroke-width="0.75" />
        <line x1="${padding}" y1="${padding}" x2="${width - padding}" y2="${padding}" stroke="${gridColor}" stroke-dasharray="3 3" stroke-width="0.75" />
        <path d="${pathData}" fill="none" stroke="${strokeColor}" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="${points[points.length-1].split(',')[0]}" cy="${points[points.length-1].split(',')[1]}" r="3" fill="${strokeColor}" />
      `;
    }

    function focusTyping() {
      if (testCompleted) return;
      hiddenInput.focus();
      focusPrompt.classList.add('opacity-0');
      typingDisplay.classList.add('!border-[#0071E3]/30');
    }

    function blurTyping() {
      if (testCompleted) return;
      focusPrompt.classList.remove('opacity-0');
      typingDisplay.classList.remove('!border-[#0071E3]/30');
    }

    typingDisplay.addEventListener('click', focusTyping);
    hiddenInput.addEventListener('focus', focusTyping);
    hiddenInput.addEventListener('blur', blurTyping);

    function handleCharacterInput(char: string) {
      if (testCompleted) return;
      if (!testActive) startTest();

      const targetWord = wordsList[currentWordIndex] || '';

      if (char === ' ') {
        if (currentInput.length === 0) return;

        const isWordCorrect = currentInput === targetWord;
        if (!isWordCorrect) {
          missedWords.push(targetWord);
          playKeyStrokeSound(true, true);
        } else {
          playKeyStrokeSound(true, false);
          correctKeystrokes += 1;
        }

        const completedWordEl = wordsWrapper.querySelector(`[data-word-index="${currentWordIndex}"]`) as HTMLElement;
        if (completedWordEl) {
          completedWordEl.classList.add('word-completed');
        }

        currentWordIndex++;
        currentInput = '';
        hiddenInput.value = '';

        if (currentWordIndex >= wordsList.length) {
          finishTest();
          return;
        }

        renderWords();
        return;
      }

      if (!keyMistakes[char]) keyMistakes[char] = { errors: 0, total: 0 };
      keyMistakes[char].total++;

      const targetChar = targetWord[currentInput.length];
      const isCorrectChar = char === targetChar;

      if (isCorrectChar) {
        correctKeystrokes++;
        playKeyStrokeSound(false, false);
      } else {
        incorrectKeystrokes++;
        keyMistakes[char].errors++;
        playKeyStrokeSound(false, true);
      }

      currentInput += char;
      updateActiveWordDisplay();
    }

    function handleBackspace() {
      if (testCompleted) return;
      if (currentInput.length > 0) {
        currentInput = currentInput.slice(0, -1);
        updateActiveWordDisplay();
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.shiftKey) {
        resetTest();
        return;
      }

      if (!resultsPanel.classList.contains('hidden') && e.key === 'Enter') {
        resetTest();
        return;
      }

      if (e.key === 'Escape') {
        if (!certModal.classList.contains('hidden')) {
          certModal.classList.add('hidden');
          return;
        }
        resetTest();
        return;
      }

      if (!testActive && !testCompleted && e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
        focusTyping();
      }

      if (document.activeElement === hiddenInput || document.activeElement === typingDisplay) {
        if (e.key === 'Backspace') {
          e.preventDefault();
          handleBackspace();
        } else if (e.key === ' ' || (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey)) {
          e.preventDefault();
          handleCharacterInput(e.key);
        }
      }
    });

    hiddenInput.addEventListener('input', (e: Event) => {
      const inputEv = e as InputEvent;
      
      if (inputEv.inputType === 'deleteContentBackward' || hiddenInput.value.length < currentInput.length) {
        handleBackspace();
      } else if (inputEv.data) {
        const val = inputEv.data;
        for (let i = 0; i < val.length; i++) {
          handleCharacterInput(val[i]);
        }
      } else if (hiddenInput.value.length > currentInput.length) {
        const val = hiddenInput.value.slice(currentInput.length);
        for (let i = 0; i < val.length; i++) {
          handleCharacterInput(val[i]);
        }
      }
      
      hiddenInput.value = currentInput;
    });

    window.addEventListener('keydown', () => {
      setTimeout(() => {
        if (document.activeElement === hiddenInput) {
          hiddenInput.value = currentInput;
        }
      }, 0);
    });

    modeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        modeBtns.forEach(b => b.classList.remove('bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-semibold'));
        btn.classList.add('bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-semibold');

        const mode = (btn as HTMLElement).dataset.modeBtn as 'time' | 'words' | 'quote' | 'custom';
        currentMode = mode;
        customMistakeWords = null;

        if (mode === 'time') {
          timeOptions.classList.remove('hidden');
          timeOptions.classList.add('flex');
          wordsOptions.classList.add('hidden');
          wordsOptions.classList.remove('flex');
          customTextContainer.classList.add('hidden');
          customTextContainer.classList.remove('flex');
          typingSurfaceWrapper.classList.remove('hidden');
        } else if (mode === 'words') {
          timeOptions.classList.add('hidden');
          timeOptions.classList.remove('flex');
          wordsOptions.classList.remove('hidden');
          wordsOptions.classList.add('flex');
          customTextContainer.classList.add('hidden');
          customTextContainer.classList.remove('flex');
          typingSurfaceWrapper.classList.remove('hidden');
        } else if (mode === 'custom') {
          timeOptions.classList.add('hidden');
          timeOptions.classList.remove('flex');
          wordsOptions.classList.add('hidden');
          wordsOptions.classList.remove('flex');
          customTextContainer.classList.remove('hidden');
          customTextContainer.classList.add('flex');
          typingSurfaceWrapper.classList.add('hidden');
        } else {
          timeOptions.classList.add('hidden');
          timeOptions.classList.remove('flex');
          wordsOptions.classList.add('hidden');
          wordsOptions.classList.remove('flex');
          customTextContainer.classList.add('hidden');
          customTextContainer.classList.remove('flex');
          typingSurfaceWrapper.classList.remove('hidden');
        }

        if (mode !== 'custom') {
          resetTest();
        }
      });
    });

    btnStartCustom.addEventListener('click', () => {
      customTextContainer.classList.add('hidden');
      customTextContainer.classList.remove('flex');
      typingSurfaceWrapper.classList.remove('hidden');
      resetTest();
    });

    timeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        timeBtns.forEach(b => b.classList.remove('font-semibold', 'bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black', '!border-[#1D1D1F]'));
        btn.classList.add('font-semibold', 'bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black', '!border-[#1D1D1F]');
        targetDuration = parseInt((btn as HTMLElement).dataset.timeVal || '60', 10);
        resetTest();
      });
    });

    wordCountBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        wordCountBtns.forEach(b => b.classList.remove('font-semibold', 'bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black'));
        btn.classList.add('font-semibold', 'bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black');
        targetWordCount = parseInt((btn as HTMLElement).dataset.wordCountVal || '25', 10);
        resetTest();
      });
    });

    wordbankSelect.addEventListener('change', () => {
      currentWordbankName = wordbankSelect.value;
      customMistakeWords = null;
      resetTest();
    });

    restartBtn.addEventListener('click', resetTest);
    btnModalRestart.addEventListener('click', resetTest);

    btnTrainMistakes.addEventListener('click', () => {
      const uniqueMistakes = [...new Set(missedWords)];
      if (uniqueMistakes.length > 0) {
        customMistakeWords = uniqueMistakes;
        resultsPanel.classList.add('hidden');
        resetTest();
      }
    });

    btnOpenCert.addEventListener('click', () => {
      if (!lastCompletedSummary) return;
      generateCertificateCanvas(lastCompletedSummary);
      certModal.classList.remove('hidden');
    });

    btnCloseCert.addEventListener('click', () => certModal.classList.add('hidden'));
    certModal.addEventListener('click', (e) => {
      if (e.target === certModal) certModal.classList.add('hidden');
    });

    async function generateCertificateCanvas(summary: MetricSummary) {
      if (document.fonts) {
        await document.fonts.ready;
      }

      const ctx = certCanvas.getContext('2d');
      if (!ctx) return;

      const w = certCanvas.width;
      const h = certCanvas.height;

      ctx.fillStyle = '#000000';
      ctx.fillRect(0, 0, w, h);

      ctx.strokeStyle = 'rgba(255,255,255,0.12)';
      ctx.lineWidth = 1;
      ctx.strokeRect(16, 16, w - 32, h - 32);

      ctx.fillStyle = '#0071E3';
      ctx.font = '600 13px "Inter Variable", system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText('OFFICIAL PERFORMANCE CERTIFICATE', w / 2, 70);

      ctx.fillStyle = '#F5F5F7';
      ctx.font = '700 28px "Inter Variable", system-ui, sans-serif';
      ctx.fillText('PRACTICE TEST TYPING', w / 2, 110);

      ctx.fillStyle = '#A1A1A6';
      ctx.font = '400 13px "Inter Variable", system-ui, sans-serif';
      ctx.fillText('This certifies that the candidate demonstrated verifiable typing proficiency.', w / 2, 140);

      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.beginPath();
      ctx.moveTo(80, 165);
      ctx.lineTo(w - 80, 165);
      ctx.stroke();

      const col1 = w / 2 - 180;
      const col2 = w / 2;
      const col3 = w / 2 + 180;

      ctx.fillStyle = '#0071E3';
      ctx.font = '700 42px "JetBrains Mono Variable", monospace';
      ctx.fillText(String(summary.netWpm), col1, 235);
      ctx.fillStyle = '#A1A1A6';
      ctx.font = '500 11px "Inter Variable", sans-serif';
      ctx.fillText('NET WPM', col1, 260);

      ctx.fillStyle = '#34C759';
      ctx.font = '700 42px "JetBrains Mono Variable", monospace';
      ctx.fillText(`${summary.accuracy}%`, col2, 235);
      ctx.fillStyle = '#A1A1A6';
      ctx.font = '500 11px "Inter Variable", sans-serif';
      ctx.fillText('ACCURACY', col2, 260);

      ctx.fillStyle = '#F5F5F7';
      ctx.font = '700 42px "JetBrains Mono Variable", monospace';
      ctx.fillText(`${summary.consistency}%`, col3, 235);
      ctx.fillStyle = '#A1A1A6';
      ctx.font = '500 11px "Inter Variable", sans-serif';
      ctx.fillText('CONSISTENCY', col3, 260);

      ctx.fillStyle = '#F5F5F7';
      ctx.font = '600 18px "Inter Variable", sans-serif';
      ctx.fillText(summary.rankTitle, w / 2, 315);

      ctx.strokeStyle = 'rgba(255,255,255,0.08)';
      ctx.beginPath();
      ctx.moveTo(80, 350);
      ctx.lineTo(w - 80, 350);
      ctx.stroke();

      const verificationId = `PTT-${Date.now().toString(36).toUpperCase()}-${Math.floor(Math.random() * 9000 + 1000)}`;
      document.getElementById('cert-verification-id')!.textContent = `Certificate ID: ${verificationId}`;

      ctx.fillStyle = '#86868B';
      ctx.font = '400 10px "JetBrains Mono Variable", monospace';
      ctx.textAlign = 'left';
      ctx.fillText(`Verification ID: ${verificationId}`, 80, 390);
      ctx.fillText(`Date: ${new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}`, 80, 410);

      ctx.textAlign = 'right';
      ctx.fillText('Certified at: practicetesttyping.com', w - 80, 390);
      ctx.fillText('International 5-Stroke Standard', w - 80, 410);
    }

    btnDownloadCert.addEventListener('click', () => {
      const link = document.createElement('a');
      link.download = `practice-test-typing-certificate-${Date.now()}.png`;
      link.href = certCanvas.toDataURL('image/png');
      link.click();
    });

    themeSelect.addEventListener('change', () => {
      const selectedTheme = themeSelect.value;
      container.classList.remove('theme-cyberpunk', 'theme-gradient', 'theme-3d');
      if (selectedTheme !== 'default') {
        container.classList.add(selectedTheme);
      }
    });

    const defaultModeBtn = document.querySelector(`[data-mode-btn="${initialModeAttr}"]`);
    if (defaultModeBtn) {
      defaultModeBtn.classList.add('bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black', 'font-semibold');
    }
    const defaultTimeBtn = document.querySelector(`[data-time-val="${initialDurationAttr}"]`);
    if (defaultTimeBtn) {
      defaultTimeBtn.classList.add('font-semibold', 'bg-[#1D1D1F]', 'text-white', 'dark:bg-white', 'dark:text-black', '!border-[#1D1D1F]');
    }
    if (wordbankSelect) {
      wordbankSelect.value = initialWordbankAttr;
    }

    resetTest();
  }
</script>
