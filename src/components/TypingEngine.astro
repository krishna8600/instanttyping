      // Roast Mode Logic
      if (roastModeEnabled && roastCard && roastText && roastVideo && roastImg) {
        const roastQuotesLowWpm = [
          t("roast.low_wpm_1"),
          t("roast.low_wpm_2"),
          t("roast.low_wpm_3"),
          t("roast.low_wpm_4"),
          t("roast.low_wpm_5"),
          t("roast.low_wpm_6"),
        ];
        const roastQuotesLowAcc = [
          t("roast.low_acc_1"),
          t("roast.low_acc_2"),
          t("roast.low_acc_3"),
          t("roast.low_acc_4"),
          t("roast.low_acc_5"),
          t("roast.low_acc_6"),
        ];
        const roastQuotesGood = [
          t("roast.good_1"),
          t("roast.good_2"),
          t("roast.good_3"),
          t("roast.good_4"),
          t("roast.good_5"),
          t("roast.good_6"),
        ];
        
        let roast = "";
