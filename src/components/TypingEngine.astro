          border-radius: 50%;
          box-shadow: 0 12px 40px rgba(0,0,0,.45);
          border: 1px solid rgba(255,255,255,.12);
        }
        #mascot-fallback {
          width: 100%; height: 100%; object-fit: cover;
          border-radius: 50%;
          box-shadow: 0 12px 40px rgba(0,0,0,.45);
          border: 1px solid rgba(255,255,255,.12);
        }
        #mascot-fallback.hidden { display: none; }
        #mascot-wrap.mascot-hidden { display: none; }
        @media (max-width: 1023px) {
          #mascot-wrap { width: 72px; height: 72px; margin: 14px auto 0; }
        }
        @media (min-width: 1440px) {
          #mascot-wrap {
            position: fixed; right: 3%; top: 30%; z-index: 5;
          }
        }
        /* Moods — transform/opacity only */
        #mascot.m-idle, #mascot-fallback.m-idle { animation: m-bounce 1.8s ease-in-out infinite; }
        @keyframes m-bounce {
          0%,100% { transform: translateY(0) scale(1); }
          50% { transform: translateY(-10px) scale(1.03); }
        }
        
#mascot-video { width: 100%; height: 100%; object-fit: cover; border-radius: inherit; }
#mascot.m-typing, #mascot-fallback.m-typing { animation: m-work .25s ease-in-out infinite; }
        @keyframes m-work {
          0%,100% { transform: translateY(0) scale(1); }
          50% { transform: translateY(-7px) scale(1.03); }
        }
        #mascot.m-typing.m-tap, #mascot-fallback.m-typing.m-tap { animation: m-tap .1s ease-out; }
        @keyframes m-tap {
          0% { transform: translateY(-7px) scale(1.04); }
          50% { transform: translateY(5px) scale(.98); }
          100% { transform: translateY(-7px) scale(1.04); }
        }
        #mascot.m-shock, #mascot-fallback.m-shock { animation: m-shake .28s ease-in-out 2; }
        @keyframes m-shake {
          0%,100% { transform: translateX(0) scale(1.05); }
          25% { transform: translateX(-5px) scale(1.05); }
          75% { transform: translateX(5px) scale(1.05); }
        }
        #mascot.m-slow, #mascot-fallback.m-slow { animation: m-snooze 2.6s ease-in-out infinite; filter: saturate(.7) brightness(.85); }
        @keyframes m-snooze {
          0%,100% { transform: translateY(0); }
          50% { transform: translateY(5px); }
        }
        #mascot.m-roast, #mascot-fallback.m-roast { animation: m-smug .6s ease-in-out infinite; }
        @keyframes m-smug {
          0%,100% { transform: translateY(0) scale(1.05); }
          50% { transform: translateY(-6px) scale(1.05); }
        }
        @media (prefers-reduced-motion: reduce) {
          #mascot, #mascot-fallback { animation: none !important; }
        }
      
/* FORCE CIRCULAR MASCOT */
#mascot-wrap { border-radius: 50% !important; overflow: hidden !important; }
#mascot-wrap #mascot, #mascot-wrap img#mascot { border-radius: 50% !important; object-fit: cover !important; }
#mascot-wrap #mascot-video { border-radius: 50% !important; object-fit: cover !important; }
</style>
