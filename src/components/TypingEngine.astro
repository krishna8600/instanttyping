    function handleLanguageChange(e: any) {
      const lang = e.detail?.language;
      if (!testActive) {
        if (["top1000", "top200", "es", "fr", "de", "pt", "it"].includes(currentWordbankName)) {
          if (["es", "fr", "de", "pt", "it"].includes(lang)) {
