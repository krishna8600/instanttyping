      // Initialize the sound theme from local storage
      soundSelect.value = initSoundThemeFromStorage();
      
      // Update the sound theme and play a preview note on change
      soundSelect.addEventListener("change", () => {
        setSoundTheme(soundSelect.value as any);
        // Play a preview sound (isSpace=false, isError=false)
        playKeyStrokeSound("a", false, false);
      });
    }

    if (volumeSlider) {
      volumeSlider.value = String(getVolume());
      volumeSlider.addEventListener("input", (e) => {
        const vol = parseInt((e.target as HTMLInputElement).value, 10);
        setVolume(vol);
      });
      volumeSlider.addEventListener("change", () => {
        playKeyStrokeSound("a", false, false);
      });
    }

    if (backspaceSelect) {
      backspaceSelect.value = selectedBackspaceMode;
      backspaceSelect.addEventListener("change", () => {
        selectedBackspaceMode = backspaceSelect.value === "current" ? "current" : "full";
        try {
          localStorage.setItem("ptt_backspace_mode", selectedBackspaceMode);
        } catch {}
        if (!testActive) {
          activeBackspaceMode = selectedBackspaceMode;
        }
      });
    }

    if (stopOnErrorSelect) {
      stopOnErrorSelect.value = selectedStopOnError;
      stopOnErrorSelect.addEventListener("change", () => {
        selectedStopOnError = stopOnErrorSelect.value === "on" ? "on" : "off";
        try {
          localStorage.setItem("it_stop_on_error", selectedStopOnError);
        } catch {}
      });
    }

    if (roastModeSelect) {
      roastModeSelect.value = roastModeEnabled ? "on" : "off";
      roastModeSelect.addEventListener("change", (e) => {
        roastModeEnabled = (e.target as HTMLSelectElement).value === "on";
        try {
          localStorage.setItem("it_roast_mode", roastModeEnabled ? "on" : "off");
        } catch {}
      });
    }

    const currentLang = getLanguage();
    if (["es", "fr", "de", "pt", "it"].includes(currentLang) && ["top1000", "top200"].includes(currentWordbankName)) {
      currentWordbankName = currentLang;
      wordbankSelect.value = currentLang;
    }

    function showAchievementToast(ach: { name: string; tier: string; icon: string; description?: string }) {
      notify({
        title: `Achievement unlocked: ${ach.name}`,
        description: `${ach.tier} · ${ach.description || ach.name}`,
        icon: 'trophy',
      });
    }

    const resultsDockContainer = document.getElementById("results-dock");
    if (resultsDockContainer) {
      resultsDockContainer.innerHTML = "";
      const copyBtnEl = createCopyButton({
        idleLabel: "Copy results",
        doneLabel: "Copied!",
        getValue: async () => {
          const mod = await import("../scripts/share-card");
          const data = (window as any).__buildShareData ? await (window as any).__buildShareData() : {
            wpm: lastCompletedSummary ? lastCompletedSummary.netWpm : 0,
            accuracy: lastCompletedSummary ? lastCompletedSummary.accuracy : 100,
            consistency: lastCompletedSummary ? lastCompletedSummary.consistency : 100,
            date: new Date().toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
          };
          return mod.generateShareText(data);
        },
        onStateChange: (state) => {
          copyBtnEl.dataset.label = state === "copied" ? "Copied!" : "Copy results";
          if (state === "copied") {
            notify({ title: "Copied!", description: "Results copied to clipboard", icon: "copy" });
          }
        },
      });

      createDock(resultsDockContainer, [
        { icon: "restart", label: "Try again", onClick: resetTest },
        { icon: "next", label: "Next test", onClick: resetTest },
        {
          icon: "target",
          label: "Train mistakes",
          onClick: () => {
            const uniqueMistakes = [...new Set(missedWords)];
            if (uniqueMistakes.length > 0) {
              customMistakeWords = uniqueMistakes;
              resultsPanel.classList.add("hidden");
              resetTest();
            } else {
              notify({ title: "Flawless!", description: "No mistakes to train on this run.", icon: "check" });
            }
          },
        },
        {
          icon: "award",
          label: "Certificate",
          onClick: () => {
            const summary = lastCompletedSummary || (window as any).__lastTestSummary;
            if (summary) {
              generateCertificateCanvas(summary);
              certModal.classList.remove("hidden");
            }
          },
        },
        {
          icon: "download",
          label: "Download PNG",
          onClick: async () => {
            try {
              const mod = await import("../scripts/share-card");
              const data = (window as any).__buildShareData ? await (window as any).__buildShareData() : {
                wpm: lastCompletedSummary ? lastCompletedSummary.netWpm : 0,
                accuracy: lastCompletedSummary ? lastCompletedSummary.accuracy : 100,
                consistency: lastCompletedSummary ? lastCompletedSummary.consistency : 100,
                date: new Date().toLocaleDateString("en-US", { month: "short", day: "numeric", year: "numeric" }),
              };
              await mod.downloadShareImage(data);
            } catch (err) {
              console.error("Download failed:", err);
            }
          },
        },
        {
          label: "Copy results",
          element: copyBtnEl,
        },
      ]);
    }

    resetTest();
    // Auto-focus on load so user can start typing immediately
    safeSetTimeout(() => focusTyping(), 50);

    const cleanup = () => {
      window.removeEventListener("keydown", handleKeydown);
      window.removeEventListener("resize", onLayoutChange);
      window.removeEventListener("instanttyping:languagechange", handleLanguageChange);
      if (hiddenInput) {
        hiddenInput.removeEventListener("focus", focusTyping);
        hiddenInput.removeEventListener("blur", blurTyping);
        hiddenInput.removeEventListener("input", handleInput);
      }
      if (resizeObserver) {
        resizeObserver.disconnect();
      }
      __activeTimeouts.forEach(clearTimeout);
    };
    (window as any).__typingEngineCleanup = cleanup;
    document.addEventListener("astro:before-swap", cleanup, { once: true });
  }

    // Chart Interactivity
    const chartSvg = document.getElementById("timeline-chart-svg");
    const chartTooltip = document.getElementById("chart-tooltip");
    
    if (chartSvg && chartTooltip) {
      function updateCrosshair(e: Event) {
        const pointerEvent = e as PointerEvent;
        const data = (chartSvg as any).__chartData;
        if (!data || data.length < 2) return;
        
        const svgRect = chartSvg!.getBoundingClientRect();
        const rawX = ((pointerEvent.clientX - svgRect.left) / svgRect.width) * 500;
        
        let nearest = data[0];
        let minDist = Infinity;
        for (const pt of data) {
          const dist = Math.abs(pt.x - rawX);
          if (dist < minDist) {
            minDist = dist;
            nearest = pt;
          }
        }
        
        const layer = document.getElementById("chart-interactive-layer");
        const line = document.getElementById("chart-crosshair-line");
        const dot = document.getElementById("chart-crosshair-dot");
        
        if (layer && line && dot) {
          line.setAttribute("x1", nearest.x.toString());
          line.setAttribute("x2", nearest.x.toString());
          dot.setAttribute("cx", nearest.x.toString());
          dot.setAttribute("cy", nearest.y.toString());
          layer.classList.remove("opacity-0");
        }
        
        const card = chartSvg!.closest('.premium-card') as HTMLElement;
        if (!card) return;
        const cardRect = card.getBoundingClientRect();
        let domX = (nearest.x / 500) * svgRect.width + (svgRect.left - cardRect.left);
        const domY = (nearest.y / 100) * svgRect.height + (svgRect.top - cardRect.top);
        
        const avg = (chartSvg as any).__avgWpm;
        const delta = Math.round(nearest.val - avg);
        const deltaStr = (delta >= 0 ? '+' : '') + delta;
        chartTooltip!.textContent = `${Math.round(nearest.val)} WPM · ${nearest.sec}s · ${deltaStr} vs avg`;
        
        // Clamp tooltip so it doesn't overflow the card edges (accounting for -translate-x-1/2)
        const tooltipRect = chartTooltip!.getBoundingClientRect();
        const halfW = tooltipRect.width / 2;
        const minX = halfW + 4;
        const maxX = cardRect.width - halfW - 4;
        domX = Math.max(minX, Math.min(domX, maxX));
        
        chartTooltip!.style.left = `${domX}px`;
        chartTooltip!.style.top = `${domY}px`;
        chartTooltip!.classList.remove("opacity-0");
      }
      
      function hideCrosshair() {
        const layer = document.getElementById("chart-interactive-layer");
        if (layer) layer.classList.add("opacity-0");
        if (chartTooltip) chartTooltip.classList.add("opacity-0");
      }
      
      chartSvg.addEventListener("pointermove", updateCrosshair as EventListener);
      chartSvg.addEventListener("pointerdown", updateCrosshair as EventListener);
      chartSvg.addEventListener("pointerleave", hideCrosshair);
      chartSvg.addEventListener("pointercancel", hideCrosshair);
    }

    // Shareable results: downloadable PNG result card + one-click copy summary (Task 2)
    (function() {
      async function buildShareData(): Promise<import('../scripts/share-card').ShareData> {
        var summary = lastCompletedSummary || (window as any).__lastTestSummary;
        var wpmEl = document.getElementById('res-net-wpm');
        var accEl = document.getElementById('res-accuracy');
        var consEl = document.getElementById('res-consistency');
        var rankEl = document.getElementById('res-rank-title');
        var wpm = summary ? summary.netWpm : (wpmEl ? parseInt(wpmEl.textContent || '0', 10) : 0);
        var acc = summary ? summary.accuracy : (accEl ? parseFloat(accEl.textContent || '100') : 100);
        var consistency = summary ? summary.consistency : (consEl ? parseInt(consEl.textContent || '100', 10) : 100);
        var rank = summary ? summary.rankTitle : (rankEl ? (rankEl.textContent || 'Typist').trim() : 'Typist');
        return {
          wpm: wpm,
          accuracy: acc,
          consistency: consistency,
          rank: rank,
          date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }),
        };
      }
      (window as any).__buildShareData = buildShareData;

      var downloadBtn = document.getElementById('btn-download-card');
      if (downloadBtn) {
        downloadBtn.addEventListener('click', async function() {
          try {
            var mod = await import('../scripts/share-card');
            var data = await buildShareData();
            await mod.downloadShareImage(data);
          } catch (err) {
            console.error('Download card failed:', err);
          }
        });
      }

      var copyBtn = document.getElementById('btn-copy-result');
      var copyLabel = document.getElementById('copy-result-label');
      if (copyBtn) {
        copyBtn.addEventListener('click', async function() {
          try {
            var mod = await import('../scripts/share-card');
            var data = await buildShareData();
            var success = await mod.copyShareText(data);
            if (success) {
              notify({
                title: 'Copied to clipboard',
                icon: 'copy',
                duration: 2500,
              });
            }
            if (copyLabel) {
              var originalText = copyLabel.textContent;
              copyLabel.textContent = success ? 'Copied!' : 'Copied!';
              setTimeout(function() {
                if (copyLabel) copyLabel.textContent = originalText;
              }, 2000);
            }
          } catch (err) {
            console.error('Copy result failed:', err);
          }
        });
      }

      var shareBtn = document.getElementById('btn-share-result');
      if (shareBtn) {
        shareBtn.addEventListener('click', async function() {
          try {
            var mod = await import('../scripts/share-card');
            var data = await buildShareData();
            await mod.downloadShareImage(data);
          } catch (err) {
            console.error('Share failed:', err);
          }
        });
      }
    })();
</script>

















