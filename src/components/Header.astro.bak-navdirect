---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const navItems = [
  { href: "/", label: "Typing Test", key: "nav.test" },
  { href: "/?mode=classics", label: "Classics", key: "nav.classics" },
  { href: "/typing-test-for-beginners", label: "Beginners", key: "nav.beginners" },
  { href: "/numbers-punctuation-typing-test", label: "Numbers", key: "nav.numbers" },
  { href: "/?mode=quote", label: "Quotes", key: "nav.quotes" },
];
---

<div class="header-wrapper">
<header class="pill-nav" role="banner" aria-label="Site header" data-i18n-aria-label="header.aria_site">
  <a href="/" class="brand" aria-label="Instant Typing — Home" data-i18n-aria-label="header.aria_home">
    <img
      src="/favicon.svg"
      alt="Instant Typing"
      width="32"
      height="32"
      class="w-8 h-8 rounded-md"
    />
    <span class="brand-text">Instant Typing</span>
  </a>

  <nav aria-label="Main Navigation" data-i18n-aria-label="header.aria_main_nav">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <a
            href={item.href}
            class={isActive ? "active" : ""}
            aria-current={isActive ? "page" : undefined}
            data-i18n={item.key || undefined}
          >
            {item.label}
          </a>
        );
      })
    }
  </nav>

  <div class="nav-actions">
    <div class="sound-control-container relative" id="sound-control-container">
      <button
        id="btn-sound-toggle"
        class="icon-btn sound-btn"
        type="button"
        aria-label="Toggle keyboard sound" data-i18n-aria-label="header.aria_sound"
        aria-pressed="false"
        aria-expanded="false"
        title="Toggle key sounds" data-i18n-title="header.title_sound"
      >
        <!-- High Volume Icon -->
        <span id="sound-icon-high" class="flex items-center justify-center">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
        </span>
        <!-- Low Volume Icon -->
        <span id="sound-icon-low" class="hidden flex items-center justify-center">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
        </span>
        <!-- Muted Icon -->
        <span id="sound-icon-off" class="hidden flex items-center justify-center">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </span>
        <!-- Caret Icon -->
        <span id="sound-caret" class="sound-caret flex items-center justify-center" aria-hidden="true">
          <svg
            width="8"
            height="8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>
      </button>

      <!-- Volume Popover -->
      <div
        id="volume-popover"
        class="volume-popover hidden"
        role="dialog"
        aria-label="Volume control popover" data-i18n-aria-label="header.aria_volume_popover"
      >
        <div class="popover-inner">
          <div class="popover-header">
            <span class="popover-title"><span data-i18n="header.volume">Volume</span></span>
            <span id="volume-val-display" class="volume-val-display">70%</span>
          </div>
          <div class="slider-wrapper">
            <input
              type="range"
              id="volume-slider"
              min="0"
              max="100"
              value="70"
              step="1"
              aria-label="Keyboard sound volume" data-i18n-aria-label="header.aria_volume_slider"
              class="volume-range-input"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<LanguageSwitcher />

<button
  id="btn-theme-toggle"
  class="icon-btn theme-toggle-floating"
  type="button"
  aria-label="Toggle color theme" data-i18n-aria-label="header.aria_theme"
  title="Toggle Light / Dark Mode" data-i18n-title="header.title_theme"
>
  <span
    id="theme-icon-sun"
    class="hidden dark:block flex items-center justify-center"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      ><circle cx="12" cy="12" r="4"></circle><path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path></svg
    >
  </span>
  <span
    id="theme-icon-moon"
    class="block dark:hidden flex items-center justify-center"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      ></path></svg
    >
  </span>
</button>
</div>

<style>
  .header-wrapper {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 100;
    max-width: calc(100vw - 24px);
  }
  .pill-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(12, 12, 14, 0.65);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 8px 14px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }
  .pill-nav .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-right: 8px;
  }
  .brand-text {
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    white-space: nowrap;
  }
  .pill-nav nav {
    display: flex;
    gap: 2px;
  }
  .pill-nav nav a {
    color: #a1a1a6;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 999px;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .pill-nav nav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }
  .pill-nav nav a.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.13);
  }
  .nav-actions {
    display: flex;
    gap: 4px;
    margin-left: 6px;
  }
  .sound-control-container {
    position: relative;
    display: inline-block;
  }
  .icon-btn {
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #d7d7db;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .sound-btn {
    padding-left: 10px;
    padding-right: 7px;
    gap: 2px;
  }
  .sound-caret {
    opacity: 0.6;
    transition: opacity 0.2s, transform 0.2s;
    margin-left: 1px;
  }
  .sound-btn:hover .sound-caret {
    opacity: 1;
  }
  .sound-btn[aria-expanded="true"] .sound-caret {
    transform: rotate(180deg);
    opacity: 1;
  }
  .theme-toggle-floating {
    width: 36px;
    border-radius: 50%;
    flex-shrink: 0;
    background: rgba(12, 12, 14, 0.65);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .theme-toggle-floating:hover {
    background: rgba(40, 40, 44, 0.65);
  }
  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .icon-btn:focus-visible {
    outline: 2px solid #0070f3;
    outline-offset: 2px;
  }

  /* Popover Styling */
  .volume-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 170px;
    background: rgba(16, 16, 18, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    z-index: 200;
    animation: popoverFadeIn 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes popoverFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .popover-inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #a1a1a6;
  }

  .volume-val-display {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #0072F5;
    font-weight: 700;
  }

  .slider-wrapper {
    display: flex;
    align-items: center;
    height: 20px;
  }

  /* Custom Range Slider */
  .volume-range-input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    outline: none;
    cursor: pointer;
  }

  .volume-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #0072F5;
    box-shadow: 0 0 8px rgba(0, 114, 245, 0.5);
    cursor: pointer;
    transition: transform 0.1s ease, background-color 0.1s ease;
  }

  .volume-range-input::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background: #298bff;
  }

  .volume-range-input::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: none;
    border-radius: 50%;
    background: #0072F5;
    box-shadow: 0 0 8px rgba(0, 114, 245, 0.5);
    cursor: pointer;
    transition: transform 0.1s ease, background-color 0.1s ease;
  }

  .volume-range-input::-moz-range-thumb:hover {
    transform: scale(1.15);
    background: #298bff;
  }

  .volume-range-input:focus-visible {
    outline: 2px solid #0072F5;
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .brand-text {
      display: none;
    }
    .pill-nav nav a {
      padding: 8px 10px;
      font-size: 13px;
    }
  }
  @media (max-width: 640px) {
    .pill-nav {
      gap: 2px;
      padding: 6px 8px 6px 10px;
    }
    .pill-nav nav {
      overflow-x: auto;
      scrollbar-width: none;
    }
    .pill-nav nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  import {
    toggleAudio,
    initAudioFromStorage,
    ensureAudioContext,
    setVolume,
    playKeyStrokeSound,
  } from "../utils/audio";

  const soundContainer = document.getElementById("sound-control-container");
  const soundBtn = document.getElementById("btn-sound-toggle");
  const soundIconHigh = document.getElementById("sound-icon-high");
  const soundIconLow = document.getElementById("sound-icon-low");
  const soundIconOff = document.getElementById("sound-icon-off");
  const volumePopover = document.getElementById("volume-popover");
  const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement | null;
  const volumeValDisplay = document.getElementById("volume-val-display");

  function syncAudioUI() {
    const { enabled, volume, iconState } = initAudioFromStorage();

    if (soundIconHigh && soundIconLow && soundIconOff) {
      soundIconHigh.classList.add("hidden");
      soundIconLow.classList.add("hidden");
      soundIconOff.classList.add("hidden");

      if (iconState === "high") {
        soundIconHigh.classList.remove("hidden");
      } else if (iconState === "low") {
        soundIconLow.classList.remove("hidden");
      } else {
        soundIconOff.classList.remove("hidden");
      }
    }

    if (soundBtn) {
      soundBtn.setAttribute("aria-pressed", String(enabled));
    }

    if (volumeSlider) {
      volumeSlider.value = String(volume);
      updateSliderFill(volume);
    }

    if (volumeValDisplay) {
      volumeValDisplay.textContent = `${volume}%`;
    }
  }

  function updateSliderFill(val: number) {
    if (!volumeSlider) return;
    volumeSlider.style.background = `linear-gradient(to right, #0072F5 0%, #0072F5 ${val}%, rgba(255,255,255,0.15) ${val}%, rgba(255,255,255,0.15) 100%)`;
  }

  function openPopover() {
    if (!volumePopover) return;
    volumePopover.classList.remove("hidden");
    if (soundBtn) soundBtn.setAttribute("aria-expanded", "true");
  }

  function closePopover() {
    if (!volumePopover) return;
    volumePopover.classList.add("hidden");
    if (soundBtn) soundBtn.setAttribute("aria-expanded", "false");
  }

  function togglePopover() {
    if (!volumePopover) return;
    if (volumePopover.classList.contains("hidden")) {
      openPopover();
    } else {
      closePopover();
    }
  }

  // Sync state on load
  syncAudioUI();

  if (soundBtn) {
    let holdTimer: ReturnType<typeof setTimeout> | null = null;
    let isHoldAction = false;

    const startHold = () => {
      isHoldAction = false;
      holdTimer = setTimeout(() => {
        isHoldAction = true;
        openPopover();
      }, 350);
    };

    const cancelHold = () => {
      if (holdTimer) {
        clearTimeout(holdTimer);
        holdTimer = null;
      }
    };

    soundBtn.addEventListener("mousedown", (e) => {
      if (e.button === 0) startHold();
    });
    soundBtn.addEventListener("mouseup", cancelHold);
    soundBtn.addEventListener("mouseleave", cancelHold);

    soundBtn.addEventListener("touchstart", () => startHold(), { passive: true });
    soundBtn.addEventListener("touchend", cancelHold);
    soundBtn.addEventListener("touchcancel", cancelHold);

    soundBtn.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const isCaret = target.closest("#sound-caret") !== null;

      if (isCaret) {
        e.stopPropagation();
        togglePopover();
        return;
      }

      if (isHoldAction) {
        isHoldAction = false;
        return;
      }

      ensureAudioContext();
      toggleAudio();
      syncAudioUI();
    });
  }

  if (volumeSlider) {
    volumeSlider.addEventListener("input", () => {
      ensureAudioContext();
      const val = parseInt(volumeSlider.value, 10);
      setVolume(val);
      syncAudioUI();
      playKeyStrokeSound('a');
    });
  }

  document.addEventListener("pointerdown", (e) => {
    if (volumePopover && !volumePopover.classList.contains("hidden")) {
      if (soundContainer && !soundContainer.contains(e.target as Node)) {
        closePopover();
      }
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && volumePopover && !volumePopover.classList.contains("hidden")) {
      closePopover();
      if (soundBtn) soundBtn.focus();
    }
  });

  const themeBtn = document.getElementById("btn-theme-toggle");
  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("ptt_theme", isDark ? "dark" : "light");
      } catch {}
    });
  }
</script>



