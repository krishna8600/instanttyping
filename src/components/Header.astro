---
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  currentPath?: string;
}
const { currentPath = "/" } = Astro.props;

const navItems = [
  { href: "/", label: "Typing Test", key: "nav.test", mobileLabel: "Test", mobileKey: "nav.test_short" },
  { href: "/typing-test-for-beginners", label: "Beginners", key: "nav.beginners" },
  { href: "/numbers-punctuation-typing-test", label: "Numbers & Symbols", key: "nav.numbers", mobileLabel: "Numbers", mobileKey: "nav.numbers_short" },
];
---

<div class="header-wrapper">
<header class="pill-nav" role="banner" aria-label="Site header" data-i18n-aria-label="header.aria_site">
  <a href="/" class="brand" aria-label="Instant Typing — Home" data-i18n-aria-label="header.aria_home">
    <img
      src="/favicon.svg"
      alt="Instant Typing"
      width="40"
      height="40"
      class="w-10 h-10 rounded-md"
    />
    <span class="brand-text">Instant Typing</span>
  </a>

  <nav aria-label="Main Navigation" data-i18n-aria-label="header.aria_main_nav">
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href;
        return (
          <>
            <a
              href={item.href}
              class={(isActive ? "active " : "") + ((item as any).mobileKey ? "desktop-nav-item" : "")}
              aria-current={isActive ? "page" : undefined}
              data-i18n={item.key || undefined}
              data-nav-mode={(item as any).navMode || undefined}
            >
              {item.label}
            </a>
            {(item as any).mobileKey && (
              <a
                href={item.href}
                class={(isActive ? "active " : "") + "mobile-nav-item"}
                aria-current={isActive ? "page" : undefined}
                data-i18n={(item as any).mobileKey}
                data-nav-mode={(item as any).navMode || undefined}
              >
                {(item as any).mobileLabel}
              </a>
            )}
          </>
        );
      })
    }
  </nav>

  <div class="nav-actions">
    <div class="sound-control-container relative" id="sound-control-container">
      <button
        id="btn-sound-toggle"
        class="icon-btn sound-btn"
        type="button"
        aria-label="Toggle keyboard sound" data-i18n-aria-label="header.aria_sound"
        aria-pressed="false"
        aria-expanded="false"
        title="Toggle key sounds" data-i18n-title="header.title_sound"
      >
        <!-- High Volume Icon -->
        <span id="sound-icon-high" class="flex items-center justify-center">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
        </span>
        <!-- Low Volume Icon -->
        <span id="sound-icon-low" class="hidden flex items-center justify-center">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
          </svg>
        </span>
        <!-- Muted Icon -->
        <span id="sound-icon-off" class="hidden flex items-center justify-center">
          <svg
            width="15"
            height="15"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <line x1="23" y1="9" x2="17" y2="15"></line>
            <line x1="17" y1="9" x2="23" y2="15"></line>
          </svg>
        </span>
        <!-- Caret Icon -->
        <span id="sound-caret" class="sound-caret flex items-center justify-center" aria-hidden="true">
          <svg
            width="8"
            height="8"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m6 9 6 6 6-6"></path>
          </svg>
        </span>
      </button>

      <!-- Volume Popover -->
      <div
        id="volume-popover"
        class="volume-popover hidden"
        role="dialog"
        aria-label="Volume control popover" data-i18n-aria-label="header.aria_volume_popover"
      >
        <div class="popover-inner">
          <div class="popover-header">
            <span class="popover-title"><span data-i18n="header.volume">Volume</span></span>
            <span id="volume-val-display" class="volume-val-display">70%</span>
          </div>
          <div class="slider-wrapper">
            <input
              type="range"
              id="volume-slider"
              min="0"
              max="100"
              value="70"
              step="1"
              aria-label="Keyboard sound volume" data-i18n-aria-label="header.aria_volume_slider"
              class="volume-range-input"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<!-- Nav Profile Chip & Popover -->
<div class="profile-chip-container relative" id="profile-chip-container">
  <button
    id="btn-profile-chip"
    class="profile-chip-btn"
    type="button"
    aria-expanded="false"
    aria-haspopup="dialog"
    aria-label="Profile and stats"
    title="View your level, streak, and achievements"
  >
    <span id="nav-profile-level">Lv 1</span>
    <span class="opacity-40">·</span>
    <span class="inline-flex items-center gap-1">
      <span class="text-orange-400 text-xs">🔥</span>
      <span id="nav-profile-streak">0</span>
    </span>
  </button>

  <!-- Profile Popover -->
  <div
    id="profile-popover"
    class="profile-popover hidden"
    role="dialog"
    aria-label="Profile stats and achievements"
  >
    <div class="popover-inner space-y-3">
      <!-- Header: Level & Lifetime XP -->
      <div class="flex items-baseline justify-between border-b border-white/10 pb-2.5">
        <div class="flex items-baseline gap-2">
          <span id="popover-level" class="text-base font-bold text-white font-mono">Level 1</span>
          <span id="popover-total-xp" class="text-xs text-[#A1A1A6] font-mono">0 XP</span>
        </div>
        <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-white/10 text-white/80">Local Only</span>
      </div>

      <!-- XP Progress to Next Level -->
      <div class="space-y-1.5">
        <div class="flex items-center justify-between text-[11px] font-mono text-[#A1A1A6]">
          <span id="popover-xp-label">100 XP to Level 2</span>
          <span id="popover-xp-percent">0%</span>
        </div>
        <div class="w-full h-1.5 rounded-full bg-white/10 overflow-hidden">
          <div id="popover-xp-bar" class="h-full bg-[#0072F5] rounded-full transition-all duration-300" style="width: 0%"></div>
        </div>
      </div>

      <!-- Streak & Freezes -->
      <div class="grid grid-cols-2 gap-2 text-xs font-mono">
        <div class="p-2 rounded-lg bg-white/5 border border-white/10 space-y-0.5">
          <span class="text-[10px] uppercase text-[#A1A1A6] block">Streak</span>
          <div class="flex items-center gap-1.5">
            <span class="text-orange-400">🔥</span>
            <span id="popover-streak-current" class="font-bold text-white">0 days</span>
          </div>
          <span id="popover-streak-longest" class="text-[10px] text-[#A1A1A6] block">Longest: 0</span>
        </div>

        <div class="p-2 rounded-lg bg-white/5 border border-white/10 space-y-0.5">
          <span class="text-[10px] uppercase text-[#A1A1A6] block">Freeze</span>
          <div class="flex items-center gap-1.5">
            <span class="text-sky-400">❄️</span>
            <span id="popover-freeze-status" class="font-bold text-white">1 ready</span>
          </div>
          <span class="text-[10px] text-[#A1A1A6] block">Auto-protects</span>
        </div>
      </div>

      <!-- Lifetime Records -->
      <div class="p-2 rounded-lg bg-white/5 border border-white/10 grid grid-cols-3 gap-1 text-center font-mono text-xs">
        <div>
          <span class="text-[10px] text-[#A1A1A6] block">Tests</span>
          <span id="popover-stat-tests" class="font-semibold text-white">0</span>
        </div>
        <div>
          <span class="text-[10px] text-[#A1A1A6] block">Best WPM</span>
          <span id="popover-stat-wpm" class="font-semibold text-white">0</span>
        </div>
        <div>
          <span class="text-[10px] text-[#A1A1A6] block">Best Acc</span>
          <span id="popover-stat-acc" class="font-semibold text-white">0%</span>
        </div>
      </div>

      <!-- Achievements Row -->
      <div class="space-y-1.5 pt-1 border-t border-white/10">
        <div class="flex items-center justify-between text-[11px] font-mono text-[#A1A1A6]">
          <span>Launch Achievements</span>
          <span id="popover-achievements-count">0 / 8</span>
        </div>
        <div id="popover-achievements-list" class="grid grid-cols-4 gap-1.5 py-1">
          <!-- Rendered by JS -->
        </div>
      </div>

      <!-- Footnote -->
      <div class="pt-0.5 text-[10px] text-center text-[#86868B] font-mono">
        Your data never leaves this browser
      </div>
    </div>
  </div>
</div>

<LanguageSwitcher />

<button
  id="btn-theme-toggle"
  class="icon-btn theme-toggle-floating"
  type="button"
  aria-label="Toggle color theme" data-i18n-aria-label="header.aria_theme"
  title="Toggle Light / Dark Mode" data-i18n-title="header.title_theme"
>
  <span
    id="theme-icon-sun"
    class="hidden dark:block flex items-center justify-center"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      ><circle cx="12" cy="12" r="4"></circle><path
        d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
      ></path></svg
    >
  </span>
  <span
    id="theme-icon-moon"
    class="block dark:hidden flex items-center justify-center"
  >
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
      ></path></svg
    >
  </span>
</button>
</div>

<style>
  .header-wrapper {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 12px;
    z-index: 100;
    max-width: calc(100vw - 24px);
  }
  .pill-nav {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(12, 12, 14, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    padding: 8px 14px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
  }
  .pill-nav::-webkit-scrollbar {
    display: none;
  }
  .pill-nav .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    margin-right: 8px;
  }
  .brand-text {
    color: #fff;
    font-size: 17px;
    font-weight: 600;
    white-space: nowrap;
  }
  .pill-nav nav {
    display: flex;
    gap: 2px;
  }
  .pill-nav nav a {
    color: #d7d7db;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 999px;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .pill-nav nav a:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.07);
  }
  .pill-nav nav a.active {
    color: #fff;
    background: rgba(255, 255, 255, 0.13);
  }
  .mobile-nav-item {
    display: none;
  }
  .nav-actions {
    display: flex;
    gap: 4px;
    margin-left: 6px;
  }
  .sound-control-container {
    position: relative;
    display: inline-block;
  }
  .icon-btn {
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #d7d7db;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
  }
  .sound-btn {
    padding-left: 10px;
    padding-right: 7px;
    gap: 2px;
  }
  .sound-caret {
    opacity: 0.6;
    transition: opacity 0.2s, transform 0.2s;
    margin-left: 1px;
  }
  .sound-btn:hover .sound-caret {
    opacity: 1;
  }
  .sound-btn[aria-expanded="true"] .sound-caret {
    transform: rotate(180deg);
    opacity: 1;
  }
  .theme-toggle-floating {
    width: 36px;
    border-radius: 50%;
    flex-shrink: 0;
    color: #fff;
    background: rgba(12, 12, 14, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .theme-toggle-floating:hover {
    background: rgba(40, 40, 44, 0.65);
  }
  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .icon-btn:focus-visible {
    outline: 2px solid #0070f3;
    outline-offset: 2px;
  }

  /* Profile Popover Styling */
  .profile-chip-container {
    position: relative;
    display: inline-block;
    flex-shrink: 0;
  }
  .profile-chip-btn {
    height: 36px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(12, 12, 14, 0.85);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    color: #fff;
    padding: 0 12px;
    font-size: 13px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: all 0.2s;
    white-space: nowrap;
  }
  .profile-chip-btn:hover {
    background: rgba(40, 40, 44, 0.65);
    color: #fff;
  }
  .profile-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 290px;
    background: rgba(16, 16, 18, 0.96);
    backdrop-filter: blur(24px) saturate(180%);
    -webkit-backdrop-filter: blur(24px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 14px;
    box-shadow:
      0 16px 40px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    z-index: 250;
    animation: popoverFadeIn 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (max-width: 640px) {
    .profile-chip-btn {
      padding: 0 8px;
      font-size: 11px;
    }
    .profile-popover {
      right: -30px;
      width: 270px;
    }
  }

  /* Popover Styling */
  .volume-popover {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 170px;
    background: rgba(16, 16, 18, 0.95);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 10px 14px;
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    z-index: 200;
    animation: popoverFadeIn 0.15s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes popoverFadeIn {
    from {
      opacity: 0;
      transform: translateY(-4px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .popover-inner {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: #a1a1a6;
  }

  .volume-val-display {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    color: #0072F5;
    font-weight: 700;
  }

  .slider-wrapper {
    display: flex;
    align-items: center;
    height: 20px;
  }

  /* Custom Range Slider */
  .volume-range-input {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.15);
    outline: none;
    cursor: pointer;
  }

  .volume-range-input::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #0072F5;
    box-shadow: 0 0 8px rgba(0, 114, 245, 0.5);
    cursor: pointer;
    transition: transform 0.1s ease, background-color 0.1s ease;
  }

  .volume-range-input::-webkit-slider-thumb:hover {
    transform: scale(1.15);
    background: #298bff;
  }

  .volume-range-input::-moz-range-thumb {
    width: 14px;
    height: 14px;
    border: none;
    border-radius: 50%;
    background: #0072F5;
    box-shadow: 0 0 8px rgba(0, 114, 245, 0.5);
    cursor: pointer;
    transition: transform 0.1s ease, background-color 0.1s ease;
  }

  .volume-range-input::-moz-range-thumb:hover {
    transform: scale(1.15);
    background: #298bff;
  }

  .volume-range-input:focus-visible {
    outline: 2px solid #0072F5;
    outline-offset: 2px;
  }

  @media (max-width: 900px) {
    .brand-text {
      display: none;
    }
    .pill-nav nav a {
      padding: 8px 10px;
      font-size: 13px;
    }
  }
  @media (max-width: 640px) {
    .pill-nav {
      gap: 2px;
      padding: 6px 8px 6px 10px;
      flex-shrink: 1;
      min-width: 0;
    }
    .pill-nav .brand {
      flex-shrink: 0;
    }
    .pill-nav nav {
      flex-shrink: 1;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
    }
    .pill-nav nav::-webkit-scrollbar {
      display: none;
    }
    .desktop-nav-item {
      display: none;
    }
    .mobile-nav-item {
      display: block;
    }
  }
</style>

<script>
  import {
    toggleAudio,
    initAudioFromStorage,
    ensureAudioContext,
    setVolume,
    playKeyStrokeSound,
  } from "../utils/audio";

  const soundContainer = document.getElementById("sound-control-container");
  const soundBtn = document.getElementById("btn-sound-toggle");
  const soundIconHigh = document.getElementById("sound-icon-high");
  const soundIconLow = document.getElementById("sound-icon-low");
  const soundIconOff = document.getElementById("sound-icon-off");
  const volumePopover = document.getElementById("volume-popover");
  const volumeSlider = document.getElementById("volume-slider") as HTMLInputElement | null;
  const volumeValDisplay = document.getElementById("volume-val-display");

  function syncAudioUI() {
    const { enabled, volume, iconState } = initAudioFromStorage();

    if (soundIconHigh && soundIconLow && soundIconOff) {
      soundIconHigh.classList.add("hidden");
      soundIconLow.classList.add("hidden");
      soundIconOff.classList.add("hidden");

      if (iconState === "high") {
        soundIconHigh.classList.remove("hidden");
      } else if (iconState === "low") {
        soundIconLow.classList.remove("hidden");
      } else {
        soundIconOff.classList.remove("hidden");
      }
    }

    if (soundBtn) {
      soundBtn.setAttribute("aria-pressed", String(enabled));
    }

    if (volumeSlider) {
      volumeSlider.value = String(volume);
      updateSliderFill(volume);
    }

    if (volumeValDisplay) {
      volumeValDisplay.textContent = `${volume}%`;
    }
  }

  function updateSliderFill(val: number) {
    if (!volumeSlider) return;
    volumeSlider.style.background = `linear-gradient(to right, #0072F5 0%, #0072F5 ${val}%, rgba(255,255,255,0.15) ${val}%, rgba(255,255,255,0.15) 100%)`;
  }

  function openPopover() {
    if (!volumePopover) return;
    volumePopover.classList.remove("hidden");
    if (soundBtn) soundBtn.setAttribute("aria-expanded", "true");
  }

  function closePopover() {
    if (!volumePopover) return;
    volumePopover.classList.add("hidden");
    if (soundBtn) soundBtn.setAttribute("aria-expanded", "false");
  }

  function togglePopover() {
    if (!volumePopover) return;
    if (volumePopover.classList.contains("hidden")) {
      openPopover();
    } else {
      closePopover();
    }
  }

  // Sync state on load
  syncAudioUI();

  if (soundBtn) {
    let holdTimer: ReturnType<typeof setTimeout> | null = null;
    let isHoldAction = false;

    const startHold = () => {
      isHoldAction = false;
      holdTimer = setTimeout(() => {
        isHoldAction = true;
        openPopover();
      }, 350);
    };

    const cancelHold = () => {
      if (holdTimer) {
        clearTimeout(holdTimer);
        holdTimer = null;
      }
    };

    soundBtn.addEventListener("mousedown", (e) => {
      if (e.button === 0) startHold();
    });
    soundBtn.addEventListener("mouseup", cancelHold);
    soundBtn.addEventListener("mouseleave", cancelHold);

    soundBtn.addEventListener("touchstart", () => startHold(), { passive: true });
    soundBtn.addEventListener("touchend", cancelHold);
    soundBtn.addEventListener("touchcancel", cancelHold);

    soundBtn.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const isCaret = target.closest("#sound-caret") !== null;

      if (isCaret) {
        e.stopPropagation();
        togglePopover();
        return;
      }

      if (isHoldAction) {
        isHoldAction = false;
        return;
      }

      ensureAudioContext();
      toggleAudio();
      syncAudioUI();
    });
  }

  if (volumeSlider) {
    volumeSlider.addEventListener("input", () => {
      ensureAudioContext();
      const val = parseInt(volumeSlider.value, 10);
      setVolume(val);
      syncAudioUI();
      playKeyStrokeSound('a');
    });
  }

  document.addEventListener("pointerdown", (e) => {
    if (volumePopover && !volumePopover.classList.contains("hidden")) {
      if (soundContainer && !soundContainer.contains(e.target as Node)) {
        closePopover();
      }
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && volumePopover && !volumePopover.classList.contains("hidden")) {
      closePopover();
      if (soundBtn) soundBtn.focus();
    }
  });

  const themeBtn = document.getElementById("btn-theme-toggle");
  if (themeBtn) {
    themeBtn.addEventListener("click", () => {
      const isDark = document.documentElement.classList.toggle("dark");
      try {
        localStorage.setItem("ptt_theme", isDark ? "dark" : "light");
      } catch {}
    });
  }

  // Direct mode switching: nav clicks dispatch event, no page reload
  document.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest('[data-nav-mode]');
    if (!link) return;
    e.preventDefault();
    const mode = link.getAttribute('data-nav-mode');
    if (mode) {
      window.dispatchEvent(new CustomEvent('nav-mode-switch', { detail: mode }));
      // Scroll to test
      const test = document.getElementById('typing-test-container');
      if (test) test.scrollIntoView({ behavior: 'smooth' });
    }
  });

  // Sync nav active state when mode changes via nav clicks
  window.addEventListener('nav-mode-switch', ((ev: CustomEvent) => {
    var mode = ev.detail;
    // Remove active from all nav links
    document.querySelectorAll('.pill-nav nav a').forEach((a) => {
      a.classList.remove('active');
      a.removeAttribute('aria-current');
    });
    // Add active to the matching nav link
    var link = document.querySelector('.pill-nav nav a[data-nav-mode="' + mode + '"]');
    if (link) {
      link.classList.add('active');
      link.setAttribute('aria-current', 'page');
    }
  }) as EventListener);

  // Also sync when mode tabs are clicked directly in the test
  document.addEventListener('click', (e) => {
    var tab = (e.target as HTMLElement).closest('[data-mode-btn]');
    if (!tab) return;
    var mode = tab.getAttribute('data-mode-btn');
    // Only for classics/quote (the nav modes)
    if (mode === 'classics' || mode === 'quote') {
      document.querySelectorAll('.pill-nav nav a').forEach((a) => {
        a.classList.remove('active');
        a.removeAttribute('aria-current');
      });
      var link = document.querySelector('.pill-nav nav a[data-nav-mode="' + mode + '"]');
      if (link) {
        link.classList.add('active');
        link.setAttribute('aria-current', 'page');
      }
    } else {
      // Time/words mode -> highlight Typing Test
      document.querySelectorAll('.pill-nav nav a').forEach((a) => {
        a.classList.remove('active');
        a.removeAttribute('aria-current');
      });
      var homeLink = document.querySelector('.pill-nav nav a[href="/"]');
      if (homeLink && window.location.pathname === '/') {
        homeLink.classList.add('active');
        homeLink.setAttribute('aria-current', 'page');
      }
    }
  });

  // ── Profile Popover Logic ────────────────────────────────────────────────
  (function() {
    const btnChip = document.getElementById('btn-profile-chip');
    const popover = document.getElementById('profile-popover');
    const levelLabel = document.getElementById('nav-profile-level');
    const streakLabel = document.getElementById('nav-profile-streak');

    const popoverLevel = document.getElementById('popover-level');
    const popoverTotalXp = document.getElementById('popover-total-xp');
    const popoverXpLabel = document.getElementById('popover-xp-label');
    const popoverXpPercent = document.getElementById('popover-xp-percent');
    const popoverXpBar = document.getElementById('popover-xp-bar');
    const popoverStreakCurrent = document.getElementById('popover-streak-current');
    const popoverStreakLongest = document.getElementById('popover-streak-longest');
    const popoverFreezeStatus = document.getElementById('popover-freeze-status');
    const popoverStatTests = document.getElementById('popover-stat-tests');
    const popoverStatWpm = document.getElementById('popover-stat-wpm');
    const popoverStatAcc = document.getElementById('popover-stat-acc');
    const popoverAchCount = document.getElementById('popover-achievements-count');
    const popoverAchList = document.getElementById('popover-achievements-list');

    async function syncProfileUI() {
      try {
        const { loadProfile, getXpProgressForLevel, ACHIEVEMENTS } = await import('../scripts/profile');
        const profile = loadProfile();
        const progress = getXpProgressForLevel(profile.xp);

        if (levelLabel) levelLabel.textContent = `Lv ${progress.level}`;
        if (streakLabel) streakLabel.textContent = String(profile.streak.current);

        if (popoverLevel) popoverLevel.textContent = `Level ${progress.level}`;
        if (popoverTotalXp) popoverTotalXp.textContent = `${profile.xp.toLocaleString()} XP`;
        if (popoverXpLabel) popoverXpLabel.textContent = `${progress.xpNeededForNext} XP to Level ${progress.level + 1}`;
        if (popoverXpPercent) popoverXpPercent.textContent = `${Math.round(progress.progressPercent)}%`;
        if (popoverXpBar) popoverXpBar.style.width = `${progress.progressPercent}%`;

        if (popoverStreakCurrent) popoverStreakCurrent.textContent = `${profile.streak.current} ${profile.streak.current === 1 ? 'day' : 'days'}`;
        if (popoverStreakLongest) popoverStreakLongest.textContent = `Longest: ${profile.streak.longest}`;
        if (popoverFreezeStatus) popoverFreezeStatus.textContent = profile.streak.freezesAvailable > 0 ? '1 ready' : '0/1 used';

        if (popoverStatTests) popoverStatTests.textContent = String(profile.stats.testsCompleted);
        if (popoverStatWpm) popoverStatWpm.textContent = String(profile.stats.bestWpm);
        if (popoverStatAcc) popoverStatAcc.textContent = `${profile.stats.bestAccuracy}%`;

        const unlockedIds = Object.keys(profile.achievements);
        if (popoverAchCount) popoverAchCount.textContent = `${unlockedIds.length} / ${ACHIEVEMENTS.length}`;

        if (popoverAchList) {
          popoverAchList.innerHTML = ACHIEVEMENTS.map(ach => {
            const isUnlocked = !!profile.achievements[ach.id];
            return `
              <div class="flex flex-col items-center p-1.5 rounded-lg border text-center transition-all ${
                isUnlocked
                  ? 'bg-white/10 border-white/20 text-white'
                  : 'bg-white/5 border-white/5 text-[#6E6E73] opacity-40'
              }" title="${ach.name}: ${ach.description} (${ach.tier})">
                <span class="text-base leading-none">${ach.icon}</span>
                <span class="text-[9px] font-mono truncate w-full mt-1">${ach.name}</span>
              </div>
            `;
          }).join('');
        }
      } catch (err) {
        console.error('Error syncing profile UI in header:', err);
      }
    }

    btnChip?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isHidden = popover?.classList.contains('hidden');
      if (isHidden) {
        popover?.classList.remove('hidden');
        btnChip?.setAttribute('aria-expanded', 'true');
        syncProfileUI();
      } else {
        popover?.classList.add('hidden');
        btnChip?.setAttribute('aria-expanded', 'false');
      }
    });

    document.addEventListener('click', (e) => {
      if (popover && !popover.classList.contains('hidden')) {
        const target = e.target as HTMLElement;
        if (!popover.contains(target) && !btnChip?.contains(target)) {
          popover.classList.add('hidden');
          btnChip?.setAttribute('aria-expanded', 'false');
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && popover && !popover.classList.contains('hidden')) {
        popover.classList.add('hidden');
        btnChip?.setAttribute('aria-expanded', 'false');
      }
    });

    window.addEventListener('it-profile-updated', () => {
      syncProfileUI();
    });

    // Initial sync
    syncProfileUI();
  })();
</script>





