---
import Icon from './Icon.astro';
---

<section class="relative w-[100vw] ml-[50%] -translate-x-1/2 overflow-hidden bg-[#0a0a0a] py-24 sm:py-32 flex flex-col items-center justify-center min-h-[600px] border-b border-white/5 mt-[-2rem] mb-12">
 <!-- Giant Background Wordmark -->
 <div class="absolute inset-0 flex items-center justify-center pointer-events-none overflow-hidden select-none">
 <span class="text-[120px] sm:text-[200px] font-black text-white/5 tracking-tighter uppercase whitespace-nowrap">
 TYPE
 </span>
 </div>

 <div class="relative z-10 flex flex-col items-center w-full max-w-5xl mx-auto px-4">
 <!-- Headline -->
 <h1 class="text-5xl sm:text-7xl tracking-[-0.04em] text-transparent bg-clip-text bg-gradient-to-br from-white via-neutral-300 to-neutral-600 mb-6 text-center text-4xl sm:text-5xl font-semibold tracking-[-0.03em] leading-[1.1] text-balance">
 Type further.
 </h1>
 <p class="font-normal text-pretty text-lg sm:text-xl text-ds-text-muted max-w-2xl text-center mb-12">
 Experience precision mechanics and zero-latency performance in the ultimate typing environment.
 </p>

 <!-- 3D Keyboard Element slicing through -->
 <div class="relative w-full max-w-3xl h-[280px] sm:h-[360px] mx-auto mb-12 pointer-events-none">
 <!-- Ambient background glow behind keyboard -->
 <div class="absolute inset-0 bg-ds-bg-100/5 blur-[100px] rounded-full z-0"></div>
 
 <div class="absolute inset-0 flex justify-center items-center z-10" style="transform: perspective(1200px) rotateX(18deg) rotateZ(-3deg);">
 <!-- Chassis -->
 <div class="relative w-[110%] sm:w-full bg-gradient-to-b from-neutral-800 to-neutral-950 rounded-xl sm:rounded-3xl border border-neutral-700 shadow-[0_30px_60px_rgba(0,0,0,0.9),inset_0_2px_10px_rgba(255,255,255,0.05)] p-4 sm:p-6 flex flex-col gap-2 sm:gap-3">
 
 <!-- QWERTY row -->
 <div class="flex gap-2 sm:gap-3 w-full h-10 sm:h-12">
 <div class="w-12 sm:w-16 flex-shrink-0 bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-inner flex items-center justify-center text-[10px] sm:text-xs font-mono text-ds-text-muted">TAB</div>
 {['Q','W','E','R','T','Y','U','I','O','P','[',']'].map(key => (
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200">{key}</div>
 ))}
 <div class="flex-[1.5] bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_0_#171717] flex items-center justify-center text-[10px] sm:text-xs font-mono text-ds-text-muted">|</div>
 </div>
 
 <!-- Home row ASDF -->
 <div class="flex gap-2 sm:gap-3 w-full h-10 sm:h-12">
 <div class="w-16 sm:w-20 flex-shrink-0 bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-inner flex items-center justify-center text-[10px] sm:text-xs font-mono text-ds-text-muted">CAPS</div>
 {['A','S','D'].map(key => (
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200">{key}</div>
 ))}
 
 <!-- F key illuminated -->
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717,0_0_15px_rgba(217,119,6,0.2)] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200 relative">
 F
 <div class="absolute bottom-1.5 w-3 h-0.5 bg-amber-500 rounded-full shadow-[0_0_8px_#f59e0b]"></div>
 </div>
 
 {['G','H'].map(key => (
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200">{key}</div>
 ))}
 
 <!-- J key illuminated -->
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717,0_0_15px_rgba(217,119,6,0.2)] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200 relative">
 J
 <div class="absolute bottom-1.5 w-3 h-0.5 bg-amber-500 rounded-full shadow-[0_0_8px_#f59e0b]"></div>
 </div>
 
 {['K','L',';','\''].map(key => (
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200">{key}</div>
 ))}
 <div class="flex-[2] bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_0_#171717] flex items-center justify-center text-[10px] sm:text-xs font-mono text-ds-text-muted">ENTER</div>
 </div>
 
 <!-- ZXCV row -->
 <div class="flex gap-2 sm:gap-3 w-full h-10 sm:h-12">
 <div class="w-20 sm:w-24 flex-shrink-0 bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_0_#171717] flex items-center justify-center text-[10px] sm:text-xs font-mono text-ds-text-muted">SHIFT</div>
 {['Z','X','C','V','B','N','M',',','.','/'].map(key => (
 <div class="flex-1 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717] flex items-center justify-center text-xs sm:text-sm font-bold text-neutral-200">{key}</div>
 ))}
 <div class="flex-[2.5] bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_0_#171717] flex items-center justify-center text-[10px] sm:text-xs font-mono text-ds-text-muted">SHIFT</div>
 </div>
 
 <!-- Spacebar row -->
 <div class="flex gap-2 sm:gap-3 w-full h-10 sm:h-12 justify-center">
 <div class="w-24 sm:w-32 bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_0_#171717]"></div>
 <div class="w-1/2 bg-neutral-800 border border-neutral-700 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.1),0_4px_0_#171717] flex items-center justify-center"></div>
 <div class="w-24 sm:w-32 bg-neutral-800/80 border border-neutral-700/80 rounded-md shadow-[inset_0_1px_1px_rgba(255,255,255,0.05),0_4px_0_#171717]"></div>
 </div>

 </div>
 </div>
 </div>

 <!-- CTA Pill Buttons -->
 <div class="flex flex-col sm:flex-row items-center gap-4 z-20">
 <a href="#typing-test-container" class="px-8 py-3.5 rounded-full bg-ds-bg-100 text-black font-medium text-sm sm:text-base hover:scale-105 transition-transform duration-300 shadow-[0_0_20px_rgba(255,255,255,0.15)] flex items-center gap-2">
 <Icon name="bolt" class="w-4 h-4" />
 Start Speed Test
 </a>
 <a href="/numbers-punctuation-typing-test" class="px-8 py-3.5 rounded-full bg-neutral-800/80 backdrop-blur-md text-white font-medium text-sm sm:text-base hover:bg-neutral-700 transition-colors border border-white/10 flex items-center gap-2 group">
 Numbers & Symbols
 <Icon name="chevron-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
 </a>
 </div>
 </div>
</section>
