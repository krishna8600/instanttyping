---
// GuidedKeyboard.astro — Unit 4 FINAL + keycap upgrade
// Design law: monochrome + #0072F5 only on target key, active finger, focus rings
// Instruction format: "Right index → J" (label, never sentence)
// No photographs, no warm colors, no mascot voice
---

<div
  id="gk-root"
  class="block w-full max-w-3xl mx-auto mt-1 sm:mt-1.5 select-none"
  aria-label="Finger guide keyboard"
  role="region"
>
  <!-- ① INSTRUCTION LINE — label style, compact -->
  <div class="flex items-center justify-between mb-0 px-1">
    <div
      id="gk-instruction"
      class="flex items-center gap-2.5 min-h-[1.75rem] opacity-0 transition-opacity duration-150"
      aria-live="polite"
      aria-atomic="true"
    >
      <!-- populated by JS: "Right index → J" -->
      <span id="gk-hand-label" class="text-xs font-mono uppercase tracking-widest text-ds-text-secondary"></span>
      <span class="text-ds-text-secondary opacity-40 text-xs">→</span>
      <kbd
        id="gk-key-label"
        class="inline-flex items-center justify-center h-6 min-w-[1.5rem] px-2 rounded border border-[#0072F5]/60 bg-[#0072F5]/5 text-[#0072F5] text-xs font-mono font-semibold tracking-wide transition-all duration-150"
      ></kbd>
    </div>

    <!-- Off-switch -->
    <div class="flex items-center gap-2 cursor-pointer" id="gk-toggle-label">
      <span class="text-[11px] font-mono text-ds-text-secondary uppercase tracking-wider">Keyboard</span>
      <button
        id="gk-toggle"
        role="switch"
        aria-checked="true"
        class="relative inline-flex h-4 w-8 shrink-0 cursor-pointer rounded-full border border-ds-border bg-ds-bg-100 transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#0072F5] focus:ring-offset-2 focus:ring-offset-ds-bg-50"
       aria-label="Toggle keyboard guide">
        <span
          id="gk-toggle-thumb"
          class="pointer-events-none inline-block h-3 w-3 mt-[1px] ml-[1px] rounded-full bg-ds-border shadow transition-transform duration-200"
        ></span>
      </button>
    </div>
  </div>

  <!-- ② KEYBOARD CARD -->
  <div id="gk-keyboard" class="premium-card !p-1 sm:!p-2 overflow-hidden !mb-0">
    <!-- Scaler container for mobile/tablet proportional fit -->
    <div id="gk-scaler-container" class="w-full flex justify-center overflow-hidden">
      <!-- Keyboard rows -->
      <div id="gk-board" class="flex flex-col gap-0.5 w-full min-w-[640px] shrink-0 origin-top">

      <!-- Row 1: Digits -->
      <div class="flex gap-1">
        {[
          {code:'Backquote', p:'`', s:'~'},
          {code:'Digit1', p:'1', s:'!'},
          {code:'Digit2', p:'2', s:'@'},
          {code:'Digit3', p:'3', s:'#'},
          {code:'Digit4', p:'4', s:'$'},
          {code:'Digit5', p:'5', s:'%'},
          {code:'Digit6', p:'6', s:'^'},
          {code:'Digit7', p:'7', s:'&'},
          {code:'Digit8', p:'8', s:'*'},
          {code:'Digit9', p:'9', s:'('},
          {code:'Digit0', p:'0', s:')'},
          {code:'Minus', p:'-', s:'_'},
          {code:'Equal', p:'=', s:'+'},
        ].map(k => (
          <div data-code={k.code} class="gk-key relative flex-1 h-8 hand-left">
            <span class="absolute top-0.5 left-1 text-[8px] opacity-50 leading-none">{k.s}</span>
            <span class="text-[10px] mt-2">{k.p}</span>
          </div>
        ))}
        <!-- Backspace: 2u -->
        <div data-code="Backspace" class="gk-key gk-key-2u h-8 text-[9px] hand-left">del</div>
      </div>

      <!-- Row 2: QWERTY -->
      <div class="flex gap-1">
        <!-- Tab: 1.5u -->
        <div data-code="Tab" class="gk-key gk-key-1-5u h-8 text-[9px] hand-left">tab</div>
        {[
          {code:'KeyQ', p:'Q', hand:'left'},
          {code:'KeyW', p:'W', hand:'left'},
          {code:'KeyE', p:'E', hand:'left'},
          {code:'KeyR', p:'R', hand:'left'},
          {code:'KeyT', p:'T', hand:'left'},
          {code:'KeyY', p:'Y', hand:'right'},
          {code:'KeyU', p:'U', hand:'right'},
          {code:'KeyI', p:'I', hand:'right'},
          {code:'KeyO', p:'O', hand:'right'},
          {code:'KeyP', p:'P', hand:'right'},
          {code:'BracketLeft', p:'[', s:'{', hand:'right'},
          {code:'BracketRight', p:']', s:'}', hand:'right'},
          {code:'Backslash', p:'\\', s:'|', hand:'right'},
        ].map(k => (
          <div data-code={k.code} class={`gk-key relative flex-1 h-8 hand-${k.hand}`}>
            {k.s && <span class="absolute top-0.5 left-1 text-[8px] opacity-50 leading-none">{k.s}</span>}
            <span class={k.s ? 'text-[11px] mt-2' : 'text-[11px]'}>{k.p}</span>
          </div>
        ))}
      </div>

      <!-- Row 3: Home row (ASDF…) -->
      <div class="flex gap-1">
        <!-- Caps Lock: 1.75u -->
        <div data-code="CapsLock" class="gk-key gk-key-1-75u h-8 text-[9px] hand-left">caps</div>
        {[
          {code:'KeyA', p:'A', hand:'left'},
          {code:'KeyS', p:'S', hand:'left'},
          {code:'KeyD', p:'D', hand:'left'},
          {code:'KeyF', p:'F', hand:'left', home:true},
          {code:'KeyG', p:'G', hand:'left'},
          {code:'KeyH', p:'H', hand:'right'},
          {code:'KeyJ', p:'J', hand:'right', home:true},
          {code:'KeyK', p:'K', hand:'right'},
          {code:'KeyL', p:'L', hand:'right'},
          {code:'Semicolon', p:';', s:':', hand:'right'},
          {code:'Quote', p:"'", s:'"', hand:'right'},
        ].map(k => (
          <div data-code={k.code} class={`gk-key relative flex-1 h-8 hand-${k.hand}`}>
            {k.s && <span class="absolute top-0.5 left-1 text-[8px] opacity-50 leading-none">{k.s}</span>}
            <span class={k.s ? 'text-[11px] mt-2' : 'text-[11px]'}>{k.p}</span>
            {k.home && (
              <span class="absolute bottom-1 left-1/2 -translate-x-1/2 w-3 h-[2px] rounded-full bg-ds-border opacity-70"></span>
            )}
          </div>
        ))}
        <!-- Enter: 2.25u -->
        <div data-code="Enter" class="gk-key gk-key-2-25u h-8 text-[9px] hand-right">enter</div>
      </div>

      <!-- Row 4: ZXCV… -->
      <div class="flex gap-1">
        <!-- Left Shift: 2.25u -->
        <div data-code="ShiftLeft" class="gk-key gk-key-2-25u h-8 text-[9px] hand-left">shift</div>
        {[
          {code:'KeyZ', p:'Z', hand:'left'},
          {code:'KeyX', p:'X', hand:'left'},
          {code:'KeyC', p:'C', hand:'left'},
          {code:'KeyV', p:'V', hand:'left'},
          {code:'KeyB', p:'B', hand:'left'},
          {code:'KeyN', p:'N', hand:'right'},
          {code:'KeyM', p:'M', hand:'right'},
          {code:'Comma', p:',', s:'<', hand:'right'},
          {code:'Period', p:'.', s:'>', hand:'right'},
          {code:'Slash', p:'/', s:'?', hand:'right'},
        ].map(k => (
          <div data-code={k.code} class={`gk-key relative flex-1 h-8 hand-${k.hand}`}>
            {k.s && <span class="absolute top-0.5 left-1 text-[8px] opacity-50 leading-none">{k.s}</span>}
            <span class={k.s ? 'text-[11px] mt-2' : 'text-[11px]'}>{k.p}</span>
          </div>
        ))}
        <!-- Right Shift: 2.75u -->
        <div data-code="ShiftRight" class="gk-key gk-key-2-75u h-8 text-[9px] hand-right">shift</div>
      </div>

      <!-- Row 5: Space row — modifiers flank Space 6.25u -->
      <div class="flex gap-1 justify-center">
        <div data-code="ControlLeft" class="gk-key gk-key-mod h-8 text-[9px] hand-left">ctrl</div>
        <div data-code="AltLeft" class="gk-key gk-key-mod h-8 text-[9px] hand-left">opt</div>
        <div data-code="MetaLeft" class="gk-key gk-key-mod h-8 text-[9px] hand-left">cmd</div>
        <!-- Space: 6.25u proportional -->
        <div data-code="Space" class="gk-key gk-key-space h-8 hand-right"></div>
        <div data-code="MetaRight" class="gk-key gk-key-mod h-8 text-[9px] hand-right">cmd</div>
        <div data-code="AltRight" class="gk-key gk-key-mod h-8 text-[9px] hand-right">opt</div>
        <div data-code="ControlRight" class="gk-key gk-key-mod h-8 text-[9px] hand-right">ctrl</div>
      </div>
    </div>
  </div>

    <!-- ③ FINGER ZONE DIAGRAM — below keyboard, inside card (compact dots only) -->
    <div
      id="gk-finger-zones"
      class="mt-2 pt-1 border-t border-ds-border flex justify-between opacity-0 transition-opacity duration-200"
    >
      <!-- Left hand -->
      <div class="flex gap-3 sm:gap-4 items-end">
        {[
          {id:'left_pinky',  label:'Pinky'},
          {id:'left_ring',   label:'Ring'},
          {id:'left_middle', label:'Middle'},
          {id:'left_index',  label:'Index'},
          {id:'thumb',       label:'Thumb', extra:'ml-3'},
        ].map(f => (
          <div class={`flex flex-col items-center ${f.extra ?? ''}`} title={f.label}>
            <div
              id={`gk-zone-${f.id}`}
              class="zone-dot w-2 h-2 rounded-full bg-ds-border transition-all duration-150"
            ></div>
          </div>
        ))}
      </div>
      <!-- Right hand -->
      <div class="flex gap-3 sm:gap-4 items-end flex-row-reverse">
        {[
          {id:'right_pinky',  label:'Pinky'},
          {id:'right_ring',   label:'Ring'},
          {id:'right_middle', label:'Middle'},
          {id:'right_index',  label:'Index'},
          {id:'right_thumb',  label:'Thumb', extra:'mr-3'},
        ].map(f => (
          <div class={`flex flex-col items-center ${f.extra ?? ''}`} title={f.label}>
            <div
              id={`gk-zone-${f.id}`}
              class="zone-dot w-2 h-2 rounded-full bg-ds-border transition-all duration-150"
            ></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>

<style>
  /* ── ANSI unit widths ──────────────────────────────────────────────────────
     1u letter keys use flex-1 so all rows self-balance.
     Named modifiers use fixed widths that respect ANSI ratios.
  ── */
  .gk-key-1-5u  { width: 3rem;    flex-shrink: 0; } /* Tab   1.5u */
  .gk-key-1-75u { width: 3.5rem;  flex-shrink: 0; } /* Caps  1.75u */
  .gk-key-2u    { width: 4rem;    flex-shrink: 0; } /* Backspace 2u */
  .gk-key-2-25u { width: 4.5rem;  flex-shrink: 0; } /* LShift / Enter 2.25u */
  .gk-key-2-75u { width: 5.5rem;  flex-shrink: 0; } /* RShift 2.75u */
  .gk-key-space  { flex: 6.25;    flex-shrink: 0; } /* Space  6.25u proportional */
  .gk-key-mod   { width: 2.25rem; flex-shrink: 0; } /* ctrl/opt/cmd ~1.25u */

  /* ── Label helpers ─────────────────────────────────────────────────────── */
  .gk-shift-label {
    position: absolute;
    top: 2px;
    left: 4px;
    font-size: 8px;
    opacity: 0.5;
    line-height: 1;
    pointer-events: none;
  }
  .gk-primary {
    font-size: 11px;
    pointer-events: none;
  }

  /* ── Base key — physical keycap depth ──────────────────────────────────── */
  .gk-key {
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-family: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.02em;
    cursor: default;
    user-select: none;
    position: relative;
    /* Keycap face gradient — light top, slightly darker bottom */
    background: linear-gradient(to bottom, #ffffff 0%, #f0f0f0 100%);
    /* 1px darker edge stroke on bottom for keycap depth */
    border: 1px solid #D1D1D6;
    border-bottom-color: #B0B0B5;
    color: #1D1D1F;
    /* 2px drop shadow for physical lift */
    box-shadow: 0 2px 0 #C0C0C5, 0 2px 4px rgba(0,0,0,0.10);
    /* Transitions — NOT on background (pressed path must be instant) */
    transition: border-color 120ms, color 120ms, box-shadow 120ms;
  }

  .gk-key > * {
    pointer-events: none;
  }

  :global(.dark) .gk-key {
    background: linear-gradient(to bottom, #2a2a2e 0%, #212124 100%);
    border-color: rgba(255,255,255,0.14);
    border-bottom-color: rgba(255,255,255,0.06);
    color: #F5F5F7;
    box-shadow: 0 2px 0 rgba(0,0,0,0.5), 0 2px 4px rgba(0,0,0,0.30);
  }

  /* Hand-zone tints — very subtle, monochrome */
  .gk-key.hand-left {
    background: linear-gradient(to bottom, #fafafa 0%, #f2f2f4 100%);
  }
  .gk-key.hand-right {
    background: linear-gradient(to bottom, #f5f5f7 0%, #ebebed 100%);
  }
  :global(.dark) .gk-key.hand-left {
    background: linear-gradient(to bottom, #1e1e22 0%, #18181b 100%);
  }
  :global(.dark) .gk-key.hand-right {
    background: linear-gradient(to bottom, #222226 0%, #1c1c1f 100%);
  }

  /* ── PRESSED state — instant blue fill, no transition on bg ────────────── */
  .gk-key.gk-pressed {
    background: linear-gradient(to bottom, #4aa3ff 0%, #0072f5 100%) !important;
    border-color: #0060d0 !important;
    border-bottom-color: #0050b0 !important;
    color: #ffffff !important;
    box-shadow: 0 1px 0 #004090, 0 1px 3px rgba(0,114,245,0.30) !important;
    /* CRITICAL: no transition — fill must be frame-synchronous */
    transition: none !important;
  }

  /* ── NEXT: target key — #0072F5 border + text, faint blue bg ───────────── */
  .gk-key.gk-next {
    border-color: #0072F5 !important;
    color: #0072F5 !important;
    background: rgba(0, 114, 245, 0.06) !important;
    box-shadow: 0 0 0 1px rgba(0, 114, 245, 0.2), 0 2px 0 #C0C0C5 !important;
  }
  :global(.dark) .gk-key.gk-next {
    background: rgba(0, 114, 245, 0.10) !important;
    box-shadow: 0 0 0 1px rgba(0, 114, 245, 0.3), 0 2px 0 rgba(0,0,0,0.5) !important;
  }

  /* CORRECT flash */
  .gk-key.gk-correct {
    border-color: #0072F5 !important;
    background: rgba(0, 114, 245, 0.18) !important;
    color: #0072F5 !important;
    transition: none !important;
  }

  /* WRONG flash + shake */
  .gk-key.gk-wrong {
    border-color: #ef4444 !important;
    background: rgba(239, 68, 68, 0.12) !important;
    color: #ef4444 !important;
    transition: none !important;
    animation: gk-shake 220ms cubic-bezier(.36,.07,.19,.97) both;
  }

  @keyframes gk-shake {
    10%, 90% { transform: translateX(-1px); }
    20%, 80% { transform: translateX(2px); }
    30%, 50%, 70% { transform: translateX(-2px); }
    40%, 60% { transform: translateX(2px); }
  }

  /* ── Reduced motion ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .gk-key,
    .zone-dot,
    #gk-instruction,
    #gk-finger-zones {
      transition: none !important;
      animation: none !important;
      box-shadow: none !important;
    }
    /* Pressed: still shows color, no shadow/movement */
    .gk-key.gk-pressed {
      background: linear-gradient(to bottom, #4aa3ff 0%, #0072f5 100%) !important;
      color: #ffffff !important;
    }
  }

  /* Active zone dot */
  .zone-dot.gk-active-zone {
    background-color: #0072F5 !important;
    box-shadow: 0 0 0 3px rgba(0, 114, 245, 0.2);
  }

  /* Toggle knob ON */
  #gk-toggle[aria-checked="true"] {
    background-color: rgba(0, 114, 245, 0.15);
    border-color: rgba(0, 114, 245, 0.4);
  }
  #gk-toggle[aria-checked="true"] #gk-toggle-thumb {
    transform: translateX(16px);
    background-color: #0072F5;
  }
</style>

<script>
  import { getKeyForChar, getShiftKeyFor } from '../scripts/keyboard-map';

  // ── State ──────────────────────────────────────────────────────────────────
  let enabled = true;
  try { const v = localStorage.getItem('gk-enabled'); if (v !== null) enabled = v === 'true'; } catch {}

  const instruction = document.getElementById('gk-instruction');
  const handLabel   = document.getElementById('gk-hand-label');
  const keyLabel    = document.getElementById('gk-key-label');
  const fingerZones = document.getElementById('gk-finger-zones');
  const toggle      = document.getElementById('gk-toggle') as HTMLButtonElement;
  const toggleThumb = document.getElementById('gk-toggle-thumb');
  const keyboardEl      = document.getElementById('gk-keyboard');
  const scalerContainer = document.getElementById('gk-scaler-container');
  const boardEl         = document.getElementById('gk-board');

  function fitKeyboard() {
    if (!scalerContainer || !boardEl || !enabled) return;
    const availableWidth = scalerContainer.clientWidth;
    if (availableWidth <= 0) return;
    const baseWidth = 640;
    const baseHeight = 168; // 5 rows * 32px + 4 gaps * 2px
    if (availableWidth < baseWidth) {
      const scale = availableWidth / baseWidth;
      boardEl.style.transform = `scale(${scale})`;
      boardEl.style.transformOrigin = 'top center';
      scalerContainer.style.height = `${Math.ceil(baseHeight * scale)}px`;
    } else {
      boardEl.style.transform = '';
      boardEl.style.transformOrigin = '';
      scalerContainer.style.height = '';
    }
  }
  const keyMap = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('#gk-keyboard .gk-key[data-code]').forEach((el) => {
    const code = el.getAttribute('data-code');
    if (code) keyMap.set(code, el);
  });

  const zoneMap = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[id^="gk-zone-"]').forEach((el) => {
    zoneMap.set(el.id, el);
  });

  let activeKeyEl:      HTMLElement | null = null;
  let activeShiftEl:    HTMLElement | null = null;
  let activeZoneEl:     HTMLElement | null = null;
  let activeFlashKeyEl: HTMLElement | null = null;
  let flashTimeoutId:   any = null;

  // ── Press-light state — Set of currently pressed keys ─────────────────────
  const pressedKeys = new Set<string>();

  /** Clear all press-light highlights (blur / typing-reset) */
  function clearAllPressLights() {
    clearPointerPress();
    for (const code of pressedKeys) {
      keyMap.get(code)?.classList.remove('gk-pressed');
    }
    pressedKeys.clear();
  }

  // ── Concise finger labels ──────────────────────────────────────────────────
  const fingerLabel: Record<string, string> = {
    left_pinky:  'L. pinky',
    left_ring:   'L. ring',
    left_middle: 'L. middle',
    left_index:  'L. index',
    right_index: 'R. index',
    right_middle:'R. middle',
    right_ring:  'R. ring',
    right_pinky: 'R. pinky',
    thumb:       'Thumb',
  };

  // ── Helpers ────────────────────────────────────────────────────────────────
  function isEnglish(): boolean {
    const sel = document.getElementById('wordbank-select') as HTMLSelectElement | null;
    if (!sel) return true;
    return !['es','fr','de','pt','it'].includes(sel.value);
  }

  function shouldShow(): boolean {
    return enabled && isEnglish();
  }

  function applyToggleUI() {
    if (!toggle || !toggleThumb || !fingerZones) return;
    toggle.setAttribute('aria-checked', enabled ? 'true' : 'false');
    // User toggle controls visibility; language only affects guides
    if (enabled) {
      keyboardEl?.classList.remove('hidden');
      if (isEnglish()) {
        fingerZones.classList.remove('opacity-0');
      } else {
        fingerZones.classList.add('opacity-0');
      }
      fitKeyboard();
    } else {
      keyboardEl?.classList.add('hidden');
      fingerZones.classList.add('opacity-0');
      clearAll();
    }
  }

  function clearAll() {
    if (activeKeyEl)   { activeKeyEl.classList.remove('gk-next', 'gk-correct', 'gk-wrong'); activeKeyEl = null; }
    if (activeShiftEl) { activeShiftEl.classList.remove('gk-next'); activeShiftEl = null; }
    if (activeZoneEl)  { activeZoneEl.classList.remove('gk-active-zone'); activeZoneEl = null; }
    if (activeFlashKeyEl) {
      activeFlashKeyEl.classList.remove('gk-correct', 'gk-wrong', 'gk-next');
      activeFlashKeyEl = null;
      if (flashTimeoutId) { clearTimeout(flashTimeoutId); flashTimeoutId = null; }
    }
    if (instruction)   instruction.style.opacity = '0';
  }

  function highlightNext(char: string) {
    clearAll();
    if (!shouldShow()) return;

    const res = getKeyForChar(char);
    if (!res) return; // null → no highlight, no crash

    // Target key (O(1) Map lookup)
    activeKeyEl = keyMap.get(res.code) || null;
    activeKeyEl?.classList.add('gk-next');

    // Shift key (opposite hand)
    if (res.shift) {
      const shiftCode = getShiftKeyFor(res.hand);
      activeShiftEl = keyMap.get(shiftCode) || null;
      activeShiftEl?.classList.add('gk-next');
    }

    // Finger zone (O(1) Map lookup)
    const zoneId = res.finger === 'thumb' ? 'right_thumb' : res.finger;
    activeZoneEl = zoneMap.get(`gk-zone-${zoneId}`) || null;
    activeZoneEl?.classList.add('gk-active-zone');

    // Instruction line: "R. index → J"
    if (handLabel && keyLabel && instruction) {
      handLabel.textContent = fingerLabel[res.finger] ?? res.finger;
      keyLabel.textContent  = char === ' ' ? 'Space' : char.toUpperCase();
      instruction.style.opacity = '1';
    }
  }

  // ── Physical key press-light — instant, no repeat, pre-cached Map ─────────
  window.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.repeat) return; // first frame only
    const el = keyMap.get(e.code);
    if (!el) return;
    pressedKeys.add(e.code);
    el.classList.add('gk-pressed');
  });

  window.addEventListener('keyup', (e: KeyboardEvent) => {
    const el = keyMap.get(e.code);
    if (!el) return;
    pressedKeys.delete(e.code);
    if (pointerActiveKey !== el) {
      el.classList.remove('gk-pressed');
    }
  });

  // ── Mouse / pointer press-light ───────────────────────────────────────────
  let pointerActiveKey: HTMLElement | null = null;
  let pointerActiveCode: string | null = null;

  function clearPointerPress() {
    if (pointerActiveKey) {
      const code = pointerActiveCode;
      const keyEl = pointerActiveKey;
      pointerActiveKey = null;
      pointerActiveCode = null;
      if (!code || !pressedKeys.has(code)) {
        keyEl.classList.remove('gk-pressed');
      }
    }
  }

  keyboardEl?.addEventListener('pointerdown', (e: PointerEvent) => {
    if (e.button !== 0) return; // primary button only
    const keyEl = (e.target as HTMLElement).closest('.gk-key') as HTMLElement | null;
    if (!keyEl) return;
    clearPointerPress();
    keyEl.classList.add('gk-pressed');
    pointerActiveKey = keyEl;
    pointerActiveCode = keyEl.getAttribute('data-code');
  });

  keyboardEl?.addEventListener('pointerout', (e: PointerEvent) => {
    if (!pointerActiveKey) return;
    if (!e.relatedTarget || !pointerActiveKey.contains(e.relatedTarget as Node)) {
      clearPointerPress();
    }
  });

  window.addEventListener('pointerup', clearPointerPress);
  window.addEventListener('pointercancel', clearPointerPress);

  // Clear all on window blur (alt-tab mid-type, etc.)
  window.addEventListener('blur', clearAllPressLights);

  // ── Event listeners ────────────────────────────────────────────────────────
  window.addEventListener('typing-next-char', (e: Event) => {
    // Skip ALL work if keyboard is hidden
    if (!shouldShow()) return;
    const detail = (e as CustomEvent).detail;
    if (!detail?.char) { clearAll(); return; }
    highlightNext(detail.char);
  });

  window.addEventListener('typing-key-result', (e: Event) => {
    if (!shouldShow()) return;
    const { char, correct } = (e as CustomEvent).detail;
    const res = getKeyForChar(char);
    if (!res) return;
    const el = keyMap.get(res.code);
    if (!el) return;

    if (activeFlashKeyEl && activeFlashKeyEl !== el) {
      activeFlashKeyEl.classList.remove('gk-correct', 'gk-wrong');
      if (flashTimeoutId) { clearTimeout(flashTimeoutId); flashTimeoutId = null; }
    }

    el.classList.remove('gk-correct', 'gk-wrong', 'gk-next');
    activeFlashKeyEl = el;

    if (correct) {
      el.classList.add('gk-correct');
      flashTimeoutId = setTimeout(() => {
        el.classList.remove('gk-correct');
        if (activeFlashKeyEl === el) activeFlashKeyEl = null;
      }, 200);
    } else {
      el.classList.add('gk-wrong');
      flashTimeoutId = setTimeout(() => {
        el.classList.remove('gk-wrong');
        if (activeFlashKeyEl === el) activeFlashKeyEl = null;
      }, 320);
    }
  });

  window.addEventListener('typing-reset', () => {
    clearAll();
    clearAllPressLights();
    applyToggleUI();
  });

  // Toggle button — stop propagation to avoid parent container click bubbling
  toggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    enabled = !enabled;
    try { localStorage.setItem('gk-enabled', String(enabled)); } catch {}
    applyToggleUI();
  });

  const toggleLabel = document.getElementById('gk-toggle-label');
  toggleLabel?.addEventListener('click', (e) => {
    if (e.target !== toggle && !toggle?.contains(e.target as Node)) {
      toggle?.click();
    }
  });

  // Wordbank change
  document.getElementById('wordbank-select')?.addEventListener('change', () => {
    if (!isEnglish()) clearAll();
    applyToggleUI();
  });

  // ── Scale-to-fit responsiveness observer ──────────────────────────────────
  if (keyboardEl && typeof ResizeObserver !== 'undefined') {
    const ro = new ResizeObserver(() => fitKeyboard());
    ro.observe(keyboardEl);
  } else {
    window.addEventListener('resize', fitKeyboard);
    window.addEventListener('orientationchange', fitKeyboard);
  }

  // ── Init ───────────────────────────────────────────────────────────────────
  applyToggleUI();
  fitKeyboard();
</script>
