---
import Icon from './Icon.astro';

const currentYear = new Date().getFullYear();
---

<footer class="w-full border-t border-[#E5E5E5] dark:border-white/10 bg-white dark:bg-transparent transition-colors duration-150 mt-16">
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 py-12">
  <div class="grid grid-cols-1 md:grid-cols-4 gap-8 pb-10 border-b border-[#E5E5E5] dark:border-white/10">
 
 <!-- Brand & Mission -->
 <div class="space-y-3 md:col-span-1">
  <div class="flex items-center gap-2 text-[#1D1D1F] dark:text-[#F5F5F7]">
  <img
    src="/favicon.svg"
    alt="Instant Typing"
    width="28"
    height="28"
    class="w-7 h-7 rounded-lg"
  />
  <span class="font-bold text-sm tracking-tight" style="letter-spacing:-0.02em">Instant Typing</span>
  </div>
  <p class="font-normal text-pretty text-[0.9375rem] leading-[1.6] text-[#6E6E73] dark:text-[#A1A1A6]" data-i18n="footer.tagline">
    A clean, distraction-free typing test.
  </p>
 </div>

 <!-- Test Modes -->
 <div class="space-y-3">
  <div class="text-xs font-bold uppercase tracking-widest text-[#1D1D1F] dark:text-[#F5F5F7]"><span data-i18n="footer.test_modes">Test Modes</span></div>
  <ul class="space-y-2 text-xs text-[#6E6E73] dark:text-[#A1A1A6]">
  <li><a href="/" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.standard_test">Standard 60-Second Test</span></a></li>
  <li><a href="/1-minute-typing-test" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.1min_test">1-Minute Speed Sprint</span></a></li>
  <li><a href="/3-minute-typing-test" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.3min_test">3-Minute Employment Test</span></a></li>
  <li><a href="/typing-test-for-beginners" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.beginner_test">Beginner Practice Test</span></a></li>
  <li><a href="/numbers-punctuation-typing-test" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.numbers_test">Numbers & Symbols Test</span></a></li>
 </ul>
 </div>

 <!-- Learning & Standards -->
 <div class="space-y-3">
  <div class="text-xs font-bold uppercase tracking-widest text-[#1D1D1F] dark:text-[#F5F5F7]" data-i18n="footer.standards">
  Standards & Guides
  </div>
  <ul class="space-y-2 text-xs text-[#6E6E73] dark:text-[#A1A1A6]">
  <li><a href="/about" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.how_wpm">How WPM is Calculated</span></a></li>
  <li><a href="/typing-test-for-beginners#tips" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.home_row">Home Row Technique</span></a></li>
  <li><a href="/3-minute-typing-test#benchmarks" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.benchmarks">Civil Service WPM Benchmarks</span></a></li>
  <li><a href="/contact" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors" data-i18n="footer.contact">Contact & Support</a></li>
 </ul>
 </div>

 <!-- Compliance & Privacy -->
 <div class="space-y-3">
  <div class="text-xs font-bold uppercase tracking-widest text-[#1D1D1F] dark:text-[#F5F5F7]" data-i18n="footer.compliance">
  Compliance & Legal
  </div>
  <ul class="space-y-2 text-xs text-[#6E6E73] dark:text-[#A1A1A6]">
  <li><a href="/privacy" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors" data-i18n="footer.privacy">Privacy Policy</a></li>
  <li><a href="/terms" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors" data-i18n="footer.terms">Terms of Service</a></li>
  <li><a href="/privacy#cookies" class="hover:text-[#1D1D1F] dark:hover:text-[#F5F5F7] transition-colors"><span data-i18n="footer.cookies">Cookie Disclosures</span></a></li>
 </ul>
 </div>
 </div>

  <!-- Bottom Bar -->
  <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#6E6E73] dark:text-[#A1A1A6]">
  <div>
  &copy; {currentYear} Instant Typing (instanttyping.com). <span data-i18n="footer.rights">All rights reserved.</span>
  </div>
  <div class="flex items-center gap-4 text-[#6E6E73] dark:text-[#A1A1A6]">
 <a href="/privacy" class="hover:underline flex items-center gap-1"><Icon name="verified-user" class="w-3.5 h-3.5" /><span data-i18n="footer.privacy">Privacy Policy</span></a>
 <span>&bull;</span>
 <a href="/terms" class="hover:underline flex items-center gap-1"><Icon name="description" class="w-3.5 h-3.5" /><span data-i18n="footer.terms">Terms of Service</span></a>
 <span>&bull;</span>
 <a href="/contact" class="hover:underline flex items-center gap-1"><Icon name="mail" class="w-3.5 h-3.5" /><span data-i18n="footer.contact">Contact</span></a>
 </div>
 </div>
 </div>
</footer>

