---
import Icon from './Icon.astro';

export interface FAQItem {
 question: string;
 answer: string;
}

interface Props {
 items: FAQItem[];
 title?: string;
}

const {
 items,
 title = "Frequently Asked Questions"
} = Astro.props;

const jsonLd = {
 "@context": "https://schema.org",
 "@type": "FAQPage",
 "mainEntity": items.map(item => ({
 "@type": "Question",
 "name": item.question,
 "acceptedAnswer": {
 "@type": "Answer",
 "text": item.answer
 }
 }))
};
---

<section class="my-12" aria-labelledby="faq-heading">
 <div class="border-b shadow-ds-border pb-3 mb-6">
 <h2 id="faq-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] leading-[1.2] text-balance text-ds-text-primary flex items-center gap-2">
 <Icon name="message" class="w-5 h-5 text-sky-600 " />
 {title}
 </h2>
 </div>

 <div class="space-y-3">
 {items.map((item) => (
 <details class="group shadow-ds-border rounded-lg bg-ds-bg-100 overflow-hidden transition-colors">
 <summary class="flex items-center justify-between gap-4 p-4 text-sm font-semibold text-ds-text-primary cursor-pointer select-none hover:bg-neutral-50 ">
 <span>{item.question}</span>
 <Icon name="expand-more" class="w-4 h-4 text-ds-text-secondary group-open:rotate-180 transition-transform duration-200 shrink-0" />
 </summary>
 <div class="px-4 pb-4 pt-1 text-xs text-ds-text-secondary leading-relaxed border-t border-neutral-100 ">
 {item.answer}
 </div>
 </details>
 ))}
 </div>

 <!-- FAQPage JSON-LD Schema Markup -->
 <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>
