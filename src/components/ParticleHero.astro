---
import FloatingKeyboard from './FloatingKeyboard.astro';
---

<section class="keyboard-hero-section" aria-labelledby="hero-heading">
  <div class="hero-content flex flex-col items-center justify-center h-full w-full px-6 pt-28 pb-16 md:pt-36 md:pb-24 z-10 relative">
    
    <div class="mb-10 text-center max-w-3xl w-full flex flex-col items-center">
      <p class="text-[11px] font-mono uppercase tracking-[0.2em] text-neutral-500 mb-4" data-i18n="hero.eyebrow">
        Free typing speed test
      </p>
      <h1 id="hero-heading" class="hero-spotlight text-3xl sm:text-5xl md:text-6xl font-semibold tracking-tight mb-6 text-balance" data-i18n="hero.title">
        How fast can you really type?
      </h1>
      <p class="text-base sm:text-lg text-neutral-400 max-w-2xl mb-8 text-balance" data-i18n="hero.subtitle">
        No ads while you type. No account needed.
      </p>
      
      <a href="#typing-test-container" class="inline-flex items-center justify-center px-8 h-12 text-base rounded-full bg-white text-black font-semibold hover:bg-neutral-200 transition-colors" data-i18n="hero.cta">
        Start typing &#8594;
      </a>
    </div>

    <div class="w-full max-w-[1000px] mt-8 mb-4">
      <FloatingKeyboard />
    </div>

    <p class="mt-2 text-xs text-neutral-600" data-i18n="hero.trust">
      Private by default &#183; Results in under a minute
    </p>
    
  </div>
</section>

<style>
  .keyboard-hero-section {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  /* Vercel-style spotlight: headline illuminates where mouse hovers.
     Base is solid text (always visible); gradient is progressive enhancement. */
  .hero-spotlight {
    --mx: 50%; --my: 50%;
    color: #fff;
    overflow-wrap: break-word;
    word-break: normal;
  }
  html:not(.dark) .hero-spotlight {
    color: #1D1D1F;
  }
  @supports ((background-clip: text) or (-webkit-background-clip: text)) {
    .hero-spotlight {
      color: transparent;
      background-image: radial-gradient(circle 220px at var(--mx) var(--my),
        #ffffff 0%, rgba(255,255,255,0.9) 40%, rgba(255,255,255,0.25) 70%, rgba(255,255,255,0.08) 100%);
      -webkit-background-clip: text; background-clip: text;
    }
    html:not(.dark) .hero-spotlight {
      color: transparent;
      background-image: radial-gradient(circle 220px at var(--mx) var(--my),
        #000000 0%, rgba(0,0,0,0.9) 40%, rgba(0,0,0,0.25) 70%, rgba(0,0,0,0.08) 100%);
    }
  }

  /* On mobile and touch screens: solid readable text with zero cut-off or dimming */
  @media (max-width: 768px), (pointer: coarse) {
    .hero-spotlight,
    html:not(.dark) .hero-spotlight {
      color: #ffffff !important;
      background: none !important;
      -webkit-background-clip: unset !important;
      background-clip: unset !important;
    }
    html:not(.dark) .hero-spotlight {
      color: #1D1D1F !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-spotlight { color: inherit; background: none; -webkit-background-clip: unset; background-clip: unset; }
  }
</style>

<script>
  // Re-add window listeners for typing-start/typing-stop/typing-reset that set isTyping to pause the starfield
  // (The actual starfield rendering logic has moved to MoonlitBackground.astro, which now shares this state)
  let isTyping = false;
  window.addEventListener('typing-start', () => { isTyping = true; });
  window.addEventListener('typing-stop', () => { isTyping = false; });
  window.addEventListener('typing-reset', () => { isTyping = false; });

  // Vercel-style spotlight: track mouse for headline illumination
  (function() {
    const heroEl = document.querySelector('.keyboard-hero-section') as HTMLElement;
    const headline = document.querySelector('.hero-spotlight') as HTMLElement;
    if (!heroEl || !headline) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let raf: number | null = null, tx = 50, ty = 50, cx = 50, cy = 50;
    heroEl.addEventListener('pointermove', (e: PointerEvent) => {
      const r = (headline as HTMLElement).getBoundingClientRect();
      tx = ((e.clientX - r.left) / r.width) * 100;
      ty = ((e.clientY - r.top) / r.height) * 100;
      if (!raf) tick();
    });
    function tick() {
      cx += (tx - cx) * 0.2; cy += (ty - cy) * 0.2;
      headline!.style.setProperty('--mx', cx + '%');
      headline!.style.setProperty('--my', cy + '%');
      raf = (Math.abs(tx - cx) > 0.1 || Math.abs(ty - cy) > 0.1) ? requestAnimationFrame(tick) : null;
    }
  })();
</script>




