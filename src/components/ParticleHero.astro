---
import FloatingKeyboard from './FloatingKeyboard.astro';
---

<section class="keyboard-hero-section" aria-labelledby="hero-heading">
  <div class="hero-content flex flex-col items-center justify-center h-full w-full px-6 py-16 md:py-24 z-10 relative">
    
    <div class="mb-10 text-center max-w-3xl flex flex-col items-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-800 bg-neutral-900 text-xs font-medium text-neutral-400 mb-6">
        <span class="w-2 h-2 rounded-full bg-[#0072F5]"></span>
        Interactive Keyboard Engine
      </div>
      
      <h1 id="hero-heading" class="text-4xl sm:text-5xl md:text-6xl font-semibold tracking-tight text-white mb-6" data-i18n="hero.title">
        Test your typing speed
      </h1>
      <p class="text-lg text-neutral-400 max-w-2xl mb-8" data-i18n="hero.subtitle">
        Free typing test. No account needed.
      </p>
      
      <a href="#typing-test-container" class="inline-flex items-center justify-center px-8 h-12 text-base rounded-full bg-white text-black font-semibold hover:bg-neutral-200 transition-colors" data-i18n="hero.cta">
        Start typing
      </a>
    </div>

    <div class="w-full max-w-[1000px] mt-8 mb-4">
      <FloatingKeyboard />
    </div>
    
  </div>
</section>

<style>
  .keyboard-hero-section {
    position: relative;
    width: 100%;
    min-height: 90vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
</style>
