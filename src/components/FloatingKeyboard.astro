---
// FloatingKeyboard.astro
// Rebuilt as a strict, high-performance dark monochrome interactive keyboard.
---

<div class="keyboard-container" id="interactive-hero-keyboard" aria-hidden="true">
  <div class="keyboard-board">
    
    <!-- Row 1 -->
    <div class="kb-row">
      <div class="kb-key" data-code="Backquote">`</div>
      <div class="kb-key" data-code="Digit1">1</div>
      <div class="kb-key" data-code="Digit2">2</div>
      <div class="kb-key" data-code="Digit3">3</div>
      <div class="kb-key" data-code="Digit4">4</div>
      <div class="kb-key" data-code="Digit5">5</div>
      <div class="kb-key" data-code="Digit6">6</div>
      <div class="kb-key" data-code="Digit7">7</div>
      <div class="kb-key" data-code="Digit8">8</div>
      <div class="kb-key" data-code="Digit9">9</div>
      <div class="kb-key" data-code="Digit0">0</div>
      <div class="kb-key" data-code="Minus">-</div>
      <div class="kb-key" data-code="Equal">=</div>
      <div class="kb-key key-w-backspace" data-code="Backspace">Backspace</div>
    </div>
    
    <!-- Row 2 -->
    <div class="kb-row">
      <div class="kb-key key-w-tab" data-code="Tab">Tab</div>
      <div class="kb-key" data-code="KeyQ">Q</div>
      <div class="kb-key" data-code="KeyW">W</div>
      <div class="kb-key" data-code="KeyE">E</div>
      <div class="kb-key" data-code="KeyR">R</div>
      <div class="kb-key" data-code="KeyT">T</div>
      <div class="kb-key" data-code="KeyY">Y</div>
      <div class="kb-key" data-code="KeyU">U</div>
      <div class="kb-key" data-code="KeyI">I</div>
      <div class="kb-key" data-code="KeyO">O</div>
      <div class="kb-key" data-code="KeyP">P</div>
      <div class="kb-key" data-code="BracketLeft">[</div>
      <div class="kb-key" data-code="BracketRight">]</div>
      <div class="kb-key key-w-backslash" data-code="Backslash">\</div>
    </div>
    
    <!-- Row 3 -->
    <div class="kb-row">
      <div class="kb-key key-w-caps" data-code="CapsLock">Caps</div>
      <div class="kb-key" data-code="KeyA">A</div>
      <div class="kb-key" data-code="KeyS">S</div>
      <div class="kb-key" data-code="KeyD">D</div>
      <div class="kb-key" data-code="KeyF">F</div>
      <div class="kb-key" data-code="KeyG">G</div>
      <div class="kb-key" data-code="KeyH">H</div>
      <div class="kb-key" data-code="KeyJ">J</div>
      <div class="kb-key" data-code="KeyK">K</div>
      <div class="kb-key" data-code="KeyL">L</div>
      <div class="kb-key" data-code="Semicolon">;</div>
      <div class="kb-key" data-code="Quote">'</div>
      <div class="kb-key key-w-enter" data-code="Enter">Enter</div>
    </div>
    
    <!-- Row 4 -->
    <div class="kb-row">
      <div class="kb-key key-w-lshift" data-code="ShiftLeft">Shift</div>
      <div class="kb-key" data-code="KeyZ">Z</div>
      <div class="kb-key" data-code="KeyX">X</div>
      <div class="kb-key" data-code="KeyC">C</div>
      <div class="kb-key" data-code="KeyV">V</div>
      <div class="kb-key" data-code="KeyB">B</div>
      <div class="kb-key" data-code="KeyN">N</div>
      <div class="kb-key" data-code="KeyM">M</div>
      <div class="kb-key" data-code="Comma">,</div>
      <div class="kb-key" data-code="Period">.</div>
      <div class="kb-key" data-code="Slash">/</div>
      <div class="kb-key key-w-rshift" data-code="ShiftRight">Shift</div>
    </div>
    
    <!-- Row 5 -->
    <div class="kb-row">
      <div class="kb-key key-w-ctrl" data-code="ControlLeft">Ctrl</div>
      <div class="kb-key key-w-meta" data-code="MetaLeft">Win</div>
      <div class="kb-key key-w-alt" data-code="AltLeft">Alt</div>
      <div class="kb-key key-w-space" data-code="Space"></div>
      <div class="kb-key key-w-alt" data-code="AltRight">Alt</div>
      <div class="kb-key key-w-meta" data-code="MetaRight">Win</div>
      <div class="kb-key key-w-menu" data-code="ContextMenu">Fn</div>
      <div class="kb-key key-w-ctrl" data-code="ControlRight">Ctrl</div>
    </div>
    
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500&display=swap');

  .keyboard-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px;
    padding: 1rem;
    --kb-gap: 0.5rem;
  }

  .keyboard-board {
    display: flex;
    flex-direction: column;
    gap: var(--kb-gap);
    background-color: #111;
    padding: 1rem;
    border-radius: 12px;
    border: 1px solid #222;
    box-shadow: 0 20px 40px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.05);
    width: 100%;
    max-width: 900px;
    /* Maintain a realistic aspect ratio */
  }

  .kb-row {
    display: flex;
    gap: var(--kb-gap);
    width: 100%;
  }

  .kb-key {
    position: relative;
    flex: 1; /* Default width for standard 1u keys */
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #1a1a1a;
    border: 1px solid #333;
    border-bottom-width: 3px;
    border-bottom-color: #0f0f0f;
    color: #a3a3a3;
    font-family: 'JetBrains Mono', monospace;
    font-size: clamp(0.7rem, 1.5vw, 1rem);
    border-radius: 6px;
    overflow: hidden;
    user-select: none;
    cursor: pointer;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.05);
    /* Strict GPU performance: transform and colors */
    transition: background-color 0.1s, border-color 0.1s, transform 0.05s, color 0.1s;
    transform: translateY(0);
    will-change: transform, background-color;
  }

  /* Specific key widths based on standard ISO/ANSI standard */
  .key-w-backspace { flex: 2; aspect-ratio: auto; justify-content: flex-end; padding-right: 0.75rem; }
  .key-w-tab { flex: 1.5; aspect-ratio: auto; justify-content: flex-start; padding-left: 0.75rem; }
  .key-w-backslash { flex: 1.5; aspect-ratio: auto; }
  .key-w-caps { flex: 1.75; aspect-ratio: auto; justify-content: flex-start; padding-left: 0.75rem; }
  .key-w-enter { flex: 2.25; aspect-ratio: auto; justify-content: flex-end; padding-right: 0.75rem; }
  .key-w-lshift { flex: 2.25; aspect-ratio: auto; justify-content: flex-start; padding-left: 0.75rem; }
  .key-w-rshift { flex: 2.75; aspect-ratio: auto; justify-content: flex-end; padding-right: 0.75rem; }
  
  .key-w-ctrl, .key-w-meta, .key-w-alt, .key-w-menu { 
    flex: 1.25; 
    aspect-ratio: auto; 
    font-size: clamp(0.6rem, 1vw, 0.8rem);
  }
  .key-w-space { flex: 6.25; aspect-ratio: auto; }

  /* Active State (strictly #0072F5) */
  .kb-key.active {
    background-color: #0072F5;
    border-color: #0072F5;
    border-bottom-width: 1px; /* Press down effect */
    transform: translateY(2px);
    color: #ffffff;
    box-shadow: 0 0 15px rgba(0, 114, 245, 0.4), inset 0 1px 0 rgba(255,255,255,0.2);
  }

  /* Ripple DOM Element */
  .kb-ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 20px;
    height: 20px;
    margin-top: -10px;
    margin-left: -10px;
    background-color: rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    transform: scale(0);
    opacity: 1;
    pointer-events: none;
  }

  .kb-ripple-anim {
    animation: ripple-effect 0.4s cubic-bezier(0.1, 0.9, 0.2, 1) forwards;
  }

  @keyframes ripple-effect {
    100% {
      transform: scale(15);
      opacity: 0;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .kb-ripple {
      display: none !important;
    }
  }
  
  @media (max-width: 640px) {
    .keyboard-container {
      --kb-gap: 0.25rem;
      padding: 0.5rem;
    }
    .kb-key {
      border-radius: 4px;
      font-size: 0.6rem;
    }
    .key-w-backspace, .key-w-tab, .key-w-backslash, .key-w-caps, 
    .key-w-enter, .key-w-lshift, .key-w-rshift {
      font-size: 0.5rem;
    }
    .key-w-ctrl, .key-w-meta, .key-w-alt, .key-w-menu { 
      font-size: 0.4rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('interactive-hero-keyboard');
    if (!container) return;

    const keys = container.querySelectorAll('.kb-key');
    const keyMap = new Map();
    
    // Map data-code to DOM element for O(1) lookup
    keys.forEach(el => {
      const code = el.getAttribute('data-code');
      if (code) {
        keyMap.set(code, el);
      }
    });

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Trigger ripple and active state
    function pressKey(el: Element) {
      el.classList.add('active');
      
      if (!prefersReducedMotion) {
        const ripple = document.createElement('div');
        ripple.className = 'kb-ripple kb-ripple-anim';
        el.appendChild(ripple);
        
        // Clean up ripple element after animation
        setTimeout(() => {
          if (ripple.parentNode === el) {
            el.removeChild(ripple);
          }
        }, 500);
      }
    }

    function releaseKey(el: Element) {
      el.classList.remove('active');
    }

    // Keyboard Event Handlers
    const onKeyDown = (e: KeyboardEvent) => {
      if (e.repeat) return; // Prevent continuous ripple on hold
      const el = keyMap.get(e.code);
      if (el) pressKey(el);
    };

    const onKeyUp = (e: KeyboardEvent) => {
      const el = keyMap.get(e.code);
      if (el) releaseKey(el);
    };

    // Touch/Mouse Event Handlers
    keys.forEach(el => {
      el.addEventListener('mousedown', () => pressKey(el));
      el.addEventListener('mouseup', () => releaseKey(el));
      el.addEventListener('mouseleave', () => releaseKey(el));
      el.addEventListener('touchstart', (e) => {
        e.preventDefault(); // Prevent double firing with mouse events
        pressKey(el);
      }, { passive: false });
      el.addEventListener('touchend', () => releaseKey(el));
      el.addEventListener('touchcancel', () => releaseKey(el));
    });

    // IntersectionObserver to pause keyboard listeners when hero is offscreen
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          window.addEventListener('keydown', onKeyDown);
          window.addEventListener('keyup', onKeyUp);
        } else {
          window.removeEventListener('keydown', onKeyDown);
          window.removeEventListener('keyup', onKeyUp);
          // Release any stuck keys
          keys.forEach(releaseKey);
        }
      });
    }, { rootMargin: "0px", threshold: 0 });

    observer.observe(container);
  });
</script>
