---
// FloatingKeyboard.astro
---

<div class="keyboard-wrapper" aria-hidden="true" id="3d-keyboard">
  <div class="keyboard-underglow"></div>
  <div class="keyboard-shadow"></div>
  <div class="keyboard-board" id="kb-board">
    
    <div class="kb-row">
      {['1','2','3','4','5','6','7','8','9','0'].map(k => (
        <div class="kb-key-container" data-key={k.toLowerCase()} style="--kw: 1">
          <div class="kb-well"></div>
          <div class="kb-body"></div>
          <div class="kb-cap">{k}</div>
        </div>
      ))}
    </div>
    
    <div class="kb-row">
      {['Q','W','E','R','T','Y','U','I','O','P'].map(k => (
        <div class="kb-key-container" data-key={k.toLowerCase()} style="--kw: 1">
          <div class="kb-well"></div>
          <div class="kb-body"></div>
          <div class="kb-cap">{k}</div>
        </div>
      ))}
    </div>
    
    <div class="kb-row">
      {['A','S','D','F','G','H','J','K','L'].map(k => (
        <div class="kb-key-container" data-key={k.toLowerCase()} style="--kw: 1">
          <div class="kb-well"></div>
          <div class="kb-body"></div>
          <div class="kb-cap">{k}</div>
        </div>
      ))}
      <div class="kb-key-container key-enter" data-key="enter" style="--kw: 1.75">
        <div class="kb-well"></div>
        <div class="kb-body"></div>
        <div class="kb-cap">Enter</div>
      </div>
    </div>
    
    <div class="kb-row">
      {['Z','X','C','V','B','N','M'].map(k => (
        <div class="kb-key-container" data-key={k.toLowerCase()} style="--kw: 1">
          <div class="kb-well"></div>
          <div class="kb-body"></div>
          <div class="kb-cap">{k}</div>
        </div>
      ))}
    </div>
    
    <div class="kb-row">
      <div class="kb-key-container" data-key="controlleft" style="--kw: 1.25">
        <div class="kb-well"></div>
        <div class="kb-body"></div>
        <div class="kb-cap text-xs">ctrl</div>
      </div>
      <div class="kb-key-container" data-key="altleft" style="--kw: 1.25">
        <div class="kb-well"></div>
        <div class="kb-body"></div>
        <div class="kb-cap text-xs">alt</div>
      </div>
      <div class="kb-key-container" data-key="space" style="--kw: 5.5">
        <div class="kb-well"></div>
        <div class="kb-body"></div>
        <div class="kb-cap"></div>
      </div>
      <div class="kb-key-container" data-key="altright" style="--kw: 1.25">
        <div class="kb-well"></div>
        <div class="kb-body"></div>
        <div class="kb-cap text-xs">alt</div>
      </div>
      <div class="kb-key-container" data-key="controlright" style="--kw: 1.25">
        <div class="kb-well"></div>
        <div class="kb-body"></div>
        <div class="kb-cap text-xs">ctrl</div>
      </div>
    </div>

  </div>
</div>

<style>
  :root {
    --kb-unit: 58px;
    --kb-gap: 8px;
  }
  
  .keyboard-wrapper {
    perspective: 1400px;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    margin-bottom: 2rem;
    position: relative;
    z-index: 10;
    pointer-events: auto; /* Allow touch */
    /* Container scaling for responsiveness */
    transform-origin: center;
  }
  
  /* Underglow */
  .keyboard-underglow {
    position: absolute;
    width: 600px;
    height: 200px;
    background: #0072F5;
    opacity: 0.15;
    filter: blur(80px);
    border-radius: 50%;
    transform: rotateX(54deg) rotateZ(-7deg) translateZ(-50px);
    pointer-events: none;
  }
  
  /* Shadow */
  .keyboard-shadow {
    position: absolute;
    width: 650px;
    height: 280px;
    background: rgba(0, 0, 0, 0.8);
    filter: blur(30px);
    border-radius: 50%;
    transform: rotateX(54deg) rotateZ(-7deg) translateZ(-30px);
    pointer-events: none;
  }

  .keyboard-board {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(54deg) rotateZ(-7deg);
    background: linear-gradient(#101010, #0a0a0a);
    border: 1px solid #232323;
    border-radius: 20px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: var(--kb-gap);
    box-shadow: inset 0 2px 5px rgba(255,255,255,0.05), 0 20px 40px rgba(0,0,0,0.8);
    will-change: transform; /* optimized for animation */
  }

  .kb-row {
    display: flex;
    justify-content: center;
    gap: var(--kb-gap);
    transform-style: preserve-3d;
  }

  .kb-key-container {
    position: relative;
    width: calc(var(--kb-unit) * var(--kw) + var(--kb-gap) * (var(--kw) - 1));
    height: var(--kb-unit);
    transform-style: preserve-3d;
    cursor: pointer;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  /* Well (bottom) */
  .kb-well {
    position: absolute;
    inset: 0;
    background: #050505;
    border-radius: 10px;
    transform: translateZ(0);
  }

  /* Body (middle) */
  .kb-body {
    position: absolute;
    inset: 0;
    background: #111;
    border-radius: 10px;
    transform: translateZ(8px);
    border: 1px solid #1a1a1a;
  }

  /* Cap (top) */
  .kb-cap {
    position: absolute;
    inset: 0;
    background: linear-gradient(#2e2e2e, #181818);
    border: 1px solid #383838;
    border-radius: 10px;
    box-shadow: inset 0 1px 1px rgba(255,255,255,0.1);
    transform: translateZ(16px);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9a9a9a;
    font-size: 15px;
    font-weight: 500;
    transition: transform 0.07s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    overflow: hidden;
    isolation: isolate;
  }
  
  /* Blue glow overlay for pressed state - transitions opacity smoothly */
  .kb-cap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(#0072F5, #0056b3);
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
    z-index: -1;
  }

  .text-xs {
    font-size: 12px;
  }

  /* Key pressed state: glow and depth */
  .kb-key-container.pressed .kb-cap {
    transform: translateZ(6px);
    border-color: #3399ff;
    color: #ffffff;
    box-shadow: inset 0 1px 2px rgba(255,255,255,0.3), 0 0 20px rgba(0, 114, 245, 0.7);
  }

  .kb-key-container.pressed .kb-cap::after {
    opacity: 1;
  }

  /* Enter Key Exception */
  .key-enter .kb-cap {
    background: linear-gradient(#0072F5, #0056b3);
    border-color: #3399ff;
    color: white;
    box-shadow: inset 0 1px 2px rgba(255,255,255,0.3), 0 0 15px rgba(0, 114, 245, 0.4);
  }
  
  .key-enter.pressed .kb-cap {
    box-shadow: inset 0 1px 2px rgba(255,255,255,0.3), 0 0 25px rgba(0, 114, 245, 0.8);
  }

  @media (prefers-reduced-motion: reduce) {
    .kb-cap {
      transition: box-shadow 0.01s ease, border-color 0.01s ease, color 0.01s ease !important;
    }
    .kb-cap::after {
      transition: opacity 0.01s ease !important;
    }
    .kb-key-container.pressed .kb-cap {
      transform: translateZ(6px) !important;
    }
  }

  @media (max-width: 768px) {
    .keyboard-wrapper {
      transform: scale(0.6);
      margin-top: -3rem;
      margin-bottom: -1rem;
    }
  }
  
  @media (max-width: 480px) {
    .keyboard-wrapper {
      transform: scale(0.45);
      margin-top: -4rem;
      margin-bottom: -2rem;
    }
  }
</style>

<script>
  function initKeyboard() {
    try {
      console.log('[3D Keyboard]: Initializing...');

      const wrapper = document.getElementById('3d-keyboard');
      const board = document.getElementById('kb-board');
      const keys = document.querySelectorAll('.kb-key-container');

      if (!wrapper || !board) {
        console.warn('[3D Keyboard Warning]: DOM elements #3d-keyboard or #kb-board not found!');
        return;
      }

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let isVisible = document.visibilityState === 'visible';
      let isOffscreen = false;
      let isTouch = false;

      // Base transforms
      const baseRotX = 54;
      const baseRotZ = -7;

      // Parallax & Bob State
      let mouseX = 0;
      let mouseY = 0;
      let currentX = 0;
      let currentY = 0;
      let rAF: number;
      let hasLoggedLoopStart = false;

      // Ghost Type State
      let lastInteractionTime = Date.now();
      let isGhostTyping = false;
      const ghostPhrase = "instant typing";
      let ghostIndex = 0;
      let ghostTimeout: ReturnType<typeof setTimeout> | undefined;

      // Map keys for easy access
      const keyMap = new Map<string, Element>();
      keys.forEach(k => {
        const dataKey = k.getAttribute('data-key');
        if (dataKey) keyMap.set(dataKey, k);
      });

      // Code mapping
      const codeToKey: Record<string, string> = {
        'Space': 'space',
        'Enter': 'enter',
        'ControlLeft': 'controlleft',
        'ControlRight': 'controlright',
        'AltLeft': 'altleft',
        'AltRight': 'altright'
      };

      // Per-key release timer and timestamp map to guarantee minimum 90ms visible glow
      const MIN_GLOW_MS = 90;
      const keyTimers = new Map<string, ReturnType<typeof setTimeout>>();
      const keyPressTimes = new Map<string, number>();

      const pressKey = (keyName: string) => {
        const el = keyMap.get(keyName);
        if (!el) return;

        // Clear any pending release timer
        const existingTimer = keyTimers.get(keyName);
        if (existingTimer) {
          clearTimeout(existingTimer);
          keyTimers.delete(keyName);
        }

        keyPressTimes.set(keyName, performance.now());
        el.classList.add('pressed');
      };

      const releaseKey = (keyName: string) => {
        const el = keyMap.get(keyName);
        if (!el) return;

        const pressedAt = keyPressTimes.get(keyName) || 0;
        const elapsed = performance.now() - pressedAt;
        const remaining = Math.max(0, MIN_GLOW_MS - elapsed);

        if (remaining > 0) {
          const timer = setTimeout(() => {
            el.classList.remove('pressed');
            keyTimers.delete(keyName);
            keyPressTimes.delete(keyName);
          }, remaining);
          keyTimers.set(keyName, timer);
        } else {
          el.classList.remove('pressed');
          keyTimers.delete(keyName);
          keyPressTimes.delete(keyName);
        }
      };

      const releaseAllKeys = () => {
        keyTimers.forEach(timer => clearTimeout(timer));
        keyTimers.clear();
        keyPressTimes.clear();
        keyMap.forEach(el => el.classList.remove('pressed'));
      };

      // 1. Key Mirroring Subsystem
      window.addEventListener('keydown', (e) => {
        if (e.repeat) return;

        // Ignore if focus is inside another input/textarea/contenteditable (unless it's #hidden-typing-input)
        const target = e.target as HTMLElement | null;
        if (target && target.id !== 'hidden-typing-input') {
          const tagName = target.tagName;
          if (tagName === 'INPUT' || tagName === 'TEXTAREA' || target.isContentEditable) {
            return;
          }
        }

        // Ignore when Ctrl or Meta is held, or Alt (except AltGr where both Ctrl and Alt are pressed)
        if (e.metaKey || (e.ctrlKey && !e.altKey) || (e.altKey && !e.ctrlKey)) {
          return;
        }

        markInterrupted();
        const keyName = codeToKey[e.code] || e.key.toLowerCase();
        pressKey(keyName);
      });

      window.addEventListener('keyup', (e) => {
        markInterrupted();
        const keyName = codeToKey[e.code] || e.key.toLowerCase();
        releaseKey(keyName);
      });

      // Window blur & document visibility safeguards against stuck keys
      window.addEventListener('blur', releaseAllKeys);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          releaseAllKeys();
        }
      });

      keys.forEach(k => {
        k.addEventListener('pointerdown', (e: Event) => {
          const pointerEvent = e as PointerEvent;
          isTouch = pointerEvent.pointerType === 'touch';
          markInterrupted();
          k.classList.add('pressed');
        });
        k.addEventListener('pointerup', () => k.classList.remove('pressed'));
        k.addEventListener('pointerleave', () => k.classList.remove('pressed'));
      });

      // 2. Parallax Subsystem
      window.addEventListener('mousemove', (e) => {
        if (isTouch || prefersReducedMotion) return;
        mouseX = (e.clientX / window.innerWidth) * 2 - 1; // -1 to 1
        mouseY = (e.clientY / window.innerHeight) * 2 - 1; // -1 to 1
        markInterrupted();
      });
      // Visibility Guards
      document.addEventListener('visibilitychange', () => {
        isVisible = document.visibilityState === 'visible';
      });

      const observer = new IntersectionObserver((entries) => {
        isOffscreen = !entries[0].isIntersecting;
      });
      observer.observe(wrapper);

      // 3. Ghost Typing Subsystem
      const typeGhostChar = () => {
        if (!isGhostTyping) return;

        if (ghostIndex >= ghostPhrase.length) {
          ghostIndex = 0;
          ghostTimeout = setTimeout(typeGhostChar, 3000);
          return;
        }

        let char = ghostPhrase[ghostIndex];
        if (char === ' ') char = 'space';

        pressKey(char);
        setTimeout(() => releaseKey(char), 100);

        ghostIndex++;
        ghostTimeout = setTimeout(typeGhostChar, 200 + Math.random() * 100);
      };

      const startGhostTyping = () => {
        if (isGhostTyping || prefersReducedMotion) return;
        isGhostTyping = true;
        ghostIndex = 0;
        typeGhostChar();
      };

      const stopGhostTyping = () => {
        isGhostTyping = false;
        clearTimeout(ghostTimeout);
        releaseAllKeys();
      };

      let hasBeenInterrupted = false;

      const checkGhost = () => {
        const now = Date.now();
        const idleTime = now - lastInteractionTime;
        const threshold = hasBeenInterrupted ? 25000 : 3000;

        if (!isGhostTyping && idleTime > threshold) {
          startGhostTyping();
        }
      };

      setInterval(checkGhost, 1000);

      const markInterrupted = () => {
        lastInteractionTime = Date.now();
        hasBeenInterrupted = true;
        stopGhostTyping();
      };

      wrapper.addEventListener('pointerdown', markInterrupted);
      const animate = () => {
        if (!isVisible || isOffscreen || prefersReducedMotion) {
          rAF = requestAnimationFrame(animate);
          return;
        }

        const now = Date.now();

        // Lerp parallax
        currentX += (mouseX - currentX) * 0.05;
        currentY += (mouseY - currentY) * 0.05;

        // Max tilt ±6deg
        const rotY = currentX * 6;
        const extraRotX = -(currentY * 6);

        // Bob (sine loop ~6s)
        const time = now * 0.001; // seconds
        const bobY = Math.sin(time * (Math.PI * 2 / 6)) * 10;

        board.style.transform = `translateY(${bobY}px) rotateX(${baseRotX + extraRotX}deg) rotateZ(${baseRotZ}deg) rotateY(${rotY}deg)`;

        rAF = requestAnimationFrame(animate);
      };

      if (!prefersReducedMotion) {
        rAF = requestAnimationFrame(animate);
      } else {
        board.style.transform = `rotateX(${baseRotX}deg) rotateZ(${baseRotZ}deg)`;
      }
    } catch (err) {
      console.error('[3D Keyboard Init Error]:', err);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initKeyboard);
  } else {
    initKeyboard();
  }
  document.addEventListener('astro:page-load', initKeyboard);
</script>
