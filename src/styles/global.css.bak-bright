@import "@fontsource-variable/geist";
@import "@fontsource-variable/jetbrains-mono";
@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@theme {
  --font-sans: "Geist Variable", system-ui, sans-serif;
  --font-mono: "JetBrains Mono Variable", monospace;
  
  --spacing-1: 4px;
  --spacing-2: 8px;
  --spacing-3: 12px;
  --spacing-4: 16px;
  --spacing-5: 20px;
  --spacing-6: 24px;
  --spacing-8: 32px;
  --spacing-10: 40px;
  --spacing-12: 48px;
  --spacing-16: 64px;
}

:root {
  /* Monochrome Design System */
  --bg: #FAFAFA;
  --surface: #FFFFFF;
  --text-primary: #171717;
  --text-secondary: #4D4D4D;
  --border: rgba(0, 0, 0, 0.08);
  --accent: #0072F5;
  --danger: #dc2626;
  
  --radius-control: 6px;
  --radius-card: 12px;
  
  --shadow-card: 0 1px 2px rgba(0,0,0,0.04), 0 4px 12px rgba(0,0,0,0.03);
  --shadow-border: inset 0 0 0 1px var(--border);
}

html.dark {
  color-scheme: dark;
  --bg: #000000;
  --surface: #0A0A0A;
  --text-primary: #EDEDED;
  --text-secondary: #A1A1AA;
  --border: rgba(255, 255, 255, 0.1);
  --danger: #ff453a;
  --shadow-card: 0 4px 20px rgba(0,0,0,0.5);
}

html {
  background: var(--bg);
  scroll-behavior: smooth;
  overflow-x: hidden;
}

body {
  font-family: var(--font-sans);
  background: var(--bg);
  color: var(--text-primary);
  min-height: 100vh;
  margin: 0;
  font-size: 1rem;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
  overflow-x: hidden;
}

h1, h2, h3, h4 {
  font-family: var(--font-sans);
  font-weight: 600;
  letter-spacing: -0.02em;
  color: var(--text-primary);
  line-height: 1.1;
}

p {
  color: var(--text-secondary);
}

/* Base interactive elements */
button, a {
  outline: none;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* Cards & Surfaces */
.premium-card {
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-border), var(--shadow-card);
  padding: var(--spacing-6);
}

.premium-control {
  border-radius: var(--radius-control);
  box-shadow: var(--shadow-border);
  background: var(--surface);
}

/* Buttons */
.btn-primary {
  background: var(--text-primary);
  color: var(--bg);
  border-radius: var(--radius-control);
  padding: 0 var(--spacing-4);
  height: 36px;
  font-size: 0.875rem;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
  cursor: pointer;
  transition: opacity 0.2s;
}

.btn-primary:hover {
  opacity: 0.85;
}

.btn-secondary {
  background: var(--surface);
  color: var(--text-primary);
  box-shadow: var(--shadow-border);
  border-radius: var(--radius-control);
  padding: 0 var(--spacing-4);
  height: 36px;
  font-size: 0.875rem;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-2);
  cursor: pointer;
  transition: background 0.2s;
}

.btn-secondary:hover {
  background: rgba(0,0,0,0.02);
}
html.dark .btn-secondary:hover {
  background: rgba(255,255,255,0.05);
}

/* Typing Display */
#typing-display {
  font-family: var(--font-mono);
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-border), var(--shadow-card);
  transition: box-shadow 0.2s;
}

#typing-display:focus-within {
  box-shadow: inset 0 0 0 1px var(--accent), var(--shadow-card);
}

.char-untyped,
.char-pending {
  color: var(--text-secondary);
  opacity: 0.75;
}

.char-correct {
  color: var(--text-primary);
  opacity: 1;
}

.char-error,
.char-extra {
  color: var(--danger, #ff453a);
  background-color: transparent;
  opacity: 1;
}

/* Caret */
.typing-caret {
  background: #0072F5 !important;
  width: 2.5px !important;
  height: 0.73em;
  height: 1cap;
  margin: 0 !important;
  border-radius: 1px;
  will-change: transform;
  transition: transform 70ms cubic-bezier(0.1, 0.9, 0.2, 1);
  pointer-events: none;
  z-index: 10;
}

@media (prefers-reduced-motion: reduce) {
  .typing-caret {
    transition: none !important;
  }
}

.word {
  content-visibility: auto;
  contain-intrinsic-size: auto 3ch;
}
.word.active-word {
  content-visibility: visible;
}
.word.word-has-error {
  text-decoration: underline wavy var(--danger, #ff453a);
  text-decoration-skip-ink: none;
  text-underline-offset: 4px;
}

/* Table */
.benchmark-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.875rem;
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-border);
  overflow: hidden;
}

.benchmark-table th {
  padding: var(--spacing-3) var(--spacing-4);
  border-bottom: 1px solid var(--border);
  color: var(--text-secondary);
  font-weight: 500;
  text-align: left;
}

.benchmark-table td {
  padding: var(--spacing-3) var(--spacing-4);
  border-bottom: 1px solid var(--border);
  color: var(--text-primary);
}

.benchmark-table tr:last-child td {
  border-bottom: none;
}

/* Stacking context for MoonlitBackground WebGL shader (dark mode) */
html.dark body { position: relative; }
html.dark header, html.dark main, html.dark footer { position: relative; z-index: 1; }


/* Premium motion system (Apple/Linear/Stripe grade) */
:root {
  --spring: cubic-bezier(0.32, 0.72, 0, 1);
  --spring-fast: cubic-bezier(0.32, 0.72, 0, 1);
}
.mode-tab-btn {
  transition: all 250ms var(--spring) !important;
}
.mode-tab-btn:active {
  transform: scale(0.96);
}
button:not(.mode-tab-btn):active {
  transform: scale(0.98);
  transition: transform 150ms var(--spring-fast);
}
.word span {
  transition: color 120ms ease-out, background-color 120ms ease-out;
}
button:focus-visible, select:focus-visible, input:focus-visible {
  outline: 2px solid #0072F5;
  outline-offset: 2px;
}
@media (prefers-reduced-motion: reduce) {
  .mode-tab-btn, button:not(.mode-tab-btn):active { transition: none !important; transform: none !important; }
  .word span { transition: none; }
}


/* MEGA-PATCH: Apple/Linear/Stripe premium system */
h1, h2, .text-3xl, .text-4xl {
  letter-spacing: -0.02em;
  line-height: 1.1;
}
h3, .text-xl, .text-2xl {
  letter-spacing: -0.01em;
  line-height: 1.2;
}
.text-sm, .text-xs {
  letter-spacing: 0;
  line-height: 1.5;
}
.uppercase {
  letter-spacing: 0.08em;
}
:root {
  --ease-snappy: cubic-bezier(0.16, 1, 0.3, 1);
  --ease-spring-tactile: cubic-bezier(0.34, 1.56, 0.64, 1);
}
.btn-tactile, .mode-tab-btn {
  transition: transform 150ms var(--ease-spring-tactile),
              background-color 180ms ease-out,
              box-shadow 180ms ease-out;
}
.btn-tactile:active, .mode-tab-btn:active {
  transform: scale(0.96);
  transition-duration: 100ms;
  transition-timing-function: ease-out;
}
.stagger > * {
  animation: springEnter 450ms cubic-bezier(0.32, 0.72, 0, 1) both;
}
.stagger > *:nth-child(1) { animation-delay: 0ms; }
.stagger > *:nth-child(2) { animation-delay: 60ms; }
.stagger > *:nth-child(3) { animation-delay: 120ms; }
.stagger > *:nth-child(4) { animation-delay: 180ms; }
.stagger > *:nth-child(5) { animation-delay: 240ms; }
.stagger > *:nth-child(n+6) { animation-delay: 300ms; }
html {
  transition: background-color 300ms ease-out, color 300ms ease-out;
}
input:focus, textarea:focus {
  outline: none;
  border-color: #0072F5;
  box-shadow: 0 0 0 3px rgba(0, 114, 245, 0.15);
  transition: border-color 180ms ease-out, box-shadow 180ms ease-out;
}
a.link-animated {
  position: relative;
  text-decoration: none;
}
a.link-animated::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  width: 100%;
  height: 1px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 250ms cubic-bezier(0.32, 0.72, 0, 1);
}
a.link-animated:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}
@media (prefers-reduced-motion: reduce) {
  .stagger > *, a.link-animated::after {
    animation: none !important;
    transition: none !important;
  }
  h1, h2, h3 { letter-spacing: normal; }
}

/* Aurora gradient border for celebratory moments (Personal Best) */
.aurora-border {
  position: relative;
  background: var(--surface);
  border-radius: var(--radius-card);
}
.aurora-border::before {
  content: '';
  position: absolute;
  inset: -1px;
  border-radius: calc(var(--radius-card) + 1px);
  padding: 1px;
  background: linear-gradient(
    135deg,
    rgba(0, 114, 245, 0.6),
    rgba(121, 40, 202, 0.4),
    rgba(255, 0, 128, 0.3),
    rgba(0, 114, 245, 0.6)
  );
  background-size: 300% 300%;
  -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
  -webkit-mask-composite: xor;
  mask-composite: exclude;
  animation: aurora-shift 6s ease-in-out infinite;
  pointer-events: none;
}
@keyframes aurora-shift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}
@media (prefers-reduced-motion: reduce) {
  .aurora-border::before { animation: none; }
}
