---
import Layout from '../layouts/Layout.astro';
import TypingEngine from '../components/TypingEngine.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';

const faqs = [
  {
    question: "Why do employers use 3-minute and 5-minute typing tests?",
    answer: "While 1-minute tests measure maximum burst speed, employment tests require stamina and consistent rhythm over extended periods. Civil service examinations, legal secretarial positions, and data entry assessments use 3-to-5 minute tests to verify that typists maintain high accuracy without succumbing to fatigue.",
    questionKey: "faq.3.q1", answerKey: "faq.3.a1"
  },
  {
    question: "What is an acceptable WPM score for a 3-minute employment test?",
    answer: "Most government and clerical jobs require a sustained Net WPM of 45 to 60 with a minimum accuracy rate of 95% to 98%. Specialized positions like medical transcriptionists or stenographers often require 70 to 90+ sustained WPM.",
    questionKey: "faq.3.q2", answerKey: "faq.3.a2"
  },
  {
    question: "How do I pace myself so I do not slow down during the final minute?",
    answer: "Start the first minute at roughly 85% to 90% of your top sprint speed. An aggressive sprint early causes forearm tension and cramps. Establishing a relaxed, rhythmic metronome cadence early ensures your speed stays flat or accelerates toward the finish."
  },
  {
    question: "How heavily do typos penalize my 3-minute test score?",
    answer: "Because WPM is calculated as Net WPM, errors directly reduce your score. Worse, stopping to backspace and fix errors breaks your rhythm, costing 2 to 3 times more seconds than typing smoothly. Keeping 98%+ accuracy always yields higher final scores."
  },
  {
    question: "How do I prevent wrist fatigue during longer typing assessments?",
    answer: "Ensure your wrists remain neutral and hovered above the desk surface rather than resting on the hard table edge. Adjust your chair height so that your forearms are parallel to the floor, and take brief micro-pauses between sentences to relax your finger tension.",
    questionKey: "faq.3.q3", answerKey: "faq.3.a3"
  }
];
---

<Layout
 title="3 Minute Typing Test | Official Endurance & Employment Check"
 description="Take the 3-minute typing test to measure your sustained typing speed and stamina. Used for civil service, corporate, and clerical job qualification."
 canonicalPath="/3-minute-typing-test"
>
 <div class="space-y-12">
 <h1 class="sr-only" data-i18n="page_3min.h1">3 Minute Typing Test</h1>
 <TypingEngine
 initialDuration={180}
 initialMode="time"
 initialWordbank="top1000"
 pageHeading="3-Minute Typing Test: Employment & Stamina Evaluation" pageHeadingKey="engine.3.heading"
 pageSubheading="Test your sustained keyboard speed and endurance. Designed for civil service, administrative, and professional benchmarks." pageSubheadingKey="engine.3.subheading"
 />

 <section class="border-t shadow-ds-border pt-10 space-y-6" id="benchmarks" aria-labelledby="three-min-heading">
 <div class="space-y-2">
 <h2 id="three-min-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] leading-[1.2] text-balance text-ds-text-primary " data-i18n="page_3min.guide_heading">
 Sustained Typing Velocity &amp; Exam Pacing
 </h2>
 <p class="font-normal text-pretty text-sm text-ds-text-secondary leading-relaxed max-w-3xl"><span data-i18n="page_3min.guide_intro">Maintaining high speed across multiple minutes requires rhythm regulation. Rushing the first 30 seconds almost always leads to a surge in errors and muscle fatigue in the final minute.</span></p>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
 <div class="p-5 rounded-lg shadow-ds-border bg-ds-bg-100 space-y-2 flex flex-col">
 <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-sky-50 text-sky-600 " aria-hidden="true">
 <Icon name="timer" class="w-5 h-5" />
 </span>
 <h3 class="text-sm font-semibold tracking-[-0.01em] text-ds-text-primary "><span data-i18n="page_3min.tip1_title">Establish a Metronome Pace</span></h3>
 <p class="font-normal text-pretty text-sm text-ds-text-secondary leading-relaxed"><span data-i18n="page_3min.tip1_body">Treat each keystroke like the steady tick of a clock. Even pacing reduces muscle spasm and prevents the cognitive stop-and-start cycle caused by frequent backspaces.</span></p>
 </div>

 <div class="p-5 rounded-lg shadow-ds-border bg-ds-bg-100 space-y-2 flex flex-col">
 <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-emerald-50 text-emerald-600 " aria-hidden="true">
 <Icon name="favorite" class="w-5 h-5" />
 </span>
 <h3 class="text-sm font-semibold tracking-[-0.01em] text-ds-text-primary "><span data-i18n="page_3min.tip2_title">Breathe and Relax Shoulders</span></h3>
 <p class="font-normal text-pretty text-sm text-ds-text-secondary leading-relaxed"><span data-i18n="page_3min.tip2_body">When typing tests begin, test takers unconsciously hold their breath and tense their trapezius muscles. Consciously lowering your shoulders unlocks finger agility.</span></p>
 </div>

 <div class="p-5 rounded-lg shadow-ds-border bg-ds-bg-100 space-y-2 flex flex-col">
 <span class="inline-flex items-center justify-center w-9 h-9 rounded-lg bg-amber-50 text-amber-600 " aria-hidden="true">
 <Icon name="target" class="w-5 h-5" />
 </span>
 <h3 class="text-sm font-semibold tracking-[-0.01em] text-ds-text-primary "><span data-i18n="page_3min.tip3_title">The 98% Rule</span></h3>
 <p class="font-normal text-pretty text-sm text-ds-text-secondary leading-relaxed"><span data-i18n="page_3min.tip3_body">If your accuracy dips below 98%, consciously downshift your speed by 5%. Accuracy will immediately rebound, and your final Net WPM will be significantly higher.</span></p>
 </div>
 </div>
 </section>

  <!-- Worked Example -->
  <section class="border-t shadow-ds-border pt-10 space-y-4" aria-labelledby="worked-example-heading">
    <div class="space-y-2">
      <h2 id="worked-example-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] leading-[1.2] text-balance text-ds-text-primary flex items-center gap-2">
        <Icon name="analytics" class="w-6 h-6 text-sky-600" />
        <span data-i18n="page_3min.worked_example_heading">Worked example: what 40 WPM looks like in 3 minutes</span>
      </h2>
      <p class="font-normal text-pretty text-sm text-ds-text-secondary leading-relaxed max-w-3xl" data-i18n="page_3min.worked_example_body">
        Worked example: 780 characters typed correctly in 3 minutes. 780 ÷ 5 = 156 words. 156 ÷ 3 minutes = 52 WPM.
      </p>
    </div>
  </section>

  <!-- Employer Benchmarks -->
  <section class="border-t shadow-ds-border pt-10 space-y-6" aria-labelledby="employer-benchmarks-heading">
    <div class="space-y-2">
      <div class="text-sm font-mono uppercase tracking-widest text-sky-600 font-semibold mb-1">
        <span data-i18n="page_3min.employers_label">Standards</span>
      </div>
      <h2 id="employer-benchmarks-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] leading-[1.2] text-balance text-ds-text-primary flex items-center gap-2">
        <Icon name="bolt" class="w-6 h-6 text-sky-600" />
        <span data-i18n="page_3min.employers_heading">What employers ask for — UK / US / Canada</span>
      </h2>
    </div>

    <div class="rounded-lg shadow-ds-border overflow-hidden bg-ds-bg-100 max-w-3xl">
      <div class="table-scroll w-full overflow-x-auto hide-scrollbar">
        <table class="benchmark-table font-mono w-full">
          <thead>
            <tr>
              <th data-i18n="page_3min.th_role">Role</th>
              <th data-i18n="page_3min.th_speed">Typical speed</th>
              <th data-i18n="page_3min.th_duration">Duration</th>
              <th data-i18n="page_3min.th_accuracy">Accuracy</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="font-semibold text-ds-text-primary" data-i18n="page_3min.row_clerical">Administrator / clerical (UK)</td>
              <td class="font-semibold text-sky-600">40–60 WPM</td>
              <td>3–5 min</td>
              <td>~95%</td>
            </tr>
            <tr>
              <td class="font-semibold text-ds-text-primary" data-i18n="page_3min.row_data_entry">Data entry clerk</td>
              <td class="font-semibold text-sky-600">8,000–12,000 KPH</td>
              <td>3–5 min</td>
              <td data-i18n="page_3min.acc_field">Field accuracy</td>
            </tr>
            <tr>
              <td class="font-semibold text-ds-text-primary" data-i18n="page_3min.row_999">Police / 999 call handler (UK)</td>
              <td class="font-semibold text-sky-600">25–35 WPM</td>
              <td data-i18n="page_3min.dur_short">Short</td>
              <td data-i18n="page_3min.acc_details">Accuracy on details</td>
            </tr>
            <tr>
              <td class="font-semibold text-ds-text-primary" data-i18n="page_3min.row_medical">Medical transcriptionist</td>
              <td class="font-semibold text-sky-600">70–90+ WPM</td>
              <td>3–5 min</td>
              <td>98%+</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="text-xs text-ds-text-secondary leading-relaxed max-w-3xl" data-i18n="page_3min.caveat">
      Typical ranges from job postings, not official standards. Always confirm the speed, duration and error rules in the official job posting or exam notice.
    </p>

    <!-- Certificate CTA -->
    <div class="p-5 rounded-lg border border-[#E5E5E5] dark:border-white/10 bg-ds-bg-100 text-sm text-ds-text-secondary space-y-2">
      <p data-i18n="page_3min.cert_line">
        After your test, download your certificate. It is a record of your practice result — an employer will usually want you to take their own test.
      </p>
    </div>

    <!-- Related Tests & Calculations Links -->
    <nav aria-label="Related typing tests" class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2">
      <a href="/1-minute-typing-test/" class="flex items-center gap-2 px-4 py-3 rounded-lg shadow-ds-border bg-ds-bg-100 text-sm font-medium text-ds-text-primary hover:border-[#0072F5] hover:text-[#0072F5] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0072F5]">
        <Icon name="timer" class="w-4 h-4 shrink-0" />
        <span data-i18n="page_3min.link_1min">1-Minute Speed Sprint</span>
      </a>
      <a href="/wpm-calculator/" class="flex items-center gap-2 px-4 py-3 rounded-lg shadow-ds-border bg-ds-bg-100 text-sm font-medium text-ds-text-primary hover:border-[#0072F5] hover:text-[#0072F5] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0072F5]">
        <Icon name="analytics" class="w-4 h-4 shrink-0" />
        <span data-i18n="page_3min.link_calc">WPM Calculator</span>
      </a>
      <a href="/how-we-measure/" class="flex items-center gap-2 px-4 py-3 rounded-lg shadow-ds-border bg-ds-bg-100 text-sm font-medium text-ds-text-primary hover:border-[#0072F5] hover:text-[#0072F5] transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#0072F5]">
        <Icon name="target" class="w-4 h-4 shrink-0" />
        <span data-i18n="page_3min.link_measure">How We Measure</span>
      </a>
    </nav>
  </section>

 <FAQ items={faqs} title="Frequently Asked Questions About Extended Typing Tests" titleKey="faq.3.title" />
 </div>
</Layout>

