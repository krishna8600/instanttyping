---
import Layout from '../layouts/Layout.astro';
import TypingEngine from '../components/TypingEngine.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import { THEMED_PACK_METAS } from '../data/themed-packs';

const faqs = [
  {
    question: "What is touch typing and why is it essential?",
    answer: "Touch typing is typing solely through tactile muscle memory without looking down at the physical keyboard. By anchoring your fingers on the home row (ASDF JKL;), your brain maps the location of every key relative to your home position, allowing your typing speed to triple or quadruple compared to hunt-and-peck typing.",
    questionKey: "faq.typing.q1", answerKey: "faq.typing.a1"
  },
  {
    question: "What are the tactile bumps on the F and J keys for?",
    answer: "The small raised ridges on the 'F' and 'J' keys are tactile indicators designed to help you locate the home row without glancing down. Your left index finger rests on 'F' and your right index finger rests on 'J'.",
    questionKey: "faq.typing.q2", answerKey: "faq.typing.a2"
  },
  {
    question: "What is the home row and which fingers go where?",
    answer: "The home row is the middle letter row. Place your left fingers on A (pinky), S (ring), D (middle), and F (index). Place your right fingers on J (index), K (middle), L (ring), and ; (pinky). Your thumbs rest gently on the spacebar."
  },
  {
    question: "Is 20 to 25 WPM normal for a complete beginner?",
    answer: "Yes! When transitioning to true touch typing, speeds initially drop as your fingers learn new geometric pathways. Reaching 20 to 25 WPM with correct finger placement is an excellent initial milestone. Within two weeks of daily 10-minute practice, speeds typically jump to 40+ WPM.",
    questionKey: "faq.typing.q3", answerKey: "faq.typing.a3"
  },
  {
    question: "Should I look down at the keyboard when I get stuck?",
    answer: "Resist the urge to look down. If you cannot remember a key's location, pause and use an on-screen guide or feel for the F and J bumps. Looking at your fingers prevents muscle memory from forming, whereas touch-based trial and error cements key locations."
  }
];
---

<Layout
 title="Typing Test for Beginners | Learn Touch Typing & Home Row"
 description="Beginner-friendly typing test designed for new typists. Practice simple words, master the home row, and learn proper touch typing posture."
 canonicalPath="/typing-test-for-beginners"
>
 <div class="space-y-12">
 <TypingEngine
 initialDuration={60}
 initialMode="time"
 initialWordbank="top1000"
 initialTier="beginner"
 pageHeading="Typing Test for Beginners: Learn Touch Typing" pageHeadingKey="engine.typing.heading"
 pageSubheading="A gentle, distraction-free typing test featuring common words and simple sentences. Ideal for learning finger placement." pageSubheadingKey="engine.typing.subheading"
 />

 <!-- Themed Beginner Word Packs -->
 <section class="border-t shadow-ds-border pt-10 space-y-4" id="themed-packs" aria-labelledby="themed-packs-heading">
 <div class="space-y-1">
 <h2 id="themed-packs-heading" class="text-xl sm:text-2xl font-semibold tracking-[-0.02em] text-ds-text-primary">
 <span data-i18n="page_beginner.themes_heading">Themed Word Packs for Practice</span>
 </h2>
 <p class="font-normal text-sm text-ds-text-secondary leading-relaxed max-w-3xl">
 <span data-i18n="page_beginner.themes_intro">Type familiar, concrete vocabulary grouped by topic to build muscle memory without cognitive strain. Select any pack below to load it into the engine above:</span>
 </p>
 </div>

 <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-2.5 pt-2">
 {THEMED_PACK_METAS.map((pack) => (
 <button
 type="button"
 data-theme-select={pack.id}
 class="theme-pack-btn px-3 py-2.5 text-left rounded-lg border border-[#E5E5E5] dark:border-white/10 bg-ds-bg-100 hover:border-[#1D1D1F] dark:hover:border-white/40 transition-all font-mono text-xs group focus:outline-none focus:ring-1 focus:ring-sky-500 cursor-pointer"
 >
 <div class="font-medium text-ds-text-primary group-hover:underline">
 <span data-i18n={pack.labelKey}>{pack.defaultLabel}</span>
 </div>
 <div class="text-[10px] text-ds-text-secondary mt-0.5">
 {pack.wordCount} words
 </div>
 </button>
 ))}
 </div>
 </section>

 <section class="border-t shadow-ds-border pt-10 space-y-6" id="tips" aria-labelledby="beginner-heading">
 <div class="space-y-2">
 <h2 id="beginner-heading" class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] leading-[1.2] text-balance text-ds-text-primary ">
 <span data-i18n="page_beginner.guide_heading">The Fundamentals of Touch Typing: Home Row Mastery</span>
 </h2>
 <p class="font-normal text-pretty text-sm text-ds-text-secondary leading-relaxed max-w-3xl"><span data-i18n="page_beginner.guide_intro">The secret to fast typing is not moving your hands quickly; it is keeping your hands still and letting your fingers make short, efficient reaches from the home row.</span></p>
 </div>

 <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
 <!-- Home Row Finger Chart Card -->
 <div class="p-5 rounded-lg shadow-ds-border bg-ds-bg-100 space-y-3 font-mono">
 <div class="text-xs font-semibold uppercase tracking-wider text-ds-text-secondary flex items-center gap-1.5">
 <Icon name="keyboard" class="w-4 h-4 text-sky-600 " />
 <span data-i18n="page_beginner.left_hand">Left Hand Finger Alignment</span>
 </div>
 <div class="grid grid-cols-4 gap-2 text-center text-xs">
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.pinky">Pinky</span></div>
 <div class="font-bold text-base mt-1 text-ds-text-primary ">A</div>
 </div>
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.ring">Ring</span></div>
 <div class="font-bold text-base mt-1 text-ds-text-primary ">S</div>
 </div>
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.middle">Middle</span></div>
 <div class="font-bold text-base mt-1 text-ds-text-primary ">D</div>
 </div>
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.index">Index</span></div>
 <div class="font-bold text-base mt-1 text-sky-600 ">F*</div>
 </div>
 </div>
 </div>

 <!-- Right Hand Finger Chart Card -->
 <div class="p-5 rounded-lg shadow-ds-border bg-ds-bg-100 space-y-3 font-mono">
 <div class="text-xs font-semibold uppercase tracking-wider text-ds-text-secondary flex items-center gap-1.5">
 <Icon name="keyboard" class="w-4 h-4 text-sky-600 " />
 <span data-i18n="page_beginner.right_hand">Right Hand Finger Alignment</span>
 </div>
 <div class="grid grid-cols-4 gap-2 text-center text-xs">
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.index">Index</span></div>
 <div class="font-bold text-base mt-1 text-sky-600 ">J*</div>
 </div>
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.middle">Middle</span></div>
 <div class="font-bold text-base mt-1 text-ds-text-primary ">K</div>
 </div>
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.ring">Ring</span></div>
 <div class="font-bold text-base mt-1 text-ds-text-primary ">L</div>
 </div>
 <div class="p-2 rounded bg-neutral-100 dark:bg-white/10 shadow-ds-border ">
 <div class="text-ds-text-secondary text-[10px]"><span data-i18n="page_beginner.pinky">Pinky</span></div>
 <div class="font-bold text-base mt-1 text-ds-text-primary ">;</div>
 </div>
 </div>
 </div>
 </div>
 </section>

 <FAQ items={faqs} title="Frequently Asked Questions for Beginners" titleKey="faq.typing.title" />
 </div>

 <script>
   document.querySelectorAll<HTMLButtonElement>("[data-theme-select]").forEach((btn) => {
     btn.addEventListener("click", () => {
       const themeId = btn.getAttribute("data-theme-select");
       const wordbankSelect = document.getElementById("wordbank-select") as HTMLSelectElement | null;
       if (wordbankSelect && themeId) {
         wordbankSelect.value = themeId;
         wordbankSelect.dispatchEvent(new Event("change"));
         const engineContainer = document.getElementById("typing-test-container") || document.querySelector("main");
         if (engineContainer) {
           engineContainer.scrollIntoView({ behavior: "smooth", block: "start" });
         }
       }
     });
   });
 </script>
</Layout>


